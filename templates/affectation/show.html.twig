{% extends 'base.html.twig' %}

{% block title %}Mouvement {{ affectation.reference }}{% endblock %}

{% block page_title %}
    <h2 class="d-flex align-items-center text-dark fw-bolder fs-2 my-1">
        <i class="bi bi-arrow-left-right text-mci-blue me-3"></i>
        Mouvement {{ affectation.reference }}
        <span class="h-20px border-gray-300 border-start ms-3 mx-2 d-none d-md-inline"></span>
        <small class="text-muted fs-7 fw-semibold my-1 ms-1">{{ affectation.typeMouvementLabel }}</small>
    </h2>
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-muted">
        <a href="{{ path('app_affectation_index') }}" class="text-muted text-hover-primary">Mouvements</a>
    </li>
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-dark fw-bold">{{ affectation.reference }}</li>
{% endblock %}

{% block page_actions %}
    <div class="d-flex align-items-center gap-2">
        {% if employe %}
            <a href="{{ path('app_employe_show', {'id': employe.id}) }}" class="btn btn-mci-secondary btn-sm">
                <i class="bi bi-person-lines-fill fs-5 me-1"></i>
                <span class="d-none d-sm-inline">Fiche Agent 360°</span>
            </a>
        {% endif %}
        <a href="{{ path('app_affectation_index') }}" class="btn btn-mci-secondary btn-sm">
            <i class="bi bi-arrow-left fs-5 me-1"></i>
            <span class="d-none d-sm-inline">Liste</span>
        </a>
    </div>
{% endblock %}

{% block body %}
<div class="d-flex flex-column gap-6">

    <!-- Flash messages -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-mci alert-mci-{{ label == 'error' or label == 'danger' ? 'danger' : (label == 'warning' ? 'warning' : 'success') }} d-flex align-items-center p-5 mb-2" role="alert">
                <i class="bi bi-{{ label == 'error' or label == 'danger' ? 'exclamation-octagon-fill text-danger' : (label == 'warning' ? 'exclamation-triangle-fill text-warning' : 'check-circle-fill text-success') }} fs-2 me-4"></i>
                <div class="d-flex flex-column">
                    <span class="fw-bold">{{ message }}</span>
                </div>
                <button type="button" class="position-absolute position-sm-relative m-2 m-sm-0 top-0 end-0 btn btn-icon ms-sm-auto" data-bs-dismiss="alert">
                    <i class="bi bi-x fs-2"></i>
                </button>
            </div>
        {% endfor %}
    {% endfor %}

    <!-- Bannière de Statut & Actions de workflow -->
    <div class="card card-mci p-5">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-4">
            <div class="d-flex align-items-center gap-3">
                <div class="symbol symbol-45px symbol-circle" style="background-color: var(--mci-blue-subtle);">
                    <span class="symbol-label">
                        <i class="bi bi-arrow-left-right fs-2 text-mci-blue"></i>
                    </span>
                </div>
                <div class="d-flex flex-column">
                    <div class="d-flex align-items-center gap-2">
                        {% set typeBadgeClass = affectation.typeMouvement == 'PROMOTION' ? 'badge-mci-success' : (affectation.typeMouvement == 'MUTATION' ? 'badge-mci-blue' : (affectation.typeMouvement == 'CESSATION' ? 'badge-mci-danger' : (affectation.typeMouvement == 'DETACHEMENT' ? 'badge-mci-warning' : 'bg-secondary text-white'))) %}
                        <span class="badge {{ typeBadgeClass }} fs-8">{{ affectation.typeMouvementLabel }}</span>

                        {% if affectation.statut == 'ACTIVE' %}
                            <span class="badge badge-mci-success fs-8"><i class="bi bi-check-circle-fill me-1"></i>Active</span>
                        {% elseif affectation.statut == 'VALIDEE' %}
                            <span class="badge badge-mci-blue fs-8"><i class="bi bi-clock-history me-1"></i>Validée (Attente prise service)</span>
                        {% elseif affectation.statut == 'PROPOSEE' %}
                            <span class="badge badge-mci-warning fs-8"><i class="bi bi-hourglass-split me-1"></i>Proposition à valider</span>
                        {% elseif affectation.statut == 'CLOTUREE' %}
                            <span class="badge bg-secondary text-white fs-8"><i class="bi bi-archive-fill me-1"></i>Clôturée (Historique)</span>
                        {% elseif affectation.statut == 'ANNULEE' %}
                            <span class="badge badge-mci-danger fs-8"><i class="bi bi-x-circle-fill me-1"></i>Annulée</span>
                        {% endif %}
                    </div>
                    <span class="text-muted fs-8 mt-1">
                        Agent : <strong>{{ employe ? employe.nomComplet : 'N/A' }}</strong> • Effet légal : <strong>{{ affectation.dateEffet ? affectation.dateEffet|date('d/m/Y') : 'N/A' }}</strong>
                    </span>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 align-items-center">
                {% if is_granted('AFFECTATION_VALIDATE', affectation) %}
                    <form method="post" action="{{ path('app_affectation_valider', {'id': affectation.id}) }}" onsubmit="return confirm('Confirmer la validation de ce projet de mouvement ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('valider' ~ affectation.id) }}">
                        <button type="submit" class="btn btn-mci-primary btn-sm">
                            <i class="bi bi-check2-all me-1"></i> Valider la décision
                        </button>
                    </form>
                {% endif %}

                {% if is_granted('AFFECTATION_PRISE_SERVICE', affectation) %}
                    <a href="{{ path('app_affectation_prise_service', {'id': affectation.id}) }}" class="btn btn-success btn-sm">
                        <i class="bi bi-person-check-fill me-1"></i> Confirmer la prise de service
                    </a>
                {% endif %}

                {% if is_granted('AFFECTATION_CANCEL', affectation) %}
                    <button type="button" class="btn btn-mci-light btn-sm text-danger" data-bs-toggle="modal" data-bs-target="#modalAnnuler">
                        <i class="bi bi-slash-circle me-1"></i> Annuler le mouvement
                    </button>
                {% endif %}

                {% if is_granted('AFFECTATION_DELETE', affectation) %}
                    <form method="post" action="{{ path('app_affectation_delete', {'id': affectation.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer définitivement cette affectation ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ affectation.id) }}">
                        <button type="submit" class="btn btn-mci-light btn-sm text-muted">
                            <i class="bi bi-trash3 me-1"></i> Supprimer
                        </button>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Comparatif Avant / Après -->
    <div class="row g-6">
        <!-- Situation précédente -->
        <div class="col-lg-6">
            <div class="card card-mci h-100">
                <div class="card-header border-0 pt-6">
                    <div class="card-title">
                        <i class="bi bi-arrow-left-circle-fill fs-2 text-muted me-3"></i>
                        <h3 class="fw-bolder text-dark mb-0 fs-5">Situation Antérieure</h3>
                    </div>
                </div>
                <div class="card-body py-4">
                    <div class="d-flex flex-column gap-3">
                        <div class="d-flex justify-content-between py-2 border-bottom border-gray-200">
                            <span class="text-muted fs-7">Poste précédent :</span>
                            <span class="fw-bold text-dark fs-7">
                                {% if affectation.ancienPoste %}
                                    <a href="{{ path('app_poste_show', {'id': affectation.ancienPoste.id}) }}" class="text-dark text-hover-primary">
                                        {{ affectation.ancienPoste.intitule }}
                                    </a>
                                {% else %}
                                    <span class="text-muted fst-italic">Non affecté</span>
                                {% endif %}
                            </span>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom border-gray-200">
                            <span class="text-muted fs-7">Structure :</span>
                            <span class="fw-semibold text-dark fs-7">{{ affectation.ancienneStructure ? affectation.ancienneStructure.nom : 'N/A' }}</span>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom border-gray-200">
                            <span class="text-muted fs-7">Service :</span>
                            <span class="fw-semibold text-dark fs-7">{{ affectation.ancienService ? affectation.ancienService.nom : 'N/A' }}</span>
                        </div>
                        <div class="d-flex justify-content-between py-2">
                            <span class="text-muted fs-7">Fonction :</span>
                            <span class="fw-semibold text-dark fs-7">{{ affectation.ancienneFonction ? affectation.ancienneFonction.libelle : 'N/A' }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Nouvelle affectation -->
        <div class="col-lg-6">
            <div class="card card-mci h-100 border-start border-4 border-primary">
                <div class="card-header border-0 pt-6">
                    <div class="card-title">
                        <i class="bi bi-geo-alt-fill fs-2 text-mci-blue me-3"></i>
                        <h3 class="fw-bolder text-dark mb-0 fs-5">Nouvelle Affectation / Destination</h3>
                    </div>
                </div>
                <div class="card-body py-4">
                    <div class="d-flex flex-column gap-3">
                        <div class="d-flex justify-content-between py-2 border-bottom border-gray-200">
                            <span class="text-muted fs-7">Poste de travail :</span>
                            <span class="fw-bolder text-mci-blue fs-7">
                                {% if affectation.poste %}
                                    <a href="{{ path('app_poste_show', {'id': affectation.poste.id}) }}" class="text-mci-blue text-hover-primary">
                                        <i class="bi bi-briefcase-fill me-1"></i> {{ affectation.poste.intitule }}
                                    </a>
                                {% else %}
                                    <span class="text-muted fst-italic">Aucun poste spécifique lié</span>
                                {% endif %}
                            </span>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom border-gray-200">
                            <span class="text-muted fs-7">Structure de rattachement :</span>
                            <span class="fw-bold text-dark fs-7">{{ affectation.structure ? affectation.structure.nom : 'Organisation générale' }}</span>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom border-gray-200">
                            <span class="text-muted fs-7">Service / Division :</span>
                            <span class="fw-semibold text-dark fs-7">{{ affectation.service ? affectation.service.nom : 'N/A' }}</span>
                        </div>
                        <div class="d-flex justify-content-between py-2">
                            <span class="text-muted fs-7">Fonction :</span>
                            <span class="fw-semibold text-dark fs-7">{{ affectation.fonction ? affectation.fonction.libelle : 'N/A' }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Métadonnées Administratives & Agent -->
    <div class="row g-6">
        <div class="col-lg-7">
            <div class="card card-mci h-100">
                <div class="card-header border-0 pt-6">
                    <div class="card-title">
                        <i class="bi bi-file-earmark-text-fill fs-2 text-mci-blue me-3"></i>
                        <h3 class="fw-bolder text-dark mb-0 fs-5">Références & Justifications</h3>
                    </div>
                </div>
                <div class="card-body py-4">
                    <div class="row g-4 mb-4">
                        <div class="col-sm-6">
                            <span class="fs-8 fw-bolder text-muted text-uppercase tracking-wide d-block mb-1">Référence de l'acte</span>
                            <span class="fw-bolder text-dark fs-6 font-monospace">{{ affectation.referenceActe ?: 'Non spécifiée' }}</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="fs-8 fw-bolder text-muted text-uppercase tracking-wide d-block mb-1">Date de décision</span>
                            <span class="fw-semibold text-dark fs-6">
                                <i class="bi bi-calendar-check me-1 text-mci-blue"></i>
                                {{ affectation.dateDecision ? affectation.dateDecision|date('d/m/Y') : 'N/A' }}
                            </span>
                        </div>
                        <div class="col-sm-6">
                            <span class="fs-8 fw-bolder text-muted text-uppercase tracking-wide d-block mb-1">Date d'effet légale</span>
                            <span class="fw-bold text-success fs-6">
                                <i class="bi bi-calendar-event me-1 text-success"></i>
                                {{ affectation.dateEffet ? affectation.dateEffet|date('d/m/Y') : 'N/A' }}
                            </span>
                        </div>
                        <div class="col-sm-6">
                            <span class="fs-8 fw-bolder text-muted text-uppercase tracking-wide d-block mb-1">Prise de service effective</span>
                            <span class="fw-bold fs-6 {{ affectation.datePriseService ? 'text-mci-blue' : 'text-muted' }}">
                                {% if affectation.datePriseService %}
                                    <i class="bi bi-check-circle-fill me-1 text-mci-blue"></i>
                                    {{ affectation.datePriseService|date('d/m/Y') }}
                                {% else %}
                                    <span class="fst-italic">Non encore constatée</span>
                                {% endif %}
                            </span>
                        </div>

                        {% if affectation.dateFin %}
                            <div class="col-sm-6">
                                <span class="fs-8 fw-bolder text-muted text-uppercase tracking-wide d-block mb-1">Date de fin / clôture</span>
                                <span class="fw-semibold text-muted fs-6">
                                    <i class="bi bi-calendar-x me-1"></i>
                                    {{ affectation.dateFin|date('d/m/Y') }}
                                </span>
                            </div>
                        {% endif %}
                    </div>

                    <div class="separator separator-dashed my-4"></div>

                    <div class="mb-4">
                        <span class="fs-8 fw-bolder text-muted text-uppercase tracking-wide d-block mb-2">Motif du mouvement</span>
                        <div class="p-4 rounded-3 bg-light text-dark fs-7">
                            {{ affectation.motif ?: 'Aucun motif formulé.' }}
                        </div>
                    </div>

                    {% if affectation.commentaire %}
                        <div>
                            <span class="fs-8 fw-bolder text-muted text-uppercase tracking-wide d-block mb-2">Observations & Annotations RH</span>
                            <div class="p-4 rounded-3 bg-light text-gray-700 fs-7" style="white-space: pre-line;">{{ affectation.commentaire }}</div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Profil Agent Récap -->
        <div class="col-lg-5">
            <div class="card card-mci h-100">
                <div class="card-header border-0 pt-6">
                    <div class="card-title">
                        <i class="bi bi-person-badge-fill fs-2 text-mci-blue me-3"></i>
                        <h3 class="fw-bolder text-dark mb-0 fs-5">Agent Titulaire</h3>
                    </div>
                </div>
                <div class="card-body py-4">
                    {% if employe %}
                        <div class="d-flex align-items-center mb-4">
                            <div class="symbol symbol-50px symbol-circle bg-light-primary text-primary fw-bolder fs-4 me-3 d-flex align-items-center justify-content-center">
                                {{ employe.prenom|slice(0, 1)|upper }}{{ employe.nom|slice(0, 1)|upper }}
                            </div>
                            <div>
                                <h5 class="fw-bolder mb-1 text-dark">
                                    <a href="{{ path('app_employe_show', {'id': employe.id}) }}" class="text-dark text-hover-primary">
                                        {{ employe.nomComplet }}
                                    </a>
                                </h5>
                                <div class="text-muted fs-8">Matricule : <strong>{{ employe.matricule ?: 'N/C' }}</strong></div>
                            </div>
                        </div>

                        <div class="d-flex flex-column gap-2 fs-7 mb-4">
                            <div class="d-flex justify-content-between py-2 border-bottom border-gray-200">
                                <span class="text-muted">Statut administratif :</span>
                                <span class="fw-semibold text-dark">{{ employe.statutAdministratif ?: 'Agent' }}</span>
                            </div>
                            <div class="d-flex justify-content-between py-2 border-bottom border-gray-200">
                                <span class="text-muted">Corps / Cadre :</span>
                                <span class="fw-semibold text-dark">{{ employe.corps ?: 'N/C' }}</span>
                            </div>
                            <div class="d-flex justify-content-between py-2 border-bottom border-gray-200">
                                <span class="text-muted">Grade / Échelon :</span>
                                <span class="fw-semibold text-dark">{{ employe.grade ?: 'N/C' }} / {{ employe.echelon ?: 'N/C' }}</span>
                            </div>
                            <div class="d-flex justify-content-between py-2">
                                <span class="text-muted">Date d'embauche :</span>
                                <span class="fw-semibold text-dark">{{ employe.dateEmbauche ? employe.dateEmbauche|date('d/m/Y') : 'N/C' }}</span>
                            </div>
                        </div>

                        <a href="{{ path('app_employe_show', {'id': employe.id}) }}" class="btn btn-mci-secondary btn-sm w-100">
                            <i class="bi bi-folder2-open me-1"></i> Ouvrir le dossier agent complet
                        </a>
                    {% else %}
                        <div class="text-muted fst-italic py-4 text-center">Agent non rattaché.</div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Timeline de la Carrière de l'Agent -->
    {% if timeline|length > 0 %}
        <div class="card card-mci">
            <div class="card-header border-0 pt-6">
                <div class="card-title">
                    <i class="bi bi-clock-history fs-2 text-mci-blue me-3"></i>
                    <h3 class="fw-bolder text-dark mb-0 fs-5">Parcours Professionnel & Historique des Mouvements</h3>
                </div>
                <div class="card-toolbar">
                    <span class="badge badge-mci-blue fs-8">{{ timeline|length }} événement(s)</span>
                </div>
            </div>
            <div class="card-body py-4">
                <div class="timeline-label">
                    {% for item in timeline %}
                        <div class="timeline-item mb-4">
                            <div class="timeline-label fw-bolder text-gray-800 fs-8" style="width: 80px;">
                                {{ item.date ? item.date|date('d/m/Y') : '' }}
                            </div>
                            <div class="timeline-badge">
                                <i class="bi bi-record-circle-fill text-{{ item.badge == 'success' ? 'success' : (item.badge == 'warning' ? 'warning' : 'primary') }} fs-4"></i>
                            </div>
                            <div class="timeline-content p-4 rounded-3 bg-light border ms-3 flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-1">
                                    <span class="fw-bolder text-dark fs-7">{{ item.titre }}</span>
                                    {% if item.statut_libelle is defined %}
                                        <span class="badge bg-{{ item.badge }} text-white fs-9">{{ item.statut_libelle }}</span>
                                    {% endif %}
                                </div>
                                <p class="text-muted fs-8 mb-0">{{ item.description }}</p>
                                {% if item.affectation is defined and item.affectation.id != affectation.id %}
                                    <div class="mt-2 pt-2 border-top border-gray-300">
                                        <a href="{{ path('app_affectation_show', {'id': item.affectation.id}) }}" class="fs-8 fw-semibold text-mci-blue text-hover-primary text-decoration-none">
                                            <i class="bi bi-eye me-1"></i> Consulter cette affectation (Réf: {{ item.reference }})
                                        </a>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    {% endif %}

</div>

<!-- Modal Annulation -->
{% if is_granted('AFFECTATION_CANCEL', affectation) %}
    <div class="modal fade" id="modalAnnuler" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" action="{{ path('app_affectation_annuler', {'id': affectation.id}) }}">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title text-white">
                            <i class="bi bi-slash-circle me-2"></i> Annuler le mouvement
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-6">
                        <input type="hidden" name="_token" value="{{ csrf_token('annuler' ~ affectation.id) }}">
                        <p class="fs-6 text-dark mb-4">Êtes-vous certain de vouloir annuler ce projet de mouvement pour l'agent ?</p>
                        <div class="mb-3">
                            <label for="motif_annulation" class="form-label fw-bold">Motif de l'annulation *</label>
                            <textarea id="motif_annulation" name="motif_annulation" class="form-control form-control-solid" rows="3" required placeholder="Indiquez la raison de l'annulation (décision hiérarchique, désistement...)"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-mci-light" data-bs-dismiss="modal">Fermer</button>
                        <button type="submit" class="btn btn-danger">Confirmer l'annulation</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endif %}
{% endblock %}
