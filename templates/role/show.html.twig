{% extends 'base.html.twig' %}

{% block title %}Détail Rôle : {{ role.name }} — MCI e-Circuit{% endblock %}

{% block page_title %}
    <h1 class="d-flex align-items-center text-gray-900 fw-bold my-1 fs-3">
        Fiche Rôle : {{ role.name }}
        <span class="h-20px border-gray-200 border-start ms-3 mx-2"></span>
        <small class="text-muted fs-7 fw-semibold my-1 ms-1">Définition du privilège système</small>
    </h1>
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item text-muted">
        <a href="{{ path('app_dashboard') }}" class="text-muted text-hover-primary">Accueil</a>
    </li>
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-muted">
        <a href="{{ path('app_role_index') }}" class="text-muted text-hover-primary">Rôles</a>
    </li>
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-gray-900">{{ role.name }}</li>
{% endblock %}

{% block page_actions %}
    <div class="d-flex align-items-center gap-2">
        <a href="{{ path('app_role_index') }}" class="btn btn-sm btn-light">
            <i class="ki-duotone ki-arrow-left fs-4 me-1"></i> Retour à la liste
        </a>
        <a href="{{ path('app_role_edit', {'id': role.id}) }}" class="btn btn-sm btn-mci-primary">
            <i class="ki-duotone ki-pencil fs-4 me-1"></i> Modifier
        </a>
    </div>
{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-xl-8">
        <div class="card card-flush border-0 shadow-sm">
            <div class="card-header pt-6">
                <div class="card-title">
                    <div class="d-flex align-items-center">
                        <div class="symbol symbol-50px symbol-circle me-4 bg-light-primary text-primary d-flex align-items-center justify-content-center">
                            <i class="ki-duotone ki-key fs-1 text-primary">
                                <span class="path1"></span>
                                <span class="path2"></span>
                            </i>
                        </div>
                        <div>
                            <h2 class="fs-4 fw-bold text-gray-900 mb-1">{{ role.name }}</h2>
                            <span class="badge badge-light-primary font-monospace fw-bold">{{ role.slug }}</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body pt-4">
                <div class="table-responsive">
                    <table class="table align-middle table-row-bordered fs-6 gy-4 mb-0">
                        <tbody>
                            <tr>
                                <td class="text-muted min-w-150px">Identifiant Numérique</td>
                                <td class="fw-bold text-gray-900">#{{ role.id }}</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Libellé officiel</td>
                                <td class="fw-bold text-gray-900">{{ role.name }}</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Slug technique</td>
                                <td class="font-monospace fw-bold text-primary">{{ role.slug }}</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Date de création</td>
                                <td class="text-gray-700">
                                    {{ role.createdAt ? role.createdAt|date('d/m/Y H:i') : '—' }}
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-6 mt-4 border-top">
                    <a href="{{ path('app_role_index') }}" class="btn btn-light">
                        <i class="ki-duotone ki-arrow-left fs-5 me-1"></i> Retour à la liste
                    </a>
                    {{ include('role/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
