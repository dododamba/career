<form method="post" action="{{ path('app_role_delete', {'id': role.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce rôle ?');" class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ role.id) }}">
    <button class="btn btn-sm btn-light-danger">
        <i class="ki-duotone ki-trash fs-5 me-1"></i> Supprimer
    </button>
</form>
