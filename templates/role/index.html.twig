{% extends 'base.html.twig' %}

{% block title %}Référentiel des Rôles{% endblock %}

{% block page_title %}
    <h1 class="d-flex align-items-center text-gray-900 fw-bold my-1 fs-3">
        Gestion des Rôles &amp; Profils
        <span class="h-20px border-gray-200 border-start ms-3 mx-2"></span>
        <small class="text-muted fs-7 fw-semibold my-1 ms-1">Définition des privilèges applicatifs</small>
    </h1>
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item text-muted">
        <a href="{{ path('app_dashboard') }}" class="text-muted text-hover-primary">Accueil</a>
    </li>
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-gray-900">Rôles</li>
{% endblock %}

{% block page_actions %}
    <div class="d-flex align-items-center gap-2">
        <a href="{{ path('app_role_new') }}" class="btn btn-sm btn-mci-primary">
            <i class="ki-duotone ki-plus-circle fs-4 me-1">
                <span class="path1"></span>
                <span class="path2"></span>
            </i>
            Nouveau rôle
        </a>
    </div>
{% endblock %}

{% block body %}
<div class="d-flex flex-column gap-5">

    <!-- Bannière Institutionnelle -->
    <div class="card card-mci border-0 shadow-sm">
        <div class="card-body p-6">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-4">
                <div class="d-flex align-items-center">
                    <div class="symbol symbol-50px symbol-circle me-4 bg-light-primary text-primary d-flex align-items-center justify-content-center">
                        <i class="ki-duotone ki-key fs-1 text-primary">
                            <span class="path1"></span>
                            <span class="path2"></span>
                        </i>
                    </div>
                    <div>
                        <h2 class="fs-2 fw-bold text-gray-900 mb-1">Matrice des Habilitations</h2>
                        <div class="text-muted fs-7">
                            Catalogue officiel des rôles d'accès pour l'ensemble des modules de {{ app_name }}.
                        </div>
                    </div>
                </div>
                <span class="badge badge-light-primary fw-bold py-2 px-3 fs-7">
                    {{ roles|length }} rôles configurés
                </span>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card card-flush border-0 shadow-sm">
        <div class="card-header align-items-center py-5 gap-2 gap-md-5">
            <div class="card-title">
                <div class="d-flex align-items-center position-relative my-1">
                    <i class="ki-duotone ki-magnifier fs-3 position-absolute ms-4">
                        <span class="path1"></span>
                        <span class="path2"></span>
                    </i>
                    <input type="text" data-kt-filter="search" class="form-control form-control-solid w-250px ps-12" placeholder="Rechercher un rôle..." />
                </div>
            </div>
            <div class="card-toolbar">
                <span class="text-muted fs-7">{{ roles|length }} enregistrements</span>
            </div>
        </div>

        <div class="card-body pt-0">
            <div class="table-responsive">
                <table class="table align-middle table-row-dashed fs-6 gy-4">
                    <thead>
                        <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
                            <th class="w-100px">ID</th>
                            <th>Libellé du Rôle</th>
                            <th>Identifiant (Slug)</th>
                            <th>Date de création</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="text-gray-600 fw-semibold">
                        {% for role in roles %}
                            <tr>
                                <td class="text-muted">#{{ role.id }}</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="symbol symbol-35px symbol-circle me-3 bg-light-primary text-primary fw-bold d-flex align-items-center justify-content-center">
                                            <i class="ki-duotone ki-shield fs-5 text-primary"></i>
                                        </div>
                                        <a href="{{ path('app_role_show', {'id': role.id}) }}" class="text-gray-900 text-hover-primary fw-bold fs-6">
                                            {{ role.name }}
                                        </a>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge badge-light-primary font-monospace fw-bold fs-7">
                                        {{ role.slug }}
                                    </span>
                                </td>
                                <td>
                                    <span class="text-gray-700 fs-7">
                                        {{ role.createdAt ? role.createdAt|date('d/m/Y') : '—' }}
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a href="{{ path('app_role_show', {'id': role.id}) }}" class="btn btn-icon btn-light btn-active-color-primary btn-sm" title="Détails">
                                            <i class="ki-duotone ki-eye fs-4 text-primary"></i>
                                        </a>
                                        <a href="{{ path('app_role_edit', {'id': role.id}) }}" class="btn btn-icon btn-light btn-active-color-warning btn-sm" title="Modifier">
                                            <i class="ki-duotone ki-pencil fs-4 text-warning"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center py-8 text-muted">
                                    Aucun rôle défini dans le référentiel.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
