{% extends 'base.html.twig' %}

{% block title %}Postes Vacants à Pourvoir{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
{% endblock %}

{% block body %}
<div class="container-fluid py-3">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1">
                <i class="fas fa-door-open text-warning me-2"></i>
                Postes Vacants & Recrutements à Pourvoir
            </h2>
            <p class="text-muted mb-0">Liste des postes actuellement sans titulaire dans l'institution <strong>{{ institution ? institution.nom : 'courante' }}</strong>.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('app_poste_new') }}" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i> Nouveau poste
            </a>
            <a href="{{ path('app_poste_index') }}" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Catalogue complet
            </a>
        </div>
    </div>

    <!-- Alert info -->
    <div class="alert alert-warning d-flex align-items-center mb-4 shadow-sm">
        <i class="fas fa-exclamation-triangle fs-3 me-3 text-warning"></i>
        <div>
            <strong>{{ stats.vacants }} poste(s) vacant(s) identifié(s) :</strong>
            Ces postes nécessitent l'affectation ou le recrutement d'un agent pour garantir la continuité du service public ou de l'activité.
        </div>
    </div>

    <!-- Table des postes vacants -->
    <div class="card border shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold text-dark">
                <i class="fas fa-user-clock text-warning me-2"></i>
                Liste Prioritaire des Vacances de Postes
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Référence & Intitulé</th>
                            <th>Structure / Service</th>
                            <th>Niveau</th>
                            <th>Missions clés</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for p in postes %}
                            <tr>
                                <td>
                                    <a href="{{ path('app_poste_show', {'id': p.id}) }}" class="fw-bold text-primary text-decoration-none">
                                        {{ p.intitule }}
                                    </a>
                                    <div class="text-muted small">
                                        <span class="badge bg-light text-dark border me-1">{{ p.reference }}</span>
                                        {% if p.fonction %}
                                            <span>{{ p.fonction.libelle }}</span>
                                        {% endif %}
                                    </div>
                                </td>
                                <td>
                                    <div>{{ p.structure ? p.structure.nom : '<span class="text-muted fst-italic">Non rattaché</span>'|raw }}</div>
                                    {% if p.service %}
                                        <div class="text-muted small"><i class="fas fa-building me-1"></i> {{ p.service.nom }}</div>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">{{ p.niveau ?: 'Cadre' }}</span>
                                </td>
                                <td class="text-muted small" style="max-width: 320px;">
                                    {{ p.description ? p.description|slice(0, 90) ~ '...' : '<span class="fst-italic">Non renseignée</span>'|raw }}
                                </td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a href="{{ path('app_poste_affecter', {'id': p.id}) }}" class="btn btn-sm btn-success" title="Affecter un agent">
                                            <i class="fas fa-user-plus me-1"></i> Affecter un agent
                                        </a>
                                        <a href="{{ path('app_poste_show', {'id': p.id}) }}" class="btn btn-sm btn-outline-info" title="Consulter la fiche">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="fas fa-check-circle fa-3x mb-3 text-success d-block"></i>
                                    <h5>Aucun poste vacant</h5>
                                    <p class="mb-0">Tous les postes actifs de votre institution sont actuellement pourvus.</p>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
