{% extends 'base.html.twig' %}

{% block title %}Affecter un agent au poste — {{ poste.intitule }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
{% endblock %}

{% block body %}
<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1">
                <i class="fas fa-user-plus text-success me-2"></i>
                Affecter un agent au poste
            </h2>
            <p class="text-muted mb-0">Nomination d'un titulaire pour le poste <strong>{{ poste.intitule }}</strong> (Réf: {{ poste.reference }}).</p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('app_poste_show', {'id': poste.id}) }}" class="btn btn-outline-primary">
                <i class="fas fa-eye me-1"></i> Fiche du poste
            </a>
            <a href="{{ path('app_poste_index') }}" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Catalogue
            </a>
        </div>
    </div>

    <!-- Rappel sur le poste -->
    <div class="card border-0 shadow-sm mb-4 bg-light">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h5 class="fw-bold mb-1 text-primary">{{ poste.intitule }}</h5>
                    <div class="text-muted small">
                        <span class="me-3"><strong>Réf :</strong> {{ poste.reference }}</span>
                        {% if poste.structure %}
                            <span class="me-3"><strong>Structure :</strong> {{ poste.structure.nom }}</span>
                        {% endif %}
                        {% if poste.service %}
                            <span class="me-3"><strong>Service :</strong> {{ poste.service.nom }}</span>
                        {% endif %}
                        {% if poste.fonction %}
                            <span><strong>Fonction :</strong> {{ poste.fonction.libelle }}</span>
                        {% endif %}
                    </div>
                </div>
                <div class="col-md-4 text-md-end mt-2 mt-md-0">
                    {% if poste.occupantActuel %}
                        <div class="alert alert-warning py-1 px-2 mb-0 d-inline-block small">
                            <i class="fas fa-exclamation-triangle me-1"></i>
                            Occupé actuellement par : <strong>{{ poste.occupantActuel.nomComplet }}</strong>.
                            Cette affectation clôturera son occupation.
                        </div>
                    {% else %}
                        <span class="badge bg-warning text-dark fs-6 px-3 py-2"><i class="fas fa-door-open me-1"></i> Poste actuellement Vacant</span>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Formulaire d'affectation -->
    <div class="card border shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold text-dark"><i class="fas fa-user-check text-success me-2"></i> Sélection de l'Agent & Modalités</h5>
        </div>
        <div class="card-body p-4">
            {{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}

            <div class="row g-4">
                <div class="col-md-6">
                    {{ form_label(form.employe, 'Agent à nommer / affecter *', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.employe) }}
                    {{ form_errors(form.employe) }}
                    <div class="form-text small">Seuls les agents actifs de votre institution sont proposés.</div>
                </div>

                <div class="col-md-3">
                    {{ form_label(form.date_debut, 'Date de prise de fonction *', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.date_debut) }}
                    {{ form_errors(form.date_debut) }}
                </div>

                <div class="col-md-3">
                    {{ form_label(form.motif, 'Motif d\'affectation *', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.motif) }}
                    {{ form_errors(form.motif) }}
                </div>

                <div class="col-12">
                    {{ form_label(form.commentaire, 'Observations / Références de l\'acte administratif', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.commentaire) }}
                    {{ form_errors(form.commentaire) }}
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                <a href="{{ path('app_poste_show', {'id': poste.id}) }}" class="btn btn-outline-secondary">
                    <i class="fas fa-times me-1"></i> Annuler
                </a>
                <button type="submit" class="btn btn-success px-4 fw-semibold">
                    <i class="fas fa-check-circle me-1"></i> Valider l'affectation de l'agent
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
