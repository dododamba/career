{% extends 'base.html.twig' %}

{% block title %}Tableau de bord | Suivi de présence{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/apexcharts/3.45.2/apexcharts.min.css">
    <style>
        .stat-card {
            border-radius: 10px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            transition: transform 0.3s;
            margin-bottom: 20px;
        }
        .stat-card:hover {
            transform: translateY(-5px);
        }
        .stat-icon {
            height: 60px;
            width: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }
        .recent-activity {
            height: 320px;
            overflow-y: auto;
        }
        .activity-item {
            border-left: 3px solid #3498db;
            padding-left: 15px;
            margin-bottom: 15px;
            position: relative;
        }
        .activity-item:before {
            content: '';
            position: absolute;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #3498db;
            left: -7px;
            top: 5px;
        }
        .chart-container {
            height: 350px;
        }
        .trend-indicator {
            width: 25px;
            height: 25px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .trend-up {
            background-color: rgba(52, 211, 153, 0.2);
            color: #10b981;
        }
        .trend-down {
            background-color: rgba(239, 68, 68, 0.2);
            color: #ef4444;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    
    <!-- En-tête du tableau de bord -->
  <div class="card mb-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-6">
                  <h1 class="mb-4 fw-bold">Tableau de bord</h1>
                    <h5 class="text-muted mb-0">Primature du Tchad</h5>
                </div>
                <div class="col-md-6">
                    <div class="d-flex justify-content-md-end">
                       
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Cartes statistiques -->
    <div class="row">
        <!-- Présences aujourd'hui -->
        <div class="col-md-3">
            <div class="stat-card bg-white p-4">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-muted mb-2">Présences aujourd'hui</p>
                        <div class="d-flex align-items-center">
                            <h3 class="mb-0 me-2">124</h3>
                            <div class="trend-indicator trend-up">
                                <i class="fas fa-arrow-up"></i>
                            </div>
                            <span class="text-success ms-1">+5%</span>
                        </div>
                        <p class="text-muted mt-2 mb-0">vs moyenne</p>
                    </div>
                    <div class="stat-icon bg-primary-subtle">
                        <i class="fas fa-user-check fa-lg text-primary"></i>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Congés en cours -->
        <div class="col-md-3">
            <div class="stat-card bg-white p-4">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-muted mb-2">Congés en cours</p>
                        <div class="d-flex align-items-center">
                            <h3 class="mb-0 me-2">12</h3>
                            <div class="trend-indicator trend-up">
                                <i class="fas fa-arrow-up"></i>
                            </div>
                            <span class="text-success ms-1">+7%</span>
                        </div>
                        <p class="text-muted mt-2 mb-0">vs mois dernier</p>
                    </div>
                    <div class="stat-icon bg-warning-subtle">
                        <i class="fas fa-plane-departure fa-lg text-warning"></i>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Absences ce mois -->
        <div class="col-md-3">
            <div class="stat-card bg-white p-4">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-muted mb-2">Absences ce mois</p>
                        <div class="d-flex align-items-center">
                            <h3 class="mb-0 me-2">50</h3>
                            <div class="trend-indicator trend-up">
                                <i class="fas fa-arrow-up"></i>
                            </div>
                            <span class="text-success ms-1">+2%</span>
                        </div>
                        <p class="text-muted mt-2 mb-0">vs mois dernier</p>
                    </div>
                    <div class="stat-icon bg-danger-subtle">
                        <i class="fas fa-user-xmark fa-lg text-danger"></i>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Retards ce mois -->
        <div class="col-md-3">
            <div class="stat-card bg-white p-4">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-muted mb-2">Retards ce mois</p>
                        <div class="d-flex align-items-center">
                            <h3 class="mb-0 me-2">23</h3>
                            <div class="trend-indicator trend-down">
                                <i class="fas fa-arrow-down"></i>
                            </div>
                            <span class="text-danger ms-1">-3%</span>
                        </div>
                        <p class="text-muted mt-2 mb-0">vs mois dernier</p>
                    </div>
                    <div class="stat-icon bg-info-subtle">
                        <i class="fas fa-clock fa-lg text-info"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Deuxième rangée de widgets -->
    <div class="row">
        <!-- Graphique des présences -->
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header bg-white p-4 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Évolution des présences</h5>
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-outline-secondary btn-sm">Jour</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm active">Semaine</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm">Mois</button>
                    </div>
                </div>
                <div class="card-body">
                    <div id="attendanceChart" class="chart-container"></div>
                </div>
            </div>
        </div>
        
        <!-- Activité récente -->
        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header bg-white p-4">
                    <h5 class="mb-0">Activité récente</h5>
                </div>
                <div class="card-body recent-activity">
                    {% for i in 1..8 %}
                        <div class="activity-item">
                            <p class="mb-1 fw-bold">{{ ['Pierre Dupont', 'Marie Laurent', 'Jean Dubois', 'Sophie Martin'][i % 4] }}</p>
                            <p class="text-muted mb-1">{{ ['Arrivé à 8:05', 'Parti à 17:30', 'Demande de congé soumise', 'Absent (maladie)'][i % 4] }}</p>
                            <p class="text-muted small mb-0">Il y a {{ [5, 10, 25, 45, 60][i % 5] }} minutes</p>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
    
    
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/apexcharts/3.45.2/apexcharts.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var options = {
                series: [
                    {
                        name: "Présences",
                        data: [92, 95, 88, 97, 90, 94, 96]
                    },
                    {
                        name: "Absences",
                        data: [5, 3, 7, 2, 6, 4, 3]
                    },
                    {
                        name: "Retards",
                        data: [3, 2, 5, 1, 4, 2, 1]
                    }
                ],
                chart: {
                    height: 300,
                    type: "area",
                    toolbar: {
                        show: false
                    }
                },
                colors: ["#3b82f6", "#ef4444", "#f59e0b"],
                dataLabels: {
                    enabled: false
                },
                stroke: {
                    curve: "smooth",
                    width: 2
                },
                fill: {
                    type: "gradient",
                    gradient: {
                        shadeIntensity: 1,
                        opacityFrom: 0.7,
                        opacityTo: 0.3,
                        stops: [0, 90, 100]
                    }
                },
                xaxis: {
                    categories: ["Lundi", "Mardi", "Mercredi", "Jeudi", "Vendredi", "Samedi", "Dimanche"]
                },
                tooltip: {
                    x: {
                        format: "dd/MM/yy HH:mm"
                    }
                },
                legend: {
                    position: 'top',
                    horizontalAlign: 'right'
                }
            };
            
            var chart = new ApexCharts(document.querySelector("#attendanceChart"), options);
            chart.render();
            
            // Initialiser les tooltips Bootstrap
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            });
        });
    </script>
{% endblock %}
