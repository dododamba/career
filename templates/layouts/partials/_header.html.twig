<div id="kt_header" class="header align-items-stretch" data-kt-sticky="true" data-kt-sticky-name="header" data-kt-sticky-offset="{default: '200px', lg: '300px'}">
    <div class="container-fluid d-flex align-items-center justify-content-between">
        <!--begin::Aside mobile toggle-->
        <div class="d-flex align-items-center d-lg-none ms-n3 me-1" title="Afficher le menu">
            <div class="btn btn-icon btn-active-color-white" id="kt_aside_mobile_toggle" role="button" aria-label="Afficher le menu de navigation" tabindex="0">
                <i class="bi bi-list fs-1 text-white"></i>
            </div>
        </div>
        <!--end::Aside mobile toggle-->

        <!--begin::Mobile logo-->
        <div class="d-flex align-items-center flex-grow-1 flex-lg-grow-0 min-w-0 overflow-hidden">
            <a href="{{ path('app_dashboard') }}" class="d-lg-none d-flex align-items-center text-white text-decoration-none min-w-0">
                <img alt="Armoirie de la République du Tchad" src="{{ asset('images/brand/armoirie-96.png') }}" class="me-2 flex-shrink-0" style="height: 32px; width: 32px; object-fit: contain;"/>
                <span class="fw-bolder fs-5 text-white text-truncate">{{ app_name }}</span>
            </a>
        </div>
        <!--end::Mobile logo-->

        <!--begin::Wrapper-->
        <div class="d-flex align-items-stretch justify-content-between flex-lg-grow-1 min-w-0">
            <!--begin::Navbar / Search-->
            <div class="d-flex align-items-stretch min-w-0" id="kt_header_nav">
                <div class="header-menu align-items-stretch min-w-0">
                    <div class="menu menu-lg-rounded menu-column menu-lg-row menu-state-bg menu-title-gray-700 menu-state-title-primary menu-state-icon-primary menu-state-bullet-primary menu-arrow-gray-400 fw-bold my-5 my-lg-0 align-items-stretch min-w-0">
                        <div class="menu-item me-lg-1 d-flex align-items-center min-w-0">
                            <span class="fs-4 fw-bolder text-white d-flex align-items-center min-w-0">
                                <img src="{{ asset('images/brand/armoirie-96.png') }}" alt="Armoirie Tchad" class="me-3 d-none d-lg-inline-block flex-shrink-0" style="height: 38px; width: 38px; object-fit: contain; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.25));" />
                                <span class="d-flex flex-column justify-content-center min-w-0">
                                    <span class="text-white fw-bolder fs-4 lh-1 text-truncate">{{ app_name }}</span>
                                    <span class="d-none d-xl-inline fs-8 fw-semibold pt-1 text-truncate" style="color: rgba(255,255,255,.78);">{{ app_institution }} • {{ app_country }}</span>
                                </span>
                                {% if app.user and app.user.institution %}
                                    <span class="badge ms-4 fs-8 fw-bold py-1 px-3 d-none d-sm-inline-flex align-items-center" style="background-color: var(--mci-gold); color: #002664 !important; border-radius: 6px;">
                                        <i class="bi bi-building me-1" style="color: #002664;"></i>{{ app.user.institution.nom }}
                                    </span>
                                {% endif %}
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <!--end::Navbar-->

            <!--begin::Topbar-->
            <div class="d-flex align-items-stretch flex-shrink-0">
                {% if app.user %}
                    <!--begin::User-->
                    <div class="d-flex align-items-center ms-1 ms-lg-3" id="kt_header_user_menu_toggle">
                        <!--begin::Menu wrapper-->
                        <div class="cursor-pointer symbol symbol-35px symbol-md-40px" data-kt-menu-trigger="click" data-kt-menu-attach="parent" data-kt-menu-placement="bottom-end">
                            <div class="symbol-label fs-5 fw-bold bg-primary text-white">
                                {{ app.user.firstname|first|upper }}{{ app.user.lastname|first|upper }}
                            </div>
                        </div>
                        <!--begin::Menu-->
                        <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg menu-state-primary fw-bold py-4 fs-6 w-275px" data-kt-menu="true">
                            <!--begin::Menu item-->
                            <div class="menu-item px-3">
                                <div class="menu-content d-flex align-items-center px-3">
                                    <!--begin::Avatar-->
                                    <div class="symbol symbol-50px me-4">
                                        <div class="symbol-label fs-3 fw-bold bg-light-primary text-primary">
                                            {{ app.user.firstname|first|upper }}{{ app.user.lastname|first|upper }}
                                        </div>
                                    </div>
                                    <!--end::Avatar-->
                                    <!--begin::Username-->
                                    <div class="d-flex flex-column">
                                        <div class="fw-bolder d-flex align-items-center fs-5 text-gray-900">
                                            {{ app.user.firstname }} {{ app.user.lastname }}
                                        </div>
                                        <span class="fw-bold text-muted text-hover-primary fs-7 text-truncate" style="max-width: 170px;">
                                            {{ app.user.email }}
                                        </span>
                                        {% if is_granted('ROLE_ADMIN') %}
                                            <span class="badge badge-light-success fw-bolder fs-8 px-2 py-1 mt-1 align-self-start">Administrateur</span>
                                        {% elseif is_granted('ROLE_MANAGER') %}
                                            <span class="badge badge-light-warning fw-bolder fs-8 px-2 py-1 mt-1 align-self-start">Manager</span>
                                        {% else %}
                                            <span class="badge badge-light-info fw-bolder fs-8 px-2 py-1 mt-1 align-self-start">Utilisateur</span>
                                        {% endif %}
                                    </div>
                                    <!--end::Username-->
                                </div>
                            </div>
                            <!--end::Menu item-->
                            <div class="separator my-2"></div>
                            <!--begin::Menu item-->
                            <div class="menu-item px-5">
                                <a href="{{ path('app_account_security') }}" class="menu-link px-5">
                                    <i class="bi bi-shield-lock me-2 text-primary"></i> Sécurité du compte
                                </a>
                            </div>
                            <div class="menu-item px-5">
                                <a href="{{ path('app_change_password') }}" class="menu-link px-5">
                                    <i class="bi bi-key me-2 text-warning"></i> Changer mot de passe
                                </a>
                            </div>
                            <!--end::Menu item-->
                            {% if is_granted('ROLE_ADMIN') %}
                                <div class="separator my-2"></div>
                                <div class="menu-item px-5">
                                    <a href="{{ path('app_log') }}" class="menu-link px-5">
                                        <i class="bi bi-journal-text me-2 text-info"></i> Journal d'audit
                                    </a>
                                </div>
                            {% endif %}
                            <div class="separator my-2"></div>
                            <!--begin::Menu item-->
                            <div class="menu-item px-5">
                                <a href="{{ path('app_logout') }}" class="menu-link px-5 text-danger">
                                    <i class="bi bi-box-arrow-right me-2 text-danger"></i> Déconnexion
                                </a>
                            </div>
                            <!--end::Menu item-->
                        </div>
                        <!--end::Menu-->
                        <!--end::Menu wrapper-->
                    </div>
                    <!--end::User-->
                {% else %}
                    <div class="d-flex align-items-center ms-1 ms-lg-3">
                        <a href="{{ path('app_login') }}" class="btn btn-sm btn-primary">Connexion</a>
                    </div>
                {% endif %}
            </div>
            <!--end::Topbar-->
        </div>
        <!--end::Wrapper-->
    </div>
</div>
