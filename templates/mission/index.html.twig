{% extends 'base.html.twig' %}

{% block title %}Missions & Ordres de mission{% endblock %}

{% block page_title %}
    <h1 class="d-flex align-items-center text-dark fw-bolder fs-2 my-1">
        Missions & Ordres de mission
        <span class="h-20px border-gray-300 border-start ms-3 mx-2 d-none d-md-inline"></span>
        <small class="text-muted fs-7 fw-semibold my-1 ms-1">Circuit officiel, validation hiérarchique, ordres de mission et rapports d'exécution</small>
    </h1>
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-muted">Carrière & Mobilité</li>
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-dark fw-bold">Missions & Ordres de mission</li>
{% endblock %}

{% block page_actions %}
    <div class="d-flex align-items-center gap-2">
        <a href="{{ path('app_mission_new') }}" class="btn btn-mci-primary btn-sm">
            <i class="bi bi-plus-circle fs-5 me-1"></i>
            <span class="d-none d-sm-inline">Préparer une mission</span>
        </a>
    </div>
{% endblock %}

{% block body %}
<div class="d-flex flex-column gap-6">

    <!-- Flash messages -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-mci alert-mci-{{ label == 'error' or label == 'danger' ? 'danger' : (label == 'warning' ? 'warning' : 'success') }} d-flex align-items-center p-5 mb-2" role="alert">
                <i class="bi bi-{{ label == 'error' or label == 'danger' ? 'exclamation-octagon-fill text-danger' : (label == 'warning' ? 'exclamation-triangle-fill text-warning' : 'check-circle-fill text-success') }} fs-2 me-4"></i>
                <div class="d-flex flex-column">
                    <span class="fw-bold">{{ message }}</span>
                </div>
                <button type="button" class="position-absolute position-sm-relative m-2 m-sm-0 top-0 end-0 btn btn-icon ms-sm-auto" data-bs-dismiss="alert">
                    <i class="bi bi-x fs-2"></i>
                </button>
            </div>
        {% endfor %}
    {% endfor %}

    <!-- KPIs Row -->
    <div class="row g-4 g-xl-6">
        <div class="col-sm-6 col-xl-2">
            <div class="card card-mci h-100 p-5">
                <span class="fs-8 fw-bolder text-muted text-uppercase tracking-wide mb-1">Total</span>
                <span class="fs-2hx fw-bolder text-dark mb-1">{{ stats.total }}</span>
                <span class="fs-9 text-muted">missions</span>
            </div>
        </div>
        <div class="col-sm-6 col-xl-2">
            <div class="card card-mci h-100 p-5">
                <span class="fs-8 fw-bolder text-muted text-uppercase tracking-wide mb-1">À Valider</span>
                <span class="fs-2hx fw-bolder text-warning mb-1">{{ stats.soumises }}</span>
                <span class="fs-9 text-warning fw-semibold">en instruction</span>
            </div>
        </div>
        <div class="col-sm-6 col-xl-2">
            <div class="card card-mci h-100 p-5">
                <span class="fs-8 fw-bolder text-muted text-uppercase tracking-wide mb-1">Validées</span>
                <span class="fs-2hx fw-bolder text-primary mb-1">{{ stats.validees }}</span>
                <span class="fs-9 text-primary fw-semibold">ordre émis</span>
            </div>
        </div>
        <div class="col-sm-6 col-xl-2">
            <div class="card card-mci h-100 p-5">
                <span class="fs-8 fw-bolder text-muted text-uppercase tracking-wide mb-1">En cours</span>
                <span class="fs-2hx fw-bolder text-info mb-1">{{ stats.en_cours }}</span>
                <span class="fs-9 text-info fw-semibold">sur le terrain</span>
            </div>
        </div>
        <div class="col-sm-6 col-xl-2">
            <div class="card card-mci h-100 p-5">
                <span class="fs-8 fw-bolder text-muted text-uppercase tracking-wide mb-1">Clôturées</span>
                <span class="fs-2hx fw-bolder text-success mb-1">{{ stats.cloturees }}</span>
                <span class="fs-9 text-success fw-semibold">rapport validé</span>
            </div>
        </div>
        <div class="col-sm-6 col-xl-2">
            <div class="card card-mci h-100 p-5 border-start border-4 border-primary">
                <span class="fs-8 fw-bolder text-muted text-uppercase tracking-wide mb-1">Budget engagé</span>
                <span class="fs-3 fw-bolder text-mci-blue mb-1">{{ stats.budget_total|number_format(0, ',', ' ') }} F</span>
                <span class="fs-9 text-muted">cumul estimé</span>
            </div>
        </div>
    </div>

    <!-- Filtres -->
    <div class="card card-mci">
        <div class="card-body p-6">
            <form method="get" action="{{ path('app_mission_index') }}" class="row g-3 align-items-center">
                <div class="col-md-4">
                    <div class="position-relative">
                        <i class="bi bi-search position-absolute top-50 translate-middle-y ms-4 text-muted fs-6"></i>
                        <input type="text" name="search" class="form-control form-control-solid ps-12 fs-7" placeholder="Rechercher objet, destination, référence..." value="{{ search }}">
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="status" class="form-select form-select-solid fs-7">
                        <option value="all">Tous les statuts</option>
                        <option value="0" {{ current_status == '0' ? 'selected' : '' }}>Brouillon</option>
                        <option value="1" {{ current_status == '1' ? 'selected' : '' }}>Soumise pour validation</option>
                        <option value="2" {{ current_status == '2' ? 'selected' : '' }}>Validée (Ordre émis)</option>
                        <option value="3" {{ current_status == '3' ? 'selected' : '' }}>En cours</option>
                        <option value="4" {{ current_status == '4' ? 'selected' : '' }}>Terminée (Rapport en attente)</option>
                        <option value="5" {{ current_status == '5' ? 'selected' : '' }}>Clôturée</option>
                        <option value="6" {{ current_status == '6' ? 'selected' : '' }}>Annulée</option>
                        <option value="7" {{ current_status == '7' ? 'selected' : '' }}>Refusée</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="agent" class="form-select form-select-solid fs-7">
                        <option value="">Tous les agents</option>
                        {% for emp in employees %}
                            <option value="{{ emp.id }}" {{ current_agent == emp.id ? 'selected' : '' }}>{{ emp.nomComplet }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-mci-primary btn-sm flex-grow-1">
                        <i class="bi bi-funnel-fill me-1"></i> Filtrer
                    </button>
                    <a href="{{ path('app_mission_index') }}" class="btn btn-mci-secondary btn-sm" title="Réinitialiser">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table des missions -->
    <div class="card card-mci">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-row-dashed align-middle mb-0 gs-5 gy-4">
                    <thead>
                        <tr class="text-start text-muted fw-bolder fs-7 text-uppercase gs-0 bg-light">
                            <th class="ps-6">Réf. & Objet</th>
                            <th>Destination</th>
                            <th>Période & Durée</th>
                            <th>Équipe / Chef</th>
                            <th>Transport & Budget</th>
                            <th>Statut</th>
                            <th>Ordre officiel</th>
                            <th class="text-end pe-6">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="fs-7 fw-semibold text-gray-600">
                        {% for mission in missions %}
                            <tr>
                                <td class="ps-6">
                                    <div class="fw-bolder text-dark fs-6">{{ mission.objet }}</div>
                                    <div class="d-flex align-items-center gap-1 text-muted fs-8 mt-1">
                                        <i class="bi bi-upc-scan text-muted"></i>
                                        <code>{{ mission.reference }}</code>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>{{ mission.destination }}
                                    </div>
                                    <span class="text-muted fs-8">{{ mission.pays }}{% if mission.lieuPrecis %} ({{ mission.lieuPrecis }}){% endif %}</span>
                                </td>
                                <td>
                                    <div class="text-dark">Du <strong>{{ mission.dateDebut|date('d/m/Y') }}</strong> au <strong>{{ mission.dateFin|date('d/m/Y') }}</strong></div>
                                    <span class="badge badge-light-secondary fs-8 mt-1">
                                        <i class="bi bi-calendar3 me-1"></i>{{ mission.dureeJours }} jour(s)
                                    </span>
                                </td>
                                <td>
                                    {% if mission.chefMission %}
                                        <div class="fw-bold text-mci-blue">
                                            <i class="bi bi-person-badge-fill me-1"></i>{{ mission.chefMission.nomComplet }}
                                        </div>
                                    {% else %}
                                        <div class="text-muted fs-8">Sans chef désigné</div>
                                    {% endif %}
                                    <span class="badge badge-light-primary fs-8 mt-1">{{ mission.participants|length }} participant(s)</span>
                                </td>
                                <td>
                                    <div class="text-dark">{{ mission.modeTransport|replace({'_': ' '})|title }}</div>
                                    {% if mission.budgetEstime %}
                                        <div class="text-muted fs-8">{{ mission.budgetEstime|number_format(0, ',', ' ') }} F CFA</div>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="badge {{ mission.statutBadge }}">
                                        {{ mission.statutLabel }}
                                    </span>
                                </td>
                                <td>
                                    {% if mission.acte %}
                                        <a href="{{ path('app_acte_show', {'id': mission.acte.id}) }}" class="badge badge-light-primary text-hover-primary" title="Ordre de mission: {{ mission.acte.numero }}">
                                            <i class="bi bi-file-earmark-check-fill me-1"></i> {{ mission.acte.numero }}
                                        </a>
                                    {% else %}
                                        <span class="text-muted fs-8">-</span>
                                    {% endif %}
                                </td>
                                <td class="text-end pe-6">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a href="{{ path('app_mission_show', {'id': mission.id}) }}" class="btn btn-icon btn-mci-secondary btn-sm" title="Consulter la mission">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>

                                        {% if is_granted('MISSION_EDIT', mission) %}
                                            <a href="{{ path('app_mission_edit', {'id': mission.id}) }}" class="btn btn-icon btn-mci-secondary btn-sm" title="Modifier">
                                                <i class="bi bi-pencil-square text-warning"></i>
                                            </a>
                                        {% endif %}

                                        {% if is_granted('MISSION_VALIDATE', mission) %}
                                            <button type="button" class="btn btn-icon btn-mci-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#validerModal{{ mission.id }}" title="Valider & émettre ordre de mission">
                                                <i class="bi bi-patch-check-fill text-success"></i>
                                            </button>
                                        {% endif %}

                                        {% if is_granted('MISSION_REPORT', mission) %}
                                            <a href="{{ path('app_mission_rapport', {'id': mission.id}) }}" class="btn btn-icon btn-mci-secondary btn-sm" title="Déposer rapport">
                                                <i class="bi bi-file-earmark-text-fill text-primary"></i>
                                            </a>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>

                            {# Modal Validation pour cette mission #}
                            {% if is_granted('MISSION_VALIDATE', mission) %}
                                <div class="modal fade" id="validerModal{{ mission.id }}" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form method="post" action="{{ path('app_mission_valider', {'id': mission.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('mission_valider_' ~ mission.id) }}">
                                                <div class="modal-header bg-success text-white">
                                                    <h5 class="modal-title text-white">
                                                        <i class="bi bi-patch-check-fill me-2"></i>Valider la mission & générer l'Ordre
                                                    </h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body p-6">
                                                    <p class="fs-6">Confirmez-vous la validation de la mission <strong>{{ mission.reference }}</strong> à destination de <strong>{{ mission.destination }}</strong> ?</p>
                                                    <div class="mb-4">
                                                        <div class="form-check form-switch">
                                                            <input class="form-check-input" type="checkbox" id="genererOrdre{{ mission.id }}" name="generer_ordre" value="1" checked>
                                                            <label class="form-check-label fw-semibold fs-7" for="genererOrdre{{ mission.id }}">Générer automatiquement l'acte officiel d'Ordre de mission</label>
                                                        </div>
                                                    </div>
                                                    <div class="mb-4">
                                                        <label class="form-label fs-7 fw-bold">Numéro d'acte officiel (laisser vide pour numérotation automatique)</label>
                                                        <input type="text" name="numero_ordre" class="form-control form-control-solid fs-7" placeholder="Ex: OM-{{ "now"|date("Y") }}-001">
                                                    </div>
                                                    <div class="mb-2">
                                                        <label class="form-label fs-7 fw-bold">Observations / Instructions hiérarchiques</label>
                                                        <textarea name="commentaire" class="form-control form-control-solid fs-7" rows="2" placeholder="Instructions particulières..."></textarea>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-mci-light btn-sm" data-bs-dismiss="modal">Annuler</button>
                                                    <button type="submit" class="btn btn-success btn-sm">
                                                        <i class="bi bi-patch-check-fill me-1"></i>Valider & Émettre l'ordre
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}

                        {% else %}
                            <tr>
                                <td colspan="8" class="text-center py-10 text-muted">
                                    <div class="symbol symbol-60px symbol-circle mx-auto mb-3" style="background-color: var(--mci-blue-subtle);">
                                        <span class="symbol-label">
                                            <i class="bi bi-briefcase fs-1 text-mci-blue"></i>
                                        </span>
                                    </div>
                                    <div class="fw-bolder fs-5 text-dark">Aucune mission trouvée</div>
                                    <div class="fs-7 text-muted mt-1">Aucune mission enregistrée pour les critères sélectionnés.</div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
{% endblock %}
