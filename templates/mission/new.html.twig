{% extends 'base.html.twig' %}

{% block title %}Préparer une nouvelle mission — MCI e-Circuit{% endblock %}

{% block page_title %}
    <h1 class="d-flex align-items-center text-dark fw-bolder fs-2 my-1">
        <i class="bi bi-briefcase-fill text-mci-blue me-3"></i>
        Préparer une nouvelle mission
        <span class="h-20px border-gray-300 border-start ms-3 mx-2 d-none d-md-inline"></span>
        <small class="text-muted fs-7 fw-semibold my-1 ms-1">Objectifs, destination, logistique et désignation de la délégation</small>
    </h1>
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-muted">Carrière & Mobilité</li>
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-muted">
        <a href="{{ path('app_mission_index') }}" class="text-muted text-hover-primary">Missions</a>
    </li>
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-dark fw-bold">Nouvelle mission</li>
{% endblock %}

{% block page_actions %}
    <div class="d-flex align-items-center gap-2">
        <a href="{{ path('app_mission_index') }}" class="btn btn-mci-secondary btn-sm">
            <i class="bi bi-arrow-left fs-5 me-1"></i>
            <span class="d-none d-sm-inline">Retour à la liste</span>
        </a>
    </div>
{% endblock %}

{% block body %}
<div class="d-flex flex-column gap-6">

    <!-- Flash messages -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-mci alert-mci-{{ label == 'error' or label == 'danger' ? 'danger' : (label == 'warning' ? 'warning' : 'success') }} d-flex align-items-center p-5 mb-2" role="alert">
                <i class="bi bi-{{ label == 'error' or label == 'danger' ? 'exclamation-octagon-fill text-danger' : (label == 'warning' ? 'exclamation-triangle-fill text-warning' : 'check-circle-fill text-success') }} fs-2 me-4"></i>
                <div class="d-flex flex-column">
                    <span class="fw-bold">{{ message }}</span>
                </div>
                <button type="button" class="position-absolute position-sm-relative m-2 m-sm-0 top-0 end-0 btn btn-icon ms-sm-auto" data-bs-dismiss="alert">
                    <i class="bi bi-x fs-2"></i>
                </button>
            </div>
        {% endfor %}
    {% endfor %}

    {{ form_start(form, {'attr': {'id': 'mission-form', 'class': 'needs-validation', 'novalidate': true}}) }}

    <div class="row g-6">
        <!-- Formulaire principal -->
        <div class="col-lg-8">
            <!-- Section 1 : Objet & Destination -->
            <div class="card card-mci mb-6">
                <div class="card-header border-0 pt-6">
                    <div class="card-title">
                        <i class="bi bi-geo-alt-fill fs-2 text-danger me-3"></i>
                        <h3 class="fw-bolder text-dark mb-0 fs-4">Objet & Destination</h3>
                    </div>
                </div>
                <div class="card-body py-4">
                    <div class="row g-5">
                        <div class="col-12">
                            <label class="form-label fw-bolder fs-7 text-dark" for="{{ form.objet.vars.id }}">
                                <i class="bi bi-card-text me-1 text-mci-blue"></i>Objet de la mission *
                            </label>
                            {{ form_widget(form.objet, {'attr': {'class': 'form-control form-control-solid fs-7', 'placeholder': 'Ex: Participation aux assises régionales du commerce...'}}) }}
                            {{ form_errors(form.objet) }}
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bolder fs-7 text-dark" for="{{ form.destination.vars.id }}">
                                <i class="bi bi-geo-alt me-1 text-danger"></i>Ville ou Localité de destination *
                            </label>
                            {{ form_widget(form.destination, {'attr': {'class': 'form-control form-control-solid fs-7', 'placeholder': 'Ex: Moundou, Abéché, Paris...'}}) }}
                            {{ form_errors(form.destination) }}
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-bolder fs-7 text-dark" for="{{ form.pays.vars.id }}">
                                <i class="bi bi-globe me-1 text-mci-blue"></i>Pays *
                            </label>
                            {{ form_widget(form.pays, {'attr': {'class': 'form-control form-control-solid fs-7', 'placeholder': 'Tchad'}}) }}
                            {{ form_errors(form.pays) }}
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-semibold fs-7 text-muted" for="{{ form.lieuPrecis.vars.id }}">
                                <i class="bi bi-building me-1 text-muted"></i>Lieu précis (optionnel)
                            </label>
                            {{ form_widget(form.lieuPrecis, {'attr': {'class': 'form-control form-control-solid fs-7', 'placeholder': 'Hôtel, Palais du 15 Janvier...'}}) }}
                            {{ form_errors(form.lieuPrecis) }}
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold fs-7 text-muted" for="{{ form.itineraire.vars.id }}">
                                <i class="bi bi-signpost-split me-1 text-muted"></i>Itinéraire prévisionnel
                            </label>
                            {{ form_widget(form.itineraire, {'attr': {'class': 'form-control form-control-solid fs-7', 'placeholder': 'Ex: N\'Djaména - Bongor - Moundou - N\'Djaména'}}) }}
                            {{ form_errors(form.itineraire) }}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 2 : Période, Logistique & Budget -->
            <div class="card card-mci mb-6">
                <div class="card-header border-0 pt-6">
                    <div class="card-title">
                        <i class="bi bi-calendar3 fs-2 text-mci-blue me-3"></i>
                        <h3 class="fw-bolder text-dark mb-0 fs-4">Période, Transport & Logistique</h3>
                    </div>
                </div>
                <div class="card-body py-4">
                    <div class="row g-5">
                        <div class="col-md-6">
                            <label class="form-label fw-bolder fs-7 text-dark" for="{{ form.dateDebut.vars.id }}">
                                <i class="bi bi-calendar-event me-1 text-success"></i>Date de début *
                            </label>
                            {{ form_widget(form.dateDebut, {'attr': {'class': 'form-control form-control-solid fs-7'}}) }}
                            {{ form_errors(form.dateDebut) }}
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bolder fs-7 text-dark" for="{{ form.dateFin.vars.id }}">
                                <i class="bi bi-calendar-check me-1 text-danger"></i>Date de fin *
                            </label>
                            {{ form_widget(form.dateFin, {'attr': {'class': 'form-control form-control-solid fs-7'}}) }}
                            {{ form_errors(form.dateFin) }}
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bolder fs-7 text-dark" for="{{ form.modeTransport.vars.id }}">
                                <i class="bi bi-truck me-1 text-mci-blue"></i>Moyen de transport *
                            </label>
                            {{ form_widget(form.modeTransport, {'attr': {'class': 'form-select form-select-solid fs-7'}}) }}
                            {{ form_errors(form.modeTransport) }}
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bolder fs-7 text-dark" for="{{ form.priseEnCharge.vars.id }}">
                                <i class="bi bi-credit-card me-1 text-mci-blue"></i>Prise en charge financière *
                            </label>
                            {{ form_widget(form.priseEnCharge, {'attr': {'class': 'form-select form-select-solid fs-7'}}) }}
                            {{ form_errors(form.priseEnCharge) }}
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold fs-7 text-muted" for="{{ form.budgetEstime.vars.id }}">
                                <i class="bi bi-cash-stack me-1 text-muted"></i>Budget estimé (FCFA)
                            </label>
                            {{ form_widget(form.budgetEstime, {'attr': {'class': 'form-control form-control-solid fs-7', 'placeholder': 'Montant en FCFA'}}) }}
                            {{ form_errors(form.budgetEstime) }}
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold fs-7 text-muted" for="{{ form.imputationBudgetaire.vars.id }}">
                                <i class="bi bi-journal-bookmark me-1 text-muted"></i>Ligne d'imputation budgétaire
                            </label>
                            {{ form_widget(form.imputationBudgetaire, {'attr': {'class': 'form-control form-control-solid fs-7', 'placeholder': 'Ex: Ligne 6241 - Déplacements nationaux'}}) }}
                            {{ form_errors(form.imputationBudgetaire) }}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 3 : Délégation -->
            <div class="card card-mci">
                <div class="card-header border-0 pt-6">
                    <div class="card-title">
                        <i class="bi bi-people-fill fs-2 text-mci-blue me-3"></i>
                        <h3 class="fw-bolder text-dark mb-0 fs-4">Délégation & Agents concernés</h3>
                    </div>
                </div>
                <div class="card-body py-4">
                    <div class="row g-5">
                        <div class="col-md-6">
                            <label class="form-label fw-bolder fs-7 text-dark" for="{{ form.chefMission.vars.id }}">
                                <i class="bi bi-person-badge-fill me-1 text-mci-blue"></i>Chef de mission *
                            </label>
                            {{ form_widget(form.chefMission, {'attr': {'class': 'form-select form-select-solid fs-7'}}) }}
                            {{ form_errors(form.chefMission) }}
                            <div class="text-muted fs-8 mt-1">Agent responsable de la délégation et de la remise du rapport final.</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bolder fs-7 text-dark" for="{{ form.agentsParticipants.vars.id }}">
                                <i class="bi bi-person-plus-fill me-1 text-mci-blue"></i>Agents participants
                            </label>
                            {{ form_widget(form.agentsParticipants, {'attr': {'class': 'form-select form-select-solid fs-7'}}) }}
                            {{ form_errors(form.agentsParticipants) }}
                            <div class="text-muted fs-8 mt-1">Sélectionnez les agents accompagnateurs.</div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold fs-7 text-dark" for="{{ form.description.vars.id }}">
                                <i class="bi bi-file-text me-1 text-mci-blue"></i>Termes de référence & Objectifs détaillés
                            </label>
                            {{ form_widget(form.description, {'attr': {'class': 'form-control form-control-solid fs-7', 'rows': 4, 'placeholder': 'Détaillez le mandat de la mission, les étapes clés, les partenaires à rencontrer et les résultats attendus...'}}) }}
                            {{ form_errors(form.description) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Panneau latéral / Actions -->
        <div class="col-lg-4">
            <!-- Rappel institutionnel -->
            <div class="card card-mci mb-6 p-6">
                <div class="d-flex align-items-center mb-4">
                    <div class="symbol symbol-40px symbol-circle me-3" style="background-color: var(--mci-blue-subtle);">
                        <span class="symbol-label">
                            <i class="bi bi-shield-check fs-3 text-mci-blue"></i>
                        </span>
                    </div>
                    <div>
                        <h5 class="fw-bolder text-dark mb-0 fs-6">Circuit d'Ordre de Mission</h5>
                        <span class="text-muted fs-8">MCI — République du Tchad</span>
                    </div>
                </div>
                <p class="text-muted fs-7 mb-0">
                    L'ordre de mission officiel avec numéro réglementaire et visa d'ordonnateur est automatiquement généré lors de la validation hiérarchique.
                </p>
            </div>

            <!-- Boutons de soumission -->
            <div class="card card-mci p-6">
                <div class="d-flex flex-column gap-3">
                    <button type="submit" name="save_and_submit" class="btn btn-mci-primary w-100 py-3">
                        <i class="bi bi-send-check me-1"></i> Soumettre pour validation
                    </button>
                    <button type="submit" name="save_draft" class="btn btn-mci-secondary w-100 py-3">
                        <i class="bi bi-save me-1"></i> Enregistrer en brouillon
                    </button>
                    <a href="{{ path('app_mission_index') }}" class="btn btn-mci-light w-100">
                        <i class="bi bi-x-lg me-1"></i> Annuler
                    </a>
                </div>
            </div>
        </div>
    </div>

    {{ form_end(form) }}

</div>
{% endblock %}
