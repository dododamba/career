{% extends 'base.html.twig' %}

{% block title %}Détail de la fonction {{ fonction.libelle }}{% endblock %}

{% block page_title %}
    <h1 class="d-flex align-items-center text-dark fw-bolder fs-2 my-1">
        Détail de la fonction
        <span class="h-20px border-gray-300 border-start ms-3 mx-2 d-none d-md-inline"></span>
        <small class="text-muted fs-7 fw-semibold my-1 ms-1">{{ fonction.libelle }}</small>
    </h1>
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-muted">Administration</li>
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-muted">
        <a href="{{ path('app_fonction_index') }}" class="text-muted text-hover-primary">Fonctions</a>
    </li>
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-dark fw-bold">{{ fonction.libelle }}</li>
{% endblock %}

{% block page_actions %}
    {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_fonction_edit', {'id': fonction.id}) }}" class="btn btn-mci-primary me-2">
            <i class="bi bi-pencil-square me-1"></i>Modifier
        </a>
    {% endif %}
    <a href="{{ path('app_fonction_index') }}" class="btn btn-mci-light">
        <i class="bi bi-arrow-left me-1"></i>Retour à la liste
    </a>
{% endblock %}

{% block body %}
<div class="row g-6">
    <!--begin::Fiche Récapitulative-->
    <div class="col-lg-5 col-xl-4">
        <div class="card card-mci mb-6">
            <div class="card-body p-8 text-center">
                <div class="symbol symbol-80px symbol-circle mx-auto mb-4" style="background-color: var(--mci-blue-subtle);">
                    <i class="bi bi-award-fill text-mci-blue fs-1"></i>
                </div>
                <h3 class="fs-2 fw-bolder text-dark mb-1">{{ fonction.libelle }}</h3>
                <span class="text-muted fs-7 d-block mb-4">Identifiant système : #{{ fonction.id }}</span>

                <div class="d-flex justify-content-center gap-2 mb-6">
                    {% if fonction.institution %}
                        <span class="badge badge-mci badge-mci-blue">
                            <i class="bi bi-building me-1"></i>{{ fonction.institution.nom }}
                        </span>
                    {% else %}
                        <span class="badge badge-mci badge-mci-gold">
                            <i class="bi bi-globe me-1"></i>Globale (Système)
                        </span>
                    {% endif %}
                    <span class="badge badge-mci badge-mci-active">
                        <i class="bi bi-people-fill me-1"></i>{{ fonction.employes|length }} agent(s)
                    </span>
                </div>

                <div class="separator my-4 border-gray-200"></div>

                <div class="text-start">
                    <span class="text-muted fw-bold fs-7 d-block text-uppercase mb-2">Description des attributions :</span>
                    <p class="text-gray-800 fs-6 bg-light p-4 rounded-2 mb-0" style="white-space: pre-line;">
                        {{ fonction.description|default('Aucune description enregistrée pour cette fonction.') }}
                    </p>
                </div>
            </div>
        </div>
    </div>
    <!--end::Fiche Récapitulative-->

    <!--begin::Personnel rattaché-->
    <div class="col-lg-7 col-xl-8">
        <div class="card card-mci">
            <div class="card-header border-0 pt-6 pb-6 d-flex align-items-center justify-content-between">
                <div class="card-title d-flex align-items-center">
                    <i class="bi bi-people text-mci-blue fs-2 me-2"></i>
                    <h3 class="fs-4 fw-bolder text-dark mb-0">Agents rattachés à cette fonction</h3>
                </div>
                <span class="badge badge-mci badge-mci-blue fs-7 fw-bold">
                    {{ fonction.employes|length }} agent(s)
                </span>
            </div>

            <div class="card-body pt-0">
                {% if fonction.employes is not empty %}
                    <div class="table-responsive">
                        <table class="table table-mci align-middle table-row-dashed fs-6 gy-3">
                            <thead>
                                <tr class="text-start text-muted fw-bolder fs-7 text-uppercase gs-0">
                                    <th>Agent</th>
                                    <th>Service</th>
                                    <th>Statut</th>
                                    <th class="text-end">Fiche</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for employe in fonction.employes %}
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="symbol symbol-35px symbol-circle me-3" style="background-color: var(--mci-blue-subtle);">
                                                    <span class="symbol-label text-mci-blue fw-bold fs-7">
                                                        {{ employe.nom|first }}{{ employe.prenom|first }}
                                                    </span>
                                                </div>
                                                <div>
                                                    <a href="{{ path('app_employe_show', {'id': employe.id}) }}" class="text-dark fw-bold text-hover-primary">
                                                        {{ employe.nom }} {{ employe.prenom }}
                                                    </a>
                                                    <div class="text-muted fs-8">Matricule: {{ employe.matricule|default('N/A') }}</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="text-gray-800 fs-7">
                                                {{ employe.service ? employe.service.nom : '— Non assigné —' }}
                                            </span>
                                        </td>
                                        <td>
                                            {% if employe.actif %}
                                                <span class="badge badge-mci badge-mci-active fs-8">Actif</span>
                                            {% else %}
                                                <span class="badge badge-mci badge-mci-inactive fs-8">Inactif</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-end">
                                            <a href="{{ path('app_employe_show', {'id': employe.id}) }}" class="btn btn-sm btn-icon btn-mci-light btn-action-icon" data-bs-toggle="tooltip" title="Voir l'agent">
                                                <i class="bi bi-person-badge text-primary"></i>
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="text-center py-10">
                        <i class="bi bi-people text-muted fs-3x mb-3 d-block"></i>
                        <h5 class="text-dark fw-bold mb-1">Aucun agent affecté</h5>
                        <p class="text-muted fs-7 mb-0">Cette fonction n'est actuellement attribuée à aucun personnel actif.</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
    <!--end::Personnel rattaché-->
</div>
{% endblock %}
