{% extends 'base.html.twig' %}

{% block title %}Fonctions{% endblock %}

{% block page_title %}
    <h1 class="d-flex align-items-center text-dark fw-bolder fs-2 my-1">
        Fonctions
        <span class="h-20px border-gray-300 border-start ms-3 mx-2 d-none d-md-inline"></span>
        <small class="text-muted fs-7 fw-semibold my-1 ms-1">Gestion des fonctions et nomenclatures de l'organisation</small>
    </h1>
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-muted">Administration</li>
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-dark fw-bold">Fonctions</li>
{% endblock %}

{% block page_actions %}
    {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_fonction_new') }}" class="btn btn-mci-primary">
            <i class="bi bi-plus-lg fs-5"></i>
            <span>Nouvelle fonction</span>
        </a>
    {% endif %}
{% endblock %}

{% block body %}
<div class="row g-6" data-controller="table">
    <div class="col-12">
        <div class="card card-mci">
            <!--begin::Card header-->
            <div class="card-header border-0 pt-6 pb-6 d-flex flex-wrap align-items-center justify-content-between gap-4">
                <!--begin::Search-->
                <div class="d-flex align-items-center position-relative my-1">
                    <i class="bi bi-search fs-4 position-absolute ms-4 text-muted"></i>
                    <input type="text" 
                           data-table-target="input" 
                           data-action="input->table#filter" 
                           class="form-control form-control-mci ps-12 w-250px w-md-350px" 
                           placeholder="Rechercher une fonction..." 
                           aria-label="Rechercher une fonction" />
                </div>
                <!--end::Search-->

                <!--begin::Card toolbar-->
                <div class="d-flex align-items-center gap-3">
                    <span class="badge badge-mci badge-mci-blue fs-7 fw-bold px-3 py-2">
                        <i class="bi bi-briefcase me-1"></i>
                        {{ fonctions|length }} fonction(s) au total
                    </span>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_fonction_new') }}" class="btn btn-mci-primary d-none d-sm-inline-flex">
                            <i class="bi bi-plus-lg fs-5"></i>
                            <span>Ajouter</span>
                        </a>
                    {% endif %}
                </div>
                <!--end::Card toolbar-->
            </div>
            <!--end::Card header-->

            <!--begin::Card body-->
            <div class="card-body pt-0">
                <div class="table-responsive">
                    <table class="table table-mci align-middle table-row-dashed fs-6 gy-4">
                        <thead>
                            <tr class="text-start text-muted fw-bolder fs-7 text-uppercase gs-0">
                                <th class="w-60px ps-4">#</th>
                                <th class="min-w-200px">Fonction</th>
                                <th class="min-w-250px">Description</th>
                                <th class="min-w-120px text-center">Effectif</th>
                                <th class="min-w-160px">Institution</th>
                                <th class="min-w-120px text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="text-gray-700 fw-semibold">
                            {% for fonction in fonctions %}
                                <tr data-table-target="row">
                                    <td class="ps-4">
                                        <span class="text-muted fw-bold fs-7">#{{ fonction.id }}</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="symbol symbol-40px symbol-circle me-3" style="background-color: var(--mci-blue-subtle);">
                                                <span class="symbol-label text-mci-blue fw-bold fs-6">
                                                    <i class="bi bi-award text-mci-blue fs-4"></i>
                                                </span>
                                            </div>
                                            <div class="d-flex flex-column">
                                                <a href="{{ path('app_fonction_show', {'id': fonction.id}) }}" class="text-dark text-hover-primary fw-bolder fs-6">
                                                    {{ fonction.libelle }}
                                                </a>
                                                {% if fonction.slug %}
                                                    <span class="text-muted fs-8">{{ fonction.slug }}</span>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-gray-800 fs-7">
                                            {{ fonction.description|default('— Aucune description renseignée —') }}
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        {% set nbEmployes = fonction.employes|length %}
                                        <span class="badge badge-mci {% if nbEmployes > 0 %}badge-mci-active{% else %}badge-mci-inactive{% endif %} fs-8">
                                            <i class="bi bi-people-fill me-1"></i>
                                            {{ nbEmployes }} employé{{ nbEmployes > 1 ? 's' : '' }}
                                        </span>
                                    </td>
                                    <td>
                                        {% if fonction.institution %}
                                            <span class="badge badge-mci badge-mci-blue fs-8">
                                                <i class="bi bi-building me-1"></i>{{ fonction.institution.nom }}
                                            </span>
                                        {% else %}
                                            <span class="badge badge-mci badge-mci-gold fs-8">
                                                <i class="bi bi-globe me-1"></i>Globale (Système)
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end align-items-center gap-2">
                                            <a href="{{ path('app_fonction_show', {'id': fonction.id}) }}" 
                                               class="btn btn-sm btn-icon btn-mci-light btn-action-icon" 
                                               data-bs-toggle="tooltip" 
                                               title="Consulter les détails">
                                                <i class="bi bi-eye text-primary"></i>
                                            </a>
                                            {% if is_granted('ROLE_ADMIN') %}
                                                <a href="{{ path('app_fonction_edit', {'id': fonction.id}) }}" 
                                                   class="btn btn-sm btn-icon btn-mci-light btn-action-icon" 
                                                   data-bs-toggle="tooltip" 
                                                   title="Modifier la fonction">
                                                    <i class="bi bi-pencil-square text-warning"></i>
                                                </a>
                                                <form method="post" 
                                                      action="{{ path('app_fonction_delete', {'id': fonction.id}) }}" 
                                                      class="d-inline-block" 
                                                      onsubmit="return confirm('Êtes-vous certain de vouloir supprimer définitivement cette fonction ?');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ fonction.id) }}">
                                                    <button type="submit" 
                                                            class="btn btn-sm btn-icon btn-mci-light btn-action-icon" 
                                                            data-bs-toggle="tooltip" 
                                                            title="Supprimer la fonction">
                                                        <i class="bi bi-trash text-mci-red"></i>
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="6" class="text-center py-12">
                                        <div class="d-flex flex-column align-items-center justify-content-center">
                                            <i class="bi bi-briefcase text-muted fs-3x mb-3"></i>
                                            <h4 class="text-dark fw-bold mb-1">Aucune fonction enregistrée</h4>
                                            <p class="text-muted fs-7 mb-4">Commencez par ajouter une nouvelle fonction administrative pour votre institution.</p>
                                            {% if is_granted('ROLE_ADMIN') %}
                                                <a href="{{ path('app_fonction_new') }}" class="btn btn-mci-primary">
                                                    <i class="bi bi-plus-lg fs-5"></i>
                                                    <span>Ajouter une première fonction</span>
                                                </a>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}

                            <!-- Ligne vide affichée par Stimulus en cas de filtre sans résultat -->
                            <tr data-table-target="empty" style="display: none;">
                                <td colspan="6" class="text-center py-10">
                                    <div class="d-flex flex-column align-items-center">
                                        <i class="bi bi-search text-muted fs-2x mb-2"></i>
                                        <span class="text-muted fs-6">Aucune fonction ne correspond à votre critère de recherche.</span>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <!--end::Card body-->

            <!--begin::Card footer-->
            <div class="card-footer d-flex flex-wrap justify-content-between align-items-center py-4">
                <span class="text-muted fs-7">
                    Affichage de <span class="fw-bold text-dark">{{ fonctions|length }}</span> fonction(s) • {{ app_name }}
                </span>
                <span class="text-muted fs-8">
                    République du Tchad • Ministère du Commerce et de l'Industrie
                </span>
            </div>
            <!--end::Card footer-->
        </div>
    </div>
</div>
{% endblock %}
