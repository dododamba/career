{% extends 'base.html.twig' %}

{% block title %}Visites de {{ employe.nomComplet }}{% endblock %}

{% block page_title %}
    <h1 class="d-flex align-items-center text-gray-900 fw-bold my-1 fs-3">
        Visites Reçues : {{ employe.nomComplet }}
        <span class="h-20px border-gray-200 border-start ms-3 mx-2"></span>
        <small class="text-muted fs-7 fw-semibold my-1 ms-1">Historique des accueils pour ce collaborateur</small>
    </h1>
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item text-muted">
        <a href="{{ path('app_dashboard') }}" class="text-muted text-hover-primary">Accueil</a>
    </li>
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-muted">
        <a href="{{ path('app_visite_index') }}" class="text-muted text-hover-primary">Visites</a>
    </li>
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-gray-900">{{ employe.nomComplet }}</li>
{% endblock %}

{% block page_actions %}
    <div class="d-flex align-items-center gap-2">
        <a href="{{ path('app_visite_index') }}" class="btn btn-sm btn-light">
            <i class="ki-duotone ki-arrow-left fs-4 me-1"></i> Toutes les visites
        </a>
        <a href="{{ path('app_visite_new') }}" class="btn btn-sm btn-mci-primary">
            <i class="ki-duotone ki-plus-circle fs-4 me-1"></i> Nouvelle visite
        </a>
    </div>
{% endblock %}

{% block body %}
<div class="d-flex flex-column gap-5">

    <!-- Collaborateur Banner -->
    <div class="card card-mci border-0 shadow-sm">
        <div class="card-body p-6">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-4">
                <div class="d-flex align-items-center">
                    <div class="symbol symbol-60px symbol-circle me-4 bg-light-primary text-primary fw-bolder fs-2 d-flex align-items-center justify-content-center">
                        {{ employe.nom ? employe.nom|first|upper : 'E' }}
                    </div>
                    <div>
                        <h2 class="fs-2 fw-bold text-gray-900 mb-1">{{ employe.nomComplet }}</h2>
                        <div class="text-muted fs-7">
                            Matricule : <strong>{{ employe.matricule|default('N/D') }}</strong>
                            {% if employe.service %}
                                &bull; Service : <strong>{{ employe.service.nom }}</strong>
                            {% endif %}
                        </div>
                    </div>
                </div>
                <span class="badge badge-light-primary fw-bold py-2 px-3 fs-7">
                    {{ visites|length }} visites enregistrées
                </span>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="card card-flush border-0 shadow-sm">
        <div class="card-header pt-5">
            <h3 class="card-title align-items-start flex-column">
                <span class="card-label fw-bold fs-4 text-gray-900">Historique des Visites</span>
                <span class="text-muted mt-1 fw-semibold fs-7">Tous les rendez-vous et accès enregistrés</span>
            </h3>
        </div>

        <div class="card-body pt-0">
            <div class="table-responsive">
                <table class="table align-middle table-row-dashed fs-6 gy-4">
                    <thead>
                        <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
                            <th>Visiteur</th>
                            <th>Contact</th>
                            <th class="text-center">Arrivée</th>
                            <th class="text-center">Départ</th>
                            <th class="text-center">Durée</th>
                            <th class="text-center">Statut</th>
                            <th class="text-center">Badge</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="text-gray-600 fw-semibold">
                        {% for visite in visites %}
                            <tr>
                                <td class="fw-bold text-gray-900">{{ visite.visiteur }}</td>
                                <td>
                                    <span class="text-muted fs-7">
                                        {{ visite.telephone|default('') }}{% if visite.telephone and visite.email %} &bull; {% endif %}{{ visite.email|default('') }}
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge badge-light-success font-monospace fw-bold fs-7">
                                        {{ visite.arrivee ? visite.arrivee|date('d/m/Y H:i') : '—' }}
                                    </span>
                                </td>
                                <td class="text-center">
                                    {% if visite.depart %}
                                        <span class="badge badge-light-secondary font-monospace fw-bold fs-7">
                                            {{ visite.depart|date('d/m/Y H:i') }}
                                        </span>
                                    {% else %}
                                        <span class="badge badge-light-warning fw-bold fs-8">En cours</span>
                                    {% endif %}
                                </td>
                                <td class="text-center">
                                    {% if visite.duration %}
                                        <span class="badge badge-light-info fw-bold fs-8">{{ visite.duration }}</span>
                                    {% else %}
                                        <span class="text-muted fs-8">—</span>
                                    {% endif %}
                                </td>
                                <td class="text-center">
                                    {% if visite.statut %}
                                        <span class="badge badge-light-secondary fw-bold py-2 px-3">Terminée</span>
                                    {% else %}
                                        <span class="badge badge-light-success fw-bold py-2 px-3">En cours</span>
                                    {% endif %}
                                </td>
                                <td class="text-center">
                                    {% if visite.badge %}
                                        <span class="badge badge-light-primary font-monospace fw-bold">#{{ visite.badge }}</span>
                                    {% else %}
                                        <span class="text-muted fs-8">—</span>
                                    {% endif %}
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a href="{{ path('app_visite_show', {'id': visite.id}) }}" class="btn btn-icon btn-light btn-sm" title="Détails">
                                            <i class="ki-duotone ki-eye fs-4 text-primary"></i>
                                        </a>
                                        <a href="{{ path('app_visite_edit', {'id': visite.id}) }}" class="btn btn-icon btn-light btn-sm" title="Modifier">
                                            <i class="ki-duotone ki-pencil fs-4 text-warning"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="8" class="text-center py-8 text-muted">
                                    Aucune visite enregistrée pour ce collaborateur.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}