{% extends 'base.html.twig' %}

{% block title %}Tableau de Bord des Visites & Accueil{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .chart-container {
            position: relative;
            height: 320px;
        }
    </style>
{% endblock %}

{% block body %}
<div class="d-flex flex-column gap-6">

    <!-- Header & Toolbar -->
    <div class="card card-mci border-0 shadow-sm">
        <div class="card-body py-5 px-6">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge badge-light-primary fw-bold text-uppercase px-3 py-2">
                            <i class="ki-outline ki-profile-user fs-7 me-1 text-primary"></i> Service Accueil & Contrôle des Accès
                        </span>
                    </div>
                    <h1 class="text-gray-900 fw-bolder fs-2 mb-1">Tableau de Bord des Visites</h1>
                    <p class="text-gray-600 fs-7 mb-0">Statistiques et flux des usagers reçus au sein de l'institution.</p>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <a href="{{ path('app_visite_new') }}" class="btn btn-sm btn-mci-primary">
                        <i class="ki-outline ki-plus fs-6 me-1"></i> Enregistrer une visite
                    </a>
                    <a href="{{ path('app_visite_index') }}" class="btn btn-sm btn-light">
                        <i class="ki-outline ki-element-11 fs-6 me-1"></i> Registre complet
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- KPI Cards Row -->
    <div class="row g-5">
        <!-- Aujourd'hui -->
        <div class="col-md-4">
            <div class="card card-mci border-0 shadow-sm h-100">
                <div class="card-body p-6">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="symbol symbol-50px symbol-circle bg-light-primary">
                            <span class="symbol-label bg-light-primary text-primary">
                                <i class="ki-outline ki-calendar-tick fs-2 text-primary"></i>
                            </span>
                        </div>
                        <span class="badge badge-light-primary fs-8 fw-bolder">Aujourd'hui</span>
                    </div>
                    <div class="d-flex flex-column">
                        <span class="fs-2hx fw-bolder text-gray-900 mb-1">{{ visites_aujourdhui|default(0) }}</span>
                        <span class="text-gray-500 fs-7">Visiteurs enregistrés ce jour</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cette Semaine -->
        <div class="col-md-4">
            <div class="card card-mci border-0 shadow-sm h-100">
                <div class="card-body p-6">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="symbol symbol-50px symbol-circle bg-light-success">
                            <span class="symbol-label bg-light-success text-success">
                                <i class="ki-outline ki-calendar-8 fs-2 text-success"></i>
                            </span>
                        </div>
                        <span class="badge badge-light-success fs-8 fw-bolder">Cette Semaine</span>
                    </div>
                    <div class="d-flex flex-column">
                        <span class="fs-2hx fw-bolder text-gray-900 mb-1">{{ visites_semaine|default(0) }}</span>
                        <span class="text-gray-500 fs-7">Visiteurs au cours de la semaine</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ce Mois -->
        <div class="col-md-4">
            <div class="card card-mci border-0 shadow-sm h-100">
                <div class="card-body p-6">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="symbol symbol-50px symbol-circle bg-light-warning">
                            <span class="symbol-label bg-light-warning text-warning">
                                <i class="ki-outline ki-chart-simple-3 fs-2 text-warning"></i>
                            </span>
                        </div>
                        <span class="badge badge-light-warning fs-8 fw-bolder">Ce Mois</span>
                    </div>
                    <div class="d-flex flex-column">
                        <span class="fs-2hx fw-bolder text-gray-900 mb-1">{{ visites_mois|default(0) }}</span>
                        <span class="text-gray-500 fs-7">Cumul mensuel des usagers</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-5">
        <!-- Évolution Mensuelle -->
        <div class="col-lg-8">
            <div class="card card-mci border-0 shadow-sm h-100">
                <div class="card-header border-0 pt-6">
                    <div class="card-title d-flex align-items-center gap-2">
                        <i class="ki-outline ki-chart-line fs-3 text-primary"></i>
                        <span class="fw-bolder fs-5 text-gray-900">Évolution Mensuelle des Visites</span>
                    </div>
                </div>
                <div class="card-body pt-2">
                    <div class="chart-container">
                        <canvas id="visitesMonthlyChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Répartition Hebdomadaire -->
        <div class="col-lg-4">
            <div class="card card-mci border-0 shadow-sm h-100">
                <div class="card-header border-0 pt-6">
                    <div class="card-title d-flex align-items-center gap-2">
                        <i class="ki-outline ki-chart-simple fs-3 text-success"></i>
                        <span class="fw-bolder fs-5 text-gray-900">Affluence Hebdomadaire</span>
                    </div>
                </div>
                <div class="card-body pt-2">
                    <div class="chart-container">
                        <canvas id="visitesDailyChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Données pour le graphique quotidien
            const dailyData = {{ visites_par_jour|default([])|json_encode|raw }};
            const days = ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi', 'Dimanche'];
            const dailyValues = [0, 0, 0, 0, 0, 0, 0];
            
            if (Array.isArray(dailyData)) {
                dailyData.forEach(item => {
                    const dayIndex = parseInt(item.day_of_week) - 1;
                    if (dayIndex >= 0 && dayIndex < 7) {
                        dailyValues[dayIndex] = parseInt(item.visit_count);
                    }
                });
            }
            
            // Graphique répartition par jour (Bar - Vert #50cd89)
            const dailyCanvas = document.getElementById('visitesDailyChart');
            if (dailyCanvas) {
                new Chart(dailyCanvas, {
                    type: 'bar',
                    data: {
                        labels: days,
                        datasets: [{
                            label: 'Visites',
                            data: dailyValues,
                            backgroundColor: 'rgba(80, 205, 137, 0.85)',
                            borderColor: '#50cd89',
                            borderWidth: 1,
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            x: { grid: { display: false } },
                            y: {
                                beginAtZero: true,
                                ticks: { precision: 0 },
                                grid: { color: '#F1F1F4' }
                            }
                        },
                        plugins: {
                            legend: { display: false }
                        }
                    }
                });
            }
            
            // Requête AJAX pour charger les données mensuelles
            fetch('{{ path('app_visite_stats_mois') }}')
                .then(response => response.json())
                .then(data => {
                    const months = [];
                    const values = [];
                    
                    data.sort((a, b) => {
                        const yearA = parseInt(a.year);
                        const yearB = parseInt(b.year);
                        const monthA = parseInt(a.month);
                        const monthB = parseInt(b.month);
                        return yearA !== yearB ? yearA - yearB : monthA - monthB;
                    });
                    
                    const monthNames = ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Juin', 'Juil', 'Août', 'Sep', 'Oct', 'Nov', 'Déc'];
                    data.forEach(item => {
                        const monthIndex = parseInt(item.month) - 1;
                        const monthName = monthNames[monthIndex] || item.month;
                        months.push(`${monthName} ${item.year}`);
                        values.push(parseInt(item.visit_count));
                    });
                    
                    const monthlyCanvas = document.getElementById('visitesMonthlyChart');
                    if (monthlyCanvas) {
                        new Chart(monthlyCanvas, {
                            type: 'line',
                            data: {
                                labels: months,
                                datasets: [{
                                    label: 'Visites mensuelles',
                                    data: values,
                                    fill: true,
                                    backgroundColor: 'rgba(0, 38, 100, 0.08)',
                                    borderColor: '#002664',
                                    tension: 0.35,
                                    pointBackgroundColor: '#002664',
                                    pointBorderColor: '#FFFFFF',
                                    pointRadius: 4,
                                    pointHoverRadius: 7
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                scales: {
                                    x: { grid: { display: false } },
                                    y: {
                                        beginAtZero: true,
                                        ticks: { precision: 0 },
                                        grid: { color: '#F1F1F4' }
                                    }
                                },
                                plugins: {
                                    legend: { display: false }
                                }
                            }
                        });
                    }
                })
                .catch(error => {
                    console.error('Erreur lors du chargement des statistiques mensuelles:', error);
                });
        });
    </script>
{% endblock %}