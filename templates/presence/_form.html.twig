{{ form_start(form, {'attr': {'class': 'form d-flex flex-column gap-6'}}) }}

<div class="row g-5">
    <div class="col-md-4">
        <label class="form-label required fw-semibold fs-6 text-gray-700">Date de présence</label>
        {{ form_widget(form.date_presence, {'attr': {'class': 'form-control form-control-solid'}}) }}
        <div class="text-danger fs-7 mt-1">{{ form_errors(form.date_presence) }}</div>
    </div>
    <div class="col-md-4">
        <label class="form-label fw-semibold fs-6 text-gray-700">Heure d'entrée</label>
        {{ form_widget(form.heure_entree, {'attr': {'class': 'form-control form-control-solid'}}) }}
        <div class="text-danger fs-7 mt-1">{{ form_errors(form.heure_entree) }}</div>
    </div>
    <div class="col-md-4">
        <label class="form-label fw-semibold fs-6 text-gray-700">Heure de sortie</label>
        {{ form_widget(form.heure_sortie, {'attr': {'class': 'form-control form-control-solid'}}) }}
        <div class="text-danger fs-7 mt-1">{{ form_errors(form.heure_sortie) }}</div>
    </div>
</div>

<div class="row g-5 align-items-center">
    <div class="col-md-6">
        <div class="d-flex align-items-center justify-content-between p-4 rounded bg-light border border-dashed border-gray-300">
            <div>
                <label class="form-check-label fw-bold text-gray-800 fs-6" for="{{ form.statut.vars.id }}">Statut de présence</label>
                <div class="text-muted fs-8">Cochez pour marquer la présence comme effective et validée</div>
            </div>
            <div class="form-check form-switch form-check-custom form-check-solid">
                {{ form_widget(form.statut, {'attr': {'class': 'form-check-input h-25px w-45px'}}) }}
            </div>
        </div>
        <div class="text-danger fs-7 mt-1">{{ form_errors(form.statut) }}</div>
    </div>
</div>

<div class="d-flex justify-content-end gap-3 pt-4 border-top">
    <a href="{{ path('app_presence_index') }}" class="btn btn-light">Annuler</a>
    <button type="submit" class="btn btn-mci-primary">
        <i class="ki-duotone ki-check fs-4 me-1"></i> {{ button_label|default('Enregistrer') }}
    </button>
</div>

{{ form_end(form) }}
