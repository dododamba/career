<form method="post" action="{{ path('app_presence_delete', {'id': presence.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet enregistrement de présence ?');" class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ presence.id) }}">
    <button class="btn btn-sm btn-light-danger">
        <i class="ki-duotone ki-trash fs-5 me-1">
            <span class="path1"></span>
            <span class="path2"></span>
            <span class="path3"></span>
            <span class="path4"></span>
            <span class="path5"></span>
        </i>
        Supprimer
    </button>
</form>
