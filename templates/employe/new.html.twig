{% extends 'base.html.twig' %}

{% block title %}Ajouter un nouvel agent{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
{% endblock %}

{% block body %}
<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1">
                <i class="fas fa-user-plus text-primary me-2"></i>
                Ajouter un nouvel agent
            </h2>
            <p class="text-muted mb-0">
                Création d'un profil agent dans l'institution <strong>{{ institution ? institution.nom : 'courante' }}</strong>.
            </p>
        </div>
        <div>
            <a href="{{ path('app_employe_index') }}" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Retour à la liste
            </a>
        </div>
    </div>

    {{ include('employe/_form.html.twig', {'button_label': 'Créer l\'agent'}) }}
</div>
{% endblock %}