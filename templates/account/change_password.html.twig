{% extends 'base.html.twig' %}

{% block title %}Modifier mon Mot de Passe{% endblock %}

{% block body %}
<div class="d-flex flex-column gap-6">

    <!-- Header & Action Toolbar -->
    <div class="card card-mci border-0 shadow-sm">
        <div class="card-body py-5 px-6">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge badge-light-primary fw-bold text-uppercase px-3 py-2">
                            <i class="ki-outline ki-shield-tick fs-7 me-1 text-primary"></i> Sécurité du Compte
                        </span>
                    </div>
                    <h1 class="text-gray-900 fw-bolder fs-2 mb-1">Modifier mon Mot de Passe</h1>
                    <p class="text-gray-600 fs-7 mb-0">Définissez une nouvelle phrase secrète conforme aux politiques de sécurité de l'État.</p>
                </div>
                <div>
                    <a href="{{ path('app_account_security') }}" class="btn btn-sm btn-light">
                        <i class="ki-outline ki-arrow-left fs-6 me-1"></i> Paramètres de sécurité
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Formulaire -->
    <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-6">
            <div class="card card-mci border-0 shadow-sm">
                <div class="card-header border-0 pt-6">
                    <div class="card-title">
                        <i class="ki-outline ki-lock fs-3 text-primary me-2"></i>
                        <span class="fw-bolder fs-5 text-gray-900">Renouvellement des Accès</span>
                    </div>
                </div>
                <div class="card-body pt-0">
                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ label == 'error' or label == 'danger' ? 'danger' : (label == 'success' ? 'success' : 'info') }} mb-4">
                                {{ message }}
                            </div>
                        {% endfor %}
                    {% endfor %}

                    {{ form_start(form, {'attr': {'class': 'form d-flex flex-column gap-5'}}) }}
                        {{ form_errors(form) }}

                        <div class="fv-row">
                            {{ form_label(form.currentPassword, 'Mot de passe actuel', {'label_attr': {'class': 'required fs-7 fw-bold mb-2 text-gray-700'}}) }}
                            {{ form_widget(form.currentPassword, {'attr': {'class': 'form-control form-control-solid', 'placeholder': '••••••••••••'}}) }}
                            {{ form_errors(form.currentPassword) }}
                        </div>

                        <div class="fv-row">
                            {{ form_label(form.newPassword.first, 'Nouveau mot de passe', {'label_attr': {'class': 'required fs-7 fw-bold mb-2 text-gray-700'}}) }}
                            {{ form_widget(form.newPassword.first, {'attr': {'class': 'form-control form-control-solid', 'placeholder': 'Au moins 8 caractères'}}) }}
                            {{ form_errors(form.newPassword.first) }}
                            <div class="text-muted fs-8 mt-1">Le mot de passe doit comporter au moins 8 caractères.</div>
                        </div>

                        <div class="fv-row">
                            {{ form_label(form.newPassword.second, 'Confirmez le nouveau mot de passe', {'label_attr': {'class': 'required fs-7 fw-bold mb-2 text-gray-700'}}) }}
                            {{ form_widget(form.newPassword.second, {'attr': {'class': 'form-control form-control-solid', 'placeholder': '••••••••••••'}}) }}
                            {{ form_errors(form.newPassword.second) }}
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-4 border-top">
                            <a href="{{ path('app_account_security') }}" class="btn btn-light">
                                Annuler
                            </a>
                            <button type="submit" class="btn btn-mci-primary">
                                <i class="ki-outline ki-check fs-6 me-1"></i> Enregistrer les modifications
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
