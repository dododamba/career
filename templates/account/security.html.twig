{% extends 'base.html.twig' %}

{% block title %}Sécurité de mon Compte{% endblock %}

{% block body %}
<div class="d-flex flex-column gap-6">

    <!-- Header & Breadcrumbs -->
    <div class="card card-mci border-0 shadow-sm">
        <div class="card-body py-5 px-6">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge badge-light-primary fw-bold text-uppercase px-3 py-2">
                            <i class="ki-outline ki-shield-tick fs-7 me-1 text-primary"></i> Protection du Compte
                        </span>
                    </div>
                    <h1 class="text-gray-900 fw-bolder fs-2 mb-1">Sécurité & Authentification</h1>
                    <p class="text-gray-600 fs-7 mb-0">Paramètres de protection, réinitialisation de mot de passe et double facteur d'authentification (2FA).</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Flash messages handled by layout or display here if needed -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' or label == 'danger' ? 'danger' : (label == 'success' ? 'success' : 'info') }} d-flex align-items-center p-4">
                <i class="ki-outline ki-information-5 fs-2x me-3 text-{{ label == 'error' or label == 'danger' ? 'danger' : (label == 'success' ? 'success' : 'info') }}"></i>
                <div class="d-flex flex-column">
                    <span>{{ message }}</span>
                </div>
            </div>
        {% endfor %}
    {% endfor %}

    <!-- Security Options Cards -->
    <div class="row g-6">
        <!-- Mot de passe -->
        <div class="col-md-6">
            <div class="card card-mci border-0 shadow-sm h-100">
                <div class="card-header border-0 pt-6">
                    <div class="card-title d-flex align-items-center gap-2">
                        <div class="symbol symbol-35px symbol-circle bg-light-primary">
                            <span class="symbol-label text-primary">
                                <i class="ki-outline ki-lock fs-4 text-primary"></i>
                            </span>
                        </div>
                        <span class="fw-bolder fs-5 text-gray-900">Mot de Passe</span>
                    </div>
                </div>
                <div class="card-body pt-0">
                    <p class="text-gray-600 fs-7 mb-4">
                        Pour garantir la sécurité de vos données administratives, veillez à utiliser une phrase secrète complexe combinant majuscules, chiffres et caractères spéciaux.
                    </p>
                    <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded mb-5">
                        <span class="text-gray-500 fs-7">Dernier renouvellement</span>
                        <span class="text-gray-800 fw-bold fs-7">
                            {% if user.passwordChangedAt %}
                                {{ user.passwordChangedAt|date('d/m/Y à H:i') }}
                            {% else %}
                                Non renseigné
                            {% endif %}
                        </span>
                    </div>
                    <div>
                        <a href="{{ path('app_change_password') }}" class="btn btn-sm btn-mci-primary">
                            <i class="ki-outline ki-key fs-6 me-1"></i> Modifier le mot de passe
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- MFA / 2FA -->
        <div class="col-md-6">
            <div class="card card-mci border-0 shadow-sm h-100">
                <div class="card-header border-0 pt-6">
                    <div class="card-title d-flex align-items-center gap-2">
                        <div class="symbol symbol-35px symbol-circle bg-light-success">
                            <span class="symbol-label text-success">
                                <i class="ki-outline ki-phone fs-4 text-success"></i>
                            </span>
                        </div>
                        <span class="fw-bolder fs-5 text-gray-900">Authentification à Deux Facteurs (2FA)</span>
                    </div>
                    <div class="card-toolbar">
                        {% if user.isTotpAuthenticationEnabled %}
                            <span class="badge badge-light-success fw-bold fs-8">Activée</span>
                        {% else %}
                            <span class="badge badge-light-warning fw-bold fs-8">Désactivée</span>
                        {% endif %}
                    </div>
                </div>
                <div class="card-body pt-0">
                    <p class="text-gray-600 fs-7 mb-4">
                        L'authentification renforcée exige la saisie d'un code unique à 6 chiffres généré par votre application mobile (Google Authenticator, Microsoft Authenticator) à chaque connexion.
                    </p>

                    {% if user.isTotpAuthenticationEnabled %}
                        <div class="alert alert-light-success d-flex align-items-center p-3 mb-4 rounded">
                            <i class="ki-outline ki-shield-tick fs-3 text-success me-2"></i>
                            <span class="fs-7 text-gray-800 fw-semibold">Votre compte bénéficie de la protection renforcée 2FA.</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-light-danger" data-bs-toggle="modal" data-bs-target="#disableMfaModal" data-toggle="modal" data-target="#disableMfaModal">
                            <i class="ki-outline ki-cross-circle fs-6 me-1"></i> Désactiver la 2FA
                        </button>

                        <!-- Modal désactivation 2FA -->
                        <div class="modal fade" id="disableMfaModal" tabindex="-1" aria-hidden="true" role="dialog">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <form action="{{ path('app_2fa_disable') }}" method="post">
                                        <div class="modal-header">
                                            <h5 class="modal-title fw-bolder">Désactiver l'authentification à deux facteurs</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="alert alert-light-danger d-flex align-items-center p-3 mb-4">
                                                <i class="ki-outline ki-warning fs-3 text-danger me-2"></i>
                                                <span class="fs-7 text-gray-800">Attention : la désactivation réduira considérablement la protection de votre compte ministériel.</span>
                                            </div>
                                            <div class="mb-3">
                                                <label for="current_password" class="form-label fs-7 fw-bold text-gray-700">Veuillez saisir votre mot de passe pour confirmer :</label>
                                                <input type="password" name="current_password" id="current_password" class="form-control form-control-solid" required autocomplete="current-password">
                                            </div>
                                            <input type="hidden" name="_token" value="{{ csrf_token('disable_2fa') }}">
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal" data-dismiss="modal">Annuler</button>
                                            <button type="submit" class="btn btn-danger btn-sm">Confirmer la désactivation</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <a href="{{ path('app_2fa_setup') }}" class="btn btn-sm btn-mci-primary">
                            <i class="ki-outline ki-shield-tick fs-6 me-1"></i> Configurer et activer la 2FA
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Journal d'Audit de Sécurité -->
    <div class="card card-mci border-0 shadow-sm">
        <div class="card-header border-0 pt-6">
            <div class="card-title d-flex align-items-center gap-2">
                <i class="ki-outline ki-security-user fs-3 text-primary"></i>
                <span class="fw-bolder fs-5 text-gray-900">Journal d'Activité Récente de Sécurité</span>
            </div>
        </div>
        <div class="card-body pt-0">
            {% if recentEvents is empty %}
                <div class="text-center py-5 text-muted fs-7">
                    <i class="ki-outline ki-shield-tick fs-2 text-muted mb-2 d-block"></i>
                    Aucun événement de sécurité récent enregistré pour votre compte.
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table align-middle table-row-dashed fs-7 gy-3">
                        <thead>
                            <tr class="text-start text-gray-400 fw-bolder fs-8 text-uppercase gs-0">
                                <th class="min-w-140px">Horodatage</th>
                                <th class="min-w-150px">Événement</th>
                                <th class="min-w-200px">Détails</th>
                                <th class="min-w-120px text-end">Adresse IP</th>
                            </tr>
                        </thead>
                        <tbody class="fw-semibold text-gray-600">
                            {% for event in recentEvents %}
                                <tr>
                                    <td>
                                        <span class="text-gray-800 fw-bold fs-8">{{ event.createdAt|date('d/m/Y H:i:s') }}</span>
                                    </td>
                                    <td>
                                        <span class="badge badge-light-primary font-monospace fs-8">
                                            {{ event.eventLabel }}
                                        </span>
                                    </td>
                                    <td>
                                        <span class="text-gray-700 fs-8">{{ event.description ?: '-' }}</span>
                                    </td>
                                    <td class="text-end font-monospace text-muted fs-8">
                                        {{ event.ipAddress ?: '-' }}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
