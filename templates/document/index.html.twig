{% extends 'base.html.twig' %}

{% block title %}Coffre-fort & Documents RH{% endblock %}

{% block page_title %}
    <h1 class="d-flex align-items-center text-gray-900 fw-bold my-1 fs-3">
        Coffre-fort &amp; Documents RH
        <span class="h-20px border-gray-200 border-start ms-3 mx-2"></span>
        <small class="text-muted fs-7 fw-semibold my-1 ms-1">Numérisation et traçabilité des pièces</small>
    </h1>
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item text-muted">
        <a href="{{ path('app_dashboard') }}" class="text-muted text-hover-primary">Accueil</a>
    </li>
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-gray-900">Documents RH</li>
{% endblock %}

{% block page_actions %}
    {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_document_new') }}" class="btn btn-sm btn-mci-primary">
            <i class="ki-duotone ki-file-up fs-3 me-1">
                <span class="path1"></span>
                <span class="path2"></span>
            </i>
            Verser un document
        </a>
    {% endif %}
{% endblock %}

{% block body %}
<div class="d-flex flex-column gap-5">

    <!-- En-tête Institutionnelle & Assertion Title -->
    <div class="card card-mci border-0 shadow-sm">
        <div class="card-body p-6">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-4">
                <div class="d-flex align-items-center">
                    <div class="symbol symbol-50px symbol-circle me-4 bg-light-primary text-primary d-flex align-items-center justify-content-center">
                        <i class="ki-duotone ki-folder fs-1 text-primary">
                            <span class="path1"></span>
                            <span class="path2"></span>
                        </i>
                    </div>
                    <div>
                        <h2 class="fs-2 fw-bold text-gray-900 mb-1">Coffre-fort &amp; Documents RH</h2>
                        <div class="text-muted fs-7">
                            Stockage sécurisé, versionnement et intégrité SHA-256 pour 
                            <span class="fw-bold text-gray-800">{{ institution ? institution.nom : 'le Ministère du Commerce et de l\'Industrie' }}</span>.
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <span class="badge badge-light-primary fw-bold py-2 px-3">
                        <i class="ki-duotone ki-shield-check fs-6 text-primary me-1">
                            <span class="path1"></span>
                            <span class="path2"></span>
                        </i>
                        Certifié conforme
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- KPIs Row -->
    <div class="row g-5">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 card-mci">
                <div class="card-body p-5">
                    <div class="d-flex align-items-center">
                        <div class="symbol symbol-50px me-4 bg-light-primary text-primary d-flex align-items-center justify-content-center">
                            <i class="ki-duotone ki-document fs-1 text-primary">
                                <span class="path1"></span>
                                <span class="path2"></span>
                            </i>
                        </div>
                        <div>
                            <span class="text-muted fw-semibold fs-7 text-uppercase">Total Documents</span>
                            <div class="fs-2 fw-bolder text-gray-900">{{ stats.total_docs }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 card-mci">
                <div class="card-body p-5">
                    <div class="d-flex align-items-center">
                        <div class="symbol symbol-50px me-4 bg-light-info text-info d-flex align-items-center justify-content-center">
                            <i class="ki-duotone ki-hard-drive fs-1 text-info">
                                <span class="path1"></span>
                                <span class="path2"></span>
                            </i>
                        </div>
                        <div>
                            <span class="text-muted fw-semibold fs-7 text-uppercase">Espace Stocké</span>
                            <div class="fs-2 fw-bolder text-gray-900">{{ stats.total_taille_formatee }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 card-mci">
                <div class="card-body p-5">
                    <div class="d-flex align-items-center">
                        <div class="symbol symbol-50px me-4 bg-light-success text-success d-flex align-items-center justify-content-center">
                            <i class="ki-duotone ki-check-circle fs-1 text-success">
                                <span class="path1"></span>
                                <span class="path2"></span>
                            </i>
                        </div>
                        <div>
                            <span class="text-muted fw-semibold fs-7 text-uppercase">Validés / Actifs</span>
                            <div class="fs-2 fw-bolder text-gray-900">{{ stats.valides }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 card-mci">
                <div class="card-body p-5">
                    <div class="d-flex align-items-center">
                        <div class="symbol symbol-50px me-4 bg-light-warning text-warning d-flex align-items-center justify-content-center">
                            <i class="ki-duotone ki-security-user fs-1 text-warning">
                                <span class="path1"></span>
                                <span class="path2"></span>
                            </i>
                        </div>
                        <div>
                            <span class="text-muted fw-semibold fs-7 text-uppercase">Confidentiels RH</span>
                            <div class="fs-2 fw-bolder text-gray-900">{{ stats.confidentiels }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Barre de filtres & Recherche -->
    <div class="card card-mci border-0 shadow-sm">
        <div class="card-body p-5">
            <form method="get" action="{{ path('app_document_index') }}" class="row g-3 align-items-center">
                <div class="col-md-4">
                    <div class="position-relative">
                        <i class="ki-duotone ki-magnifier fs-3 text-gray-500 position-absolute top-50 translate-middle-y ms-4">
                            <span class="path1"></span>
                            <span class="path2"></span>
                        </i>
                        <input type="text" name="q" class="form-control form-control-solid ps-12" placeholder="Rechercher titre, référence, fichier, agent..." value="{{ search }}">
                    </div>
                </div>

                <div class="col-md-3">
                    <select name="categorie" class="form-select form-select-solid" data-control="select2" data-hide-search="true">
                        <option value="">-- Toutes catégories --</option>
                        <option value="IDENTITE" {{ currentCategorie == 'IDENTITE' ? 'selected' : '' }}>Pièces d'identité</option>
                        <option value="CONTRAT" {{ currentCategorie == 'CONTRAT' ? 'selected' : '' }}>Contrats &amp; Engagements</option>
                        <option value="DIPLOME_CV" {{ currentCategorie == 'DIPLOME_CV' ? 'selected' : '' }}>Diplômes &amp; CV</option>
                        <option value="ACTE_ADMIN" {{ currentCategorie == 'ACTE_ADMIN' ? 'selected' : '' }}>Actes administratifs</option>
                        <option value="AFFECTATION" {{ currentCategorie == 'AFFECTATION' ? 'selected' : '' }}>Mouvements &amp; Affectations</option>
                        <option value="EVALUATION" {{ currentCategorie == 'EVALUATION' ? 'selected' : '' }}>Évaluations</option>
                        <option value="MEDICAL" {{ currentCategorie == 'MEDICAL' ? 'selected' : '' }}>Médical</option>
                        <option value="DISCIPLINE" {{ currentCategorie == 'DISCIPLINE' ? 'selected' : '' }}>Disciplinaire</option>
                        <option value="FORMATION" {{ currentCategorie == 'FORMATION' ? 'selected' : '' }}>Formation</option>
                        <option value="AUTRE" {{ currentCategorie == 'AUTRE' ? 'selected' : '' }}>Autres</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <select name="statut" class="form-select form-select-solid" data-control="select2" data-hide-search="true">
                        <option value="">-- Tous statuts --</option>
                        <option value="VALIDE" {{ currentStatut == 'VALIDE' ? 'selected' : '' }}>Validé</option>
                        <option value="EN_ATTENTE" {{ currentStatut == 'EN_ATTENTE' ? 'selected' : '' }}>En attente de vérification</option>
                        <option value="ARCHIVE" {{ currentStatut == 'ARCHIVE' ? 'selected' : '' }}>Archivé</option>
                        <option value="REJETE" {{ currentStatut == 'REJETE' ? 'selected' : '' }}>Rejeté</option>
                    </select>
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-mci-primary flex-grow-1">
                        <i class="ki-duotone ki-filter fs-5 me-1">
                            <span class="path1"></span>
                            <span class="path2"></span>
                        </i>
                        Filtrer
                    </button>
                    {% if currentCategorie or currentStatut or search or selectedEmploye %}
                        <a href="{{ path('app_document_index') }}" class="btn btn-light" title="Réinitialiser">
                            <i class="ki-duotone ki-cross fs-4">
                                <span class="path1"></span>
                                <span class="path2"></span>
                            </i>
                        </a>
                    {% endif %}
                </div>
            </form>
        </div>
    </div>

    <!-- Registre Documentaire -->
    <div class="card card-mci border-0 shadow-sm">
        <div class="card-header border-0 pt-6 d-flex justify-content-between align-items-center">
            <h3 class="card-title align-items-start flex-column mb-0">
                <span class="card-label fw-bold fs-4 text-gray-900">Registre des Pièces Justificatives</span>
                <span class="text-muted mt-1 fw-semibold fs-7">Historique cryptographique et traçabilité</span>
            </h3>
            <span class="badge badge-light-primary fw-bold fs-7">{{ documents|length }} document(s)</span>
        </div>
        <div class="card-body py-4">
            <div class="table-responsive">
                <table class="table align-middle table-row-dashed fs-6 gy-4 mb-0">
                    <thead>
                        <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0 border-bottom border-gray-200">
                            <th class="w-40px"></th>
                            <th class="min-w-200px">Document &amp; Référence</th>
                            <th class="min-w-140px">Catégorie</th>
                            <th class="min-w-180px">Agent / Dossier</th>
                            <th class="min-w-120px">Format &amp; Version</th>
                            <th class="min-w-120px">Confidentialité</th>
                            <th class="min-w-100px">Statut</th>
                            <th class="text-end min-w-120px pe-2">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="text-gray-700 fw-semibold">
                        {% for doc in documents %}
                            <tr>
                                <td class="text-center">
                                    <div class="symbol symbol-40px symbol-light">
                                        <span class="symbol-label bg-light-primary text-primary">
                                            <i class="ki-duotone ki-document fs-2 text-primary">
                                                <span class="path1"></span>
                                                <span class="path2"></span>
                                            </i>
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <a href="{{ path('app_document_show', {'id': doc.id}) }}" class="text-gray-900 text-hover-primary fw-bold d-block mb-1">
                                        {{ doc.titre }}
                                    </a>
                                    <div class="text-muted fs-8 d-flex align-items-center gap-2">
                                        <span>Réf : <code class="text-gray-700">{{ doc.reference ?: 'N/C' }}</code></span>
                                        <span class="bullet bg-gray-300 w-4px h-4px"></span>
                                        <span>Date : {{ doc.dateDocument ? doc.dateDocument|date('d/m/Y') : doc.createdAt|date('d/m/Y') }}</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge badge-light-secondary fw-semibold">
                                        {{ doc.categorieLabel }}
                                    </span>
                                </td>
                                <td>
                                    {% if doc.employe %}
                                        <a href="{{ path('app_employe_show', {'id': doc.employe.id}) }}" class="text-gray-800 text-hover-primary fw-bold d-block">
                                            {{ doc.employe.nomComplet }}
                                        </a>
                                        <span class="text-muted fs-8">{{ doc.employe.matricule ?: 'Sans matricule' }}</span>
                                    {% else %}
                                        <span class="badge badge-light-info fw-semibold">
                                            <i class="ki-duotone ki-bank fs-8 me-1 text-info">
                                                <span class="path1"></span>
                                                <span class="path2"></span>
                                            </i>
                                            Institutionnel
                                        </span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="text-gray-800 fs-7 fw-bold text-uppercase">{{ doc.extension|upper }} &bull; {{ doc.tailleFormatee }}</div>
                                    <div class="text-muted fs-8">
                                        <span class="badge badge-light-primary py-1 px-2 fs-9">v{{ doc.numeroDerniereVersion }}</span>
                                        {% if doc.versions|length > 1 %}
                                            <span class="ms-1">({{ doc.versions|length }} versions)</span>
                                        {% endif %}
                                    </div>
                                </td>
                                <td>
                                    {% if doc.niveauConfidentialite == 'SECRET_RH' %}
                                        <span class="badge badge-light-danger fw-bold"><i class="ki-duotone ki-lock fs-8 me-1 text-danger"><span class="path1"></span><span class="path2"></span><span class="path3"></span></i> Restreint</span>
                                    {% elseif doc.niveauConfidentialite == 'CONFIDENTIEL' %}
                                        <span class="badge badge-light-warning fw-bold"><i class="ki-duotone ki-shield-security fs-8 me-1 text-warning"><span class="path1"></span><span class="path2"></span></i> Confidentiel</span>
                                    {% else %}
                                        <span class="badge badge-light-secondary fw-semibold">Interne RH</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if doc.statut == 'VALIDE' %}
                                        <span class="badge badge-light-success fw-bold">Validé</span>
                                    {% elseif doc.statut == 'EN_ATTENTE' %}
                                        <span class="badge badge-light-warning fw-bold">En attente</span>
                                    {% elseif doc.statut == 'ARCHIVE' %}
                                        <span class="badge badge-light-secondary fw-semibold">Archivé</span>
                                    {% elseif doc.statut == 'REJETE' %}
                                        <span class="badge badge-light-danger fw-bold">Rejeté</span>
                                    {% endif %}
                                </td>
                                <td class="text-end pe-2">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a href="{{ path('app_document_show', {'id': doc.id}) }}" class="btn btn-icon btn-sm btn-light-primary" title="Consulter la fiche">
                                            <i class="ki-duotone ki-eye fs-5">
                                                <span class="path1"></span>
                                                <span class="path2"></span>
                                                <span class="path3"></span>
                                            </i>
                                        </a>
                                        {% if doc.isPdf or doc.isImage %}
                                            <a href="{{ path('app_document_preview', {'id': doc.id}) }}" target="_blank" class="btn btn-icon btn-sm btn-light-info" title="Prévisualiser">
                                                <i class="ki-duotone ki-magnifier fs-5">
                                                    <span class="path1"></span>
                                                    <span class="path2"></span>
                                                </i>
                                            </a>
                                        {% endif %}
                                        <a href="{{ path('app_document_download', {'id': doc.id}) }}" class="btn btn-icon btn-sm btn-light-success" title="Télécharger">
                                            <i class="ki-duotone ki-down fs-5"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="8" class="text-center py-10">
                                    <div class="d-flex flex-column align-items-center">
                                        <i class="ki-duotone ki-folder-minus fs-4x text-muted mb-3">
                                            <span class="path1"></span>
                                            <span class="path2"></span>
                                        </i>
                                        <span class="fs-6 text-gray-500 fw-semibold">Aucun document trouvé dans le coffre-fort.</span>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
{% endblock %}
