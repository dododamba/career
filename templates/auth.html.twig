<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
        <title>{% block title %}Connexion{% endblock %} | {{ app_name }}</title>
        {% include 'layouts/partials/_meta.html.twig' %}

        <!--begin::Fonts Preconnect-->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <!--end::Fonts Preconnect-->

        <!--begin::Fonts-->
        <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700" />
        <!--end::Fonts-->

        <!--begin::Global Stylesheets Bundle(used by all pages)-->
        <link href="{{ asset('assets/plugins/global/plugins.bundle.css') }}" rel="stylesheet" type="text/css" />
        <link href="{{ asset('assets/css/style.bundle.css') }}" rel="stylesheet" type="text/css" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
        <!--end::Global Stylesheets Bundle-->

        <style>
            :root {
                --sc-primary: #002664;
                --sc-primary-dark: #001844;
                --sc-gold: #FECB00;
                --sc-red: #C60C30;
                --sc-bg: #F8FAFC;
                --sc-surface: #FFFFFF;
                --sc-border: rgba(15, 23, 42, 0.07);
                --sc-text: #0F172A;
                --sc-muted: #64748B;
            }

            body, html {
                height: 100%;
                margin: 0;
                font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                background-color: var(--sc-bg);
                color: var(--sc-text);
            }

            .auth-layout-root {
                min-height: 100vh;
                min-height: 100dvh;
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                padding: 1.5rem 1rem;
                position: relative;
                background: 
                    radial-gradient(circle at 50% 10%, rgba(0, 38, 100, 0.04) 0%, transparent 60%),
                    radial-gradient(circle at 90% 90%, rgba(254, 203, 0, 0.02) 0%, transparent 50%),
                    var(--sc-bg);
            }

            .auth-card-wrapper {
                width: 100%;
                max-width: 480px;
                margin: 0 auto;
            }

            .auth-card {
                background: var(--sc-surface);
                border-radius: 14px;
                border: 1px solid var(--sc-border);
                box-shadow: 0 12px 32px -4px rgba(0, 38, 100, 0.06), 0 2px 6px -1px rgba(0, 0, 0, 0.02);
                padding: 2.25rem 2rem;
                position: relative;
                overflow: hidden;
            }

            @media (max-width: 575.98px) {
                .auth-card {
                    padding: 1.75rem 1.25rem;
                }
            }

            .auth-form-control {
                background-color: var(--sc-bg);
                border: 1.5px solid var(--sc-border);
                border-radius: 6px;
                height: 50px;
                font-size: 0.95rem;
                color: var(--sc-text);
                font-weight: 500;
                transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            }

            .auth-form-control:focus {
                background-color: var(--sc-surface);
                border-color: var(--sc-primary);
                box-shadow: 0 0 0 4px rgba(0, 38, 100, 0.1);
                color: var(--sc-text);
                outline: none;
            }

            .auth-submit-btn {
                height: 50px;
                background: linear-gradient(180deg, var(--sc-primary) 0%, var(--sc-primary-dark) 100%) !important;
                border: 1px solid var(--sc-primary-dark) !important;
                color: #FFFFFF !important;
                border-radius: 6px;
                font-weight: 700;
                font-size: 0.95rem;
                letter-spacing: 0.01em;
                display: flex;
                align-items: center;
                justify-content: center;
                box-shadow: 0 4px 14px rgba(0, 38, 100, 0.2);
                transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
                cursor: pointer;
                width: 100%;
            }

            .auth-submit-btn:hover {
                background: linear-gradient(180deg, #003a99 0%, var(--sc-primary) 100%) !important;
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(0, 38, 100, 0.28);
                color: #FFFFFF !important;
            }

            .auth-submit-btn:active {
                transform: translateY(0);
                box-shadow: 0 2px 8px rgba(0, 38, 100, 0.2);
            }

            .auth-security-notice {
                background-color: var(--sc-bg);
                border: 1px solid var(--sc-border);
                border-radius: 6px;
                padding: 0.75rem 1rem;
                font-size: 0.85rem;
                color: var(--sc-muted);
                line-height: 1.45;
            }
        </style>

        {% block stylesheets %}{% endblock %}

        {{ importmap('app') }}
    </head>

    <body id="kt_body">
        <div class="auth-layout-root">
            <div class="auth-card-wrapper">
                <div class="auth-card">
                    {% include 'layouts/partials/_flashes.html.twig' %}

                    {% if error is defined and error %}
                        <div class="alert alert-danger d-flex align-items-center p-4 mb-5 border-0 rounded-3 shadow-xs" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-4 text-danger me-3 flex-shrink-0"></i>
                            <div class="fs-7 fw-semibold text-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                        </div>
                    {% endif %}

                    {% block body %}{% endblock %}
                </div>

                <footer class="text-center mt-5">
                    <p class="text-muted fs-8 mb-0">
                        &copy; {{ "now"|date("Y") }} {{ app_institution }} &bull; {{ app_country }}
                    </p>
                </footer>
            </div>
        </div>

        <!--begin::Javascript-->
        <script src="{{ asset('assets/plugins/global/plugins.bundle.js') }}"></script>
        <script src="{{ asset('assets/js/scripts.bundle.js') }}"></script>
        {% block javascripts %}{% endblock %}
        <!--end::Javascript-->
    </body>
</html>
