<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <title>{% block title %}Connexion{% endblock %} | {{ app_name }}</title>
        {% include 'layouts/partials/_meta.html.twig' %}

        <!--begin::Fonts-->
        <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700" />
        <!--end::Fonts-->

        <!--begin::Global Stylesheets Bundle(used by all pages)-->
        <link href="{{ asset('assets/plugins/global/plugins.bundle.css') }}" rel="stylesheet" type="text/css" />
        <link href="{{ asset('assets/css/style.bundle.css') }}" rel="stylesheet" type="text/css" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
        <!--end::Global Stylesheets Bundle-->

        {% block stylesheets %}{% endblock %}

        {{ importmap('app') }}
    </head>

    <body id="kt_body" class="auth-bg-light">
        <div class="auth-page-wrapper">
            <!-- Fin liseré tricolore institutionnel (République du Tchad) -->
            <div class="institutional-stripe" aria-hidden="true"></div>

            <div class="auth-container">
                <!--begin::En-tête institutionnel-->
                <header class="auth-header text-center">
                    <a href="{{ path('app_login') }}" class="d-inline-flex flex-column align-items-center text-decoration-none" title="{{ app_institution }} — {{ app_country }}">
                        <div class="auth-brand-badge">
                            <span class="auth-flag-dot" aria-hidden="true"></span>
                            <span>{{ app_institution }} &bull; {{ app_country }}</span>
                        </div>
                    </a>
                </header>
                <!--end::En-tête institutionnel-->

                <!--begin::Carte de connexion / formulaire-->
                <main class="auth-card-container">
                    <div class="auth-card">
                        {% include 'layouts/partials/_flashes.html.twig' %}

                        {% if error is defined and error %}
                            <div class="alert alert-danger d-flex align-items-center p-4 mb-5 border-0 shadow-xs" role="alert">
                                <i class="bi bi-exclamation-triangle-fill fs-4 text-danger me-3 flex-shrink-0"></i>
                                <div class="fs-7 fw-semibold text-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                            </div>
                        {% endif %}

                        {% block body %}{% endblock %}
                    </div>
                </main>
                <!--end::Carte de connexion-->

                <!--begin::Pied de page-->
                <footer class="auth-footer text-center mt-6">
                    <p class="text-muted fs-8 mb-0">
                        &copy; {{ "now"|date("Y") }} {{ app_institution }} &bull; {{ app_country }}
                    </p>
                </footer>
                <!--end::Pied de page-->
            </div>
        </div>

        <!--begin::Javascript-->
        <script src="{{ asset('assets/plugins/global/plugins.bundle.js') }}"></script>
        <script src="{{ asset('assets/js/scripts.bundle.js') }}"></script>
        {% block javascripts %}{% endblock %}
        <!--end::Javascript-->
    </body>
</html>
