<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
        <title>{% block title %}Connexion{% endblock %} | {{ app_name }}</title>
        {% include 'layouts/partials/_meta.html.twig' %}

        <!--begin::Fonts-->
        <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700" />
        <!--end::Fonts-->

        <!--begin::Global Stylesheets Bundle(used by all pages)-->
        <link href="{{ asset('assets/plugins/global/plugins.bundle.css') }}" rel="stylesheet" type="text/css" />
        <link href="{{ asset('assets/css/style.bundle.css') }}" rel="stylesheet" type="text/css" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
        <!--end::Global Stylesheets Bundle-->

        <style>
            :root {
                --sc-primary: #002664;
                --sc-gold: #FECB00;
                --sc-red: #C60C30;
                --sc-bg: #F5F8FA;
            }

            body, html {
                height: 100%;
                margin: 0;
                font-family: 'Poppins', sans-serif;
                background-color: var(--sc-bg);
            }

            .auth-layout-root {
                min-height: 100vh;
                min-height: 100dvh;
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                padding: 1.5rem 1rem;
                position: relative;
                background: 
                    radial-gradient(circle at 50% 10%, rgba(0, 38, 100, 0.05) 0%, transparent 60%),
                    radial-gradient(circle at 90% 90%, rgba(254, 203, 0, 0.03) 0%, transparent 50%),
                    var(--sc-bg);
            }

            /* Liseré tricolore en haut d'écran */
            .institutional-stripe-top {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
                background: linear-gradient(90deg, #002664 0%, #002664 33.33%, #FECB00 33.33%, #FECB00 66.66%, #C60C30 66.66%, #C60C30 100%);
                z-index: 1050;
            }

            .auth-card-wrapper {
                width: 100%;
                max-width: 480px;
                margin: 0 auto;
            }

            .auth-card {
                background: #FFFFFF;
                border-radius: 16px;
                border: 1px solid #E4E6EF;
                box-shadow: 0 10px 30px rgba(0, 38, 100, 0.08), 0 2px 6px rgba(0, 0, 0, 0.02);
                padding: 2.25rem 2rem;
                position: relative;
                overflow: hidden;
            }

            @media (max-width: 575.98px) {
                .auth-card {
                    padding: 1.75rem 1.25rem;
                }
            }

            .auth-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
                background: linear-gradient(90deg, #002664, #FECB00);
            }

            .auth-institution-pill {
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                background-color: #F8F9FA;
                border: 1px solid #E4E6EF;
                color: #002664;
                font-weight: 700;
                font-size: 0.775rem;
                text-transform: uppercase;
                letter-spacing: 0.04em;
                padding: 0.4rem 0.95rem;
                border-radius: 999px;
                margin-bottom: 1.25rem;
            }

            .auth-dot-gold {
                width: 7px;
                height: 7px;
                background-color: #FECB00;
                border-radius: 50%;
                box-shadow: 0 0 0 2px rgba(254, 203, 0, 0.3);
                display: inline-block;
            }

            .auth-form-control {
                background-color: #F5F8FA;
                border: 1.5px solid #E4E6EF;
                border-radius: 10px;
                height: 50px;
                font-size: 0.95rem;
                color: #181C32;
                font-weight: 500;
                transition: all 0.2s ease-in-out;
            }

            .auth-form-control:focus {
                background-color: #FFFFFF;
                border-color: #002664;
                box-shadow: 0 0 0 4px rgba(0, 38, 100, 0.1);
                color: #181C32;
                outline: none;
            }

            .auth-submit-btn {
                height: 50px;
                background: linear-gradient(180deg, #002b70 0%, #001f52 100%) !important;
                border: 1px solid #001844 !important;
                color: #FFFFFF !important;
                border-radius: 10px;
                font-weight: 700;
                font-size: 1rem;
                letter-spacing: 0.01em;
                display: flex;
                align-items: center;
                justify-content: center;
                box-shadow: 0 4px 14px rgba(0, 38, 100, 0.2);
                transition: all 0.2s ease;
                cursor: pointer;
                width: 100%;
            }

            .auth-submit-btn:hover {
                background: linear-gradient(180deg, #00368c 0%, #002664 100%) !important;
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(0, 38, 100, 0.28);
                color: #FFFFFF !important;
            }

            .auth-submit-btn:active {
                transform: translateY(0);
                box-shadow: 0 2px 8px rgba(0, 38, 100, 0.2);
            }

            .auth-security-notice {
                background-color: #F8F9FA;
                border: 1px solid #E4E6EF;
                border-radius: 10px;
                padding: 0.75rem 1rem;
                font-size: 0.8rem;
                color: #5E6278;
                line-height: 1.4;
            }
        </style>

        {% block stylesheets %}{% endblock %}

        {{ importmap('app') }}
    </head>

    <body id="kt_body">
        <div class="institutional-stripe-top" aria-hidden="true"></div>

        <div class="auth-layout-root">
            <div class="auth-card-wrapper">
                <div class="auth-card">
                    {% include 'layouts/partials/_flashes.html.twig' %}

                    {% if error is defined and error %}
                        <div class="alert alert-danger d-flex align-items-center p-4 mb-5 border-0 rounded-3 shadow-xs" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-4 text-danger me-3 flex-shrink-0"></i>
                            <div class="fs-7 fw-semibold text-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                        </div>
                    {% endif %}

                    {% block body %}{% endblock %}
                </div>

                <footer class="text-center mt-5">
                    <p class="text-muted fs-8 mb-0">
                        &copy; {{ "now"|date("Y") }} {{ app_institution }} &bull; {{ app_country }}
                    </p>
                </footer>
            </div>
        </div>

        <!--begin::Javascript-->
        <script src="{{ asset('assets/plugins/global/plugins.bundle.js') }}"></script>
        <script src="{{ asset('assets/js/scripts.bundle.js') }}"></script>
        {% block javascripts %}{% endblock %}
        <!--end::Javascript-->
    </body>
</html>
