{% extends 'base.html.twig' %}

{% block title %}Modifier l'utilisateur : {{ user.fullName }} — MCI e-Circuit{% endblock %}

{% block page_title %}
    <h1 class="d-flex align-items-center text-gray-900 fw-bold my-1 fs-3">
        Mettre à jour le Compte : {{ user.fullName }}
        <span class="h-20px border-gray-200 border-start ms-3 mx-2"></span>
        <small class="text-muted fs-7 fw-semibold my-1 ms-1">Gestion des informations et autorisations</small>
    </h1>
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item text-muted">
        <a href="{{ path('app_dashboard') }}" class="text-muted text-hover-primary">Accueil</a>
    </li>
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-muted">
        <a href="{{ path('app_user_index') }}" class="text-muted text-hover-primary">Utilisateurs</a>
    </li>
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-gray-900">Édition</li>
{% endblock %}

{% block page_actions %}
    <div class="d-flex align-items-center gap-2">
        <a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn btn-sm btn-light">
            <i class="ki-duotone ki-eye fs-4 me-1"></i> Voir le profil
        </a>
        <a href="{{ path('app_user_index') }}" class="btn btn-sm btn-light">
            <i class="ki-duotone ki-arrow-left fs-4 me-1"></i> Retour à la liste
        </a>
    </div>
{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="card card-flush border-0 shadow-sm">
            <div class="card-header pt-6">
                <div class="card-title">
                    <div class="d-flex align-items-center">
                        <div class="symbol symbol-45px symbol-circle me-3 bg-light-warning text-warning d-flex align-items-center justify-content-center">
                            <i class="ki-duotone ki-pencil fs-2 text-warning">
                                <span class="path1"></span>
                                <span class="path2"></span>
                            </i>
                        </div>
                        <div>
                            <h2 class="fs-4 fw-bold text-gray-900 mb-0">Modifier le Compte Utilisateur</h2>
                            <span class="text-muted fs-7">{{ user.email }}</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body pt-5">
                {{ form_start(form, {'attr': {'class': 'form d-flex flex-column gap-6'}}) }}

                <div class="row g-5">
                    <div class="col-md-6">
                        <label class="form-label required fw-semibold fs-6 text-gray-700">Prénom</label>
                        {{ form_widget(form.firstname, {'attr': {'class': 'form-control form-control-solid'}}) }}
                        <div class="text-danger fs-7 mt-1">{{ form_errors(form.firstname) }}</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label required fw-semibold fs-6 text-gray-700">Nom de famille</label>
                        {{ form_widget(form.lastname, {'attr': {'class': 'form-control form-control-solid'}}) }}
                        <div class="text-danger fs-7 mt-1">{{ form_errors(form.lastname) }}</div>
                    </div>
                </div>

                <div>
                    <label class="form-label required fw-semibold fs-6 text-gray-700">Adresse email</label>
                    {{ form_widget(form.email, {'attr': {'class': 'form-control form-control-solid'}}) }}
                    <div class="text-danger fs-7 mt-1">{{ form_errors(form.email) }}</div>
                </div>

                {% if form.roles is defined %}
                    <div>
                        <label class="form-label fw-semibold fs-6 text-gray-700">Rôles et Habilitations</label>
                        {{ form_widget(form.roles, {'attr': {'class': 'form-select form-select-solid'}}) }}
                        <div class="text-danger fs-7 mt-1">{{ form_errors(form.roles) }}</div>
                    </div>
                {% endif %}

                {% if form.isVerified is defined %}
                    <div class="d-flex align-items-center">
                        <div class="form-check form-switch form-check-custom form-check-solid">
                            {{ form_widget(form.isVerified, {'attr': {'class': 'form-check-input h-25px w-45px'}}) }}
                            <label class="form-check-label fw-semibold text-gray-800 fs-7 ms-2" for="{{ form.isVerified.vars.id }}">
                                Compte certifié / vérifié
                            </label>
                        </div>
                    </div>
                {% endif %}

                {% if form.image is defined %}
                    <div>
                        <label class="form-label fw-semibold fs-6 text-gray-700">Photo de profil</label>
                        {{ form_widget(form.image, {'attr': {'class': 'form-control form-control-solid'}}) }}
                        <div class="text-danger fs-7 mt-1">{{ form_errors(form.image) }}</div>
                    </div>
                {% endif %}

                <div class="d-flex justify-content-between align-items-center pt-6 mt-4 border-top">
                    <a href="{{ path('app_user_index') }}" class="btn btn-light">Annuler</a>
                    <button type="submit" class="btn btn-mci-primary">
                        <i class="ki-duotone ki-check fs-4 me-1"></i> Enregistrer les modifications
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
