{% extends 'base.html.twig' %}

{% block title %}Tableau de Bord — Suivi de Présence & Assiduité{% endblock %}

{% block page_title %}
    <h1 class="d-flex align-items-center text-gray-900 fw-bold my-1 fs-3">
        <i class="bi bi-speedometer2 text-primary fs-2 me-2"></i>
        Tableau de Bord Assiduité &amp; Présences
        <span class="h-20px border-gray-200 border-start ms-3 mx-2"></span>
        <small class="text-muted fs-7 fw-semibold my-1 ms-1">Indicateurs de ponctualité et présence des effectifs</small>
    </h1>
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item text-muted">
        <a href="{{ path('app_dashboard') }}" class="text-muted text-hover-primary">
            <i class="bi bi-house-door me-1"></i>Accueil
        </a>
    </li>
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-muted">
        <a href="{{ path('app_pointage_index') }}" class="text-muted text-hover-primary">
            <i class="bi bi-clock-history me-1"></i>Pointages
        </a>
    </li>
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-gray-900">
        <i class="bi bi-speedometer2 me-1"></i>Dashboard
    </li>
{% endblock %}

{% block page_actions %}
    <div class="d-flex align-items-center gap-2">
        <a href="{{ path('app_pointage_index') }}" class="btn btn-sm btn-light">
            <i class="bi bi-journal-check fs-5 me-1 text-primary"></i> Registre journalier
        </a>
        {% if is_granted('POINTAGE_CREATE') %}
            <a href="{{ path('app_pointage_new') }}" class="btn btn-sm btn-mci-primary">
                <i class="bi bi-plus-circle fs-5 me-1"></i> Nouveau pointage
            </a>
        {% endif %}
    </div>
{% endblock %}

{% block body %}
<div class="d-flex flex-column gap-5">

    <!-- Bannière institutionnelle -->
    <div class="card card-mci border-0 shadow-sm">
        <div class="card-body p-6">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-4">
                <div class="d-flex align-items-center">
                    <div class="symbol symbol-50px symbol-circle me-4 bg-light-primary text-primary d-flex align-items-center justify-content-center">
                        <i class="bi bi-bar-chart-line-fill fs-1 text-primary"></i>
                    </div>
                    <div>
                        <h2 class="fs-2 fw-bold text-gray-900 mb-1">Baromètre d'Assiduité Institutionnelle</h2>
                        <div class="text-muted fs-7">
                            Vue synthétique des présences, absences et retards à {{ app.user.institution.nom|default(app_institution) }}.
                            Situation au <span class="fw-bold text-gray-800"><i class="bi bi-calendar3 me-1 text-primary"></i>{{ date_actuelle|date('d/m/Y') }}</span>.
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    {% set total_emp = stats.total_employes|default(0) %}
                    <span class="badge badge-light-primary fw-bold py-2 px-3 fs-7">
                        <i class="bi bi-people-fill fs-6 text-primary me-1"></i>
                        Effectif recensé : {{ total_emp }} agents
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- KPI Cards Row -->
    {% set presents_count = stats.presents|default(stats.presents_aujourdhui|default(0)) %}
    {% set conges_count = stats.conges|default(stats.conges_en_cours|default(0)) %}
    {% set absents_count = stats.absents|default(stats.absences_aujourdhui|default(0)) %}
    {% set retards_count = stats.retards|default(stats.retards_aujourdhui|default(0)) %}
    {% set tendance_pres = stats.tendance_presents|default(0) %}
    {% set tendance_abs = stats.tendance_absences|default(0) %}
    {% set tendance_ret = stats.tendance_retards|default(0) %}

    <div class="row g-5">
        <!-- Présences aujourd'hui -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 card-mci">
                <div class="card-body p-5">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="text-muted fw-semibold fs-7 text-uppercase">Présents aujourd'hui</span>
                        <div class="symbol symbol-45px bg-light-success text-success d-flex align-items-center justify-content-center">
                            <i class="bi bi-person-check-fill fs-2 text-success"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-baseline gap-2 mb-2">
                        <span class="fs-2hx fw-bolder text-gray-900 lh-1">{{ presents_count }}</span>
                        {% if tendance_pres != 0 %}
                            <span class="badge badge-light-{{ tendance_pres >= 0 ? 'success' : 'danger' }} fs-8 fw-bold">
                                {{ tendance_pres >= 0 ? '+' : '' }}{{ tendance_pres }}%
                            </span>
                        {% endif %}
                    </div>
                    {% set presence_rate = total_emp > 0 ? (presents_count / total_emp) * 100 : 0 %}
                    <div class="d-flex justify-content-between fs-8 text-muted mb-1">
                        <span>Taux d'assiduité</span>
                        <span class="fw-bold text-success">{{ presence_rate|round }}%</span>
                    </div>
                    <div class="progress h-6px bg-light-success">
                        <div class="progress-bar bg-success" role="progressbar" style="width: {{ presence_rate }}%;" aria-valuenow="{{ presence_rate }}" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Congés / Missions en cours -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 card-mci">
                <div class="card-body p-5">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="text-muted fw-semibold fs-7 text-uppercase">Congés &amp; Missions</span>
                        <div class="symbol symbol-45px bg-light-info text-info d-flex align-items-center justify-content-center">
                            <i class="bi bi-calendar2-range-fill fs-2 text-info"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-baseline gap-2 mb-2">
                        <span class="fs-2hx fw-bolder text-gray-900 lh-1">{{ conges_count }}</span>
                        <span class="text-muted fs-7">justifiés</span>
                    </div>
                    {% set conges_rate = total_emp > 0 ? (conges_count / total_emp) * 100 : 0 %}
                    <div class="d-flex justify-content-between fs-8 text-muted mb-1">
                        <span>Part des effectifs</span>
                        <span class="fw-bold text-info">{{ conges_rate|round }}%</span>
                    </div>
                    <div class="progress h-6px bg-light-info">
                        <div class="progress-bar bg-info" role="progressbar" style="width: {{ conges_rate }}%;" aria-valuenow="{{ conges_rate }}" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Absences injustifiées -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 card-mci">
                <div class="card-body p-5">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="text-muted fw-semibold fs-7 text-uppercase">Absences injustifiées</span>
                        <div class="symbol symbol-45px bg-light-danger text-danger d-flex align-items-center justify-content-center">
                            <i class="bi bi-person-x-fill fs-2 text-danger"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-baseline gap-2 mb-2">
                        <span class="fs-2hx fw-bolder text-gray-900 lh-1">{{ absents_count }}</span>
                        {% if tendance_abs != 0 %}
                            <span class="badge badge-light-{{ tendance_abs <= 0 ? 'success' : 'danger' }} fs-8 fw-bold">
                                {{ tendance_abs <= 0 ? '' : '+' }}{{ tendance_abs }}%
                            </span>
                        {% endif %}
                    </div>
                    {% set abs_rate = total_emp > 0 ? (absents_count / total_emp) * 100 : 0 %}
                    <div class="d-flex justify-content-between fs-8 text-muted mb-1">
                        <span>Ce mois : {{ stats.absences_mois|default(0) }}</span>
                        <span class="fw-bold text-danger">{{ abs_rate|round }}%</span>
                    </div>
                    <div class="progress h-6px bg-light-danger">
                        <div class="progress-bar bg-danger" role="progressbar" style="width: {{ abs_rate }}%;" aria-valuenow="{{ abs_rate }}" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Retards constatés -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 card-mci">
                <div class="card-body p-5">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="text-muted fw-semibold fs-7 text-uppercase">Retards constatés</span>
                        <div class="symbol symbol-45px bg-light-warning text-warning d-flex align-items-center justify-content-center">
                            <i class="bi bi-stopwatch-fill fs-2 text-warning"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-baseline gap-2 mb-2">
                        <span class="fs-2hx fw-bolder text-gray-900 lh-1">{{ retards_count }}</span>
                        {% if tendance_ret != 0 %}
                            <span class="badge badge-light-{{ tendance_ret <= 0 ? 'success' : 'danger' }} fs-8 fw-bold">
                                {{ tendance_ret <= 0 ? '' : '+' }}{{ tendance_ret }}%
                            </span>
                        {% endif %}
                    </div>
                    {% set ret_rate = total_emp > 0 ? (retards_count / total_emp) * 100 : 0 %}
                    <div class="d-flex justify-content-between fs-8 text-muted mb-1">
                        <span>Ce mois : {{ stats.retards_mois|default(0) }}</span>
                        <span class="fw-bold text-warning">{{ ret_rate|round }}%</span>
                    </div>
                    <div class="progress h-6px bg-light-warning">
                        <div class="progress-bar bg-warning" role="progressbar" style="width: {{ ret_rate }}%;" aria-valuenow="{{ ret_rate }}" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Graphic & Top Employees Section -->
    <div class="row g-5">
        <!-- Monthly Chart -->
        <div class="col-xl-8">
            <div class="card card-flush border-0 shadow-sm h-100">
                <div class="card-header pt-5">
                    <h3 class="card-title align-items-start flex-column">
                        <span class="card-label fw-bold fs-3 text-gray-900">
                            <i class="bi bi-graph-up-arrow text-primary me-2"></i>Évolution Mensuelle des Pointages
                        </span>
                        <span class="text-muted mt-1 fw-semibold fs-7">Historique consolidé de l'année en cours</span>
                    </h3>
                </div>
                <div class="card-body pt-2 pb-5">
                    <div class="w-100" style="min-height: 320px;">
                        {% if chart is defined and chart %}
                            {{ render_chart(chart) }}
                        {% else %}
                            <div class="d-flex align-items-center justify-content-center h-250px text-muted">
                                <i class="bi bi-bar-chart me-2"></i>Données graphiques en cours de consolidation.
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <!-- Top Assiduité Collaborateurs -->
        <div class="col-xl-4">
            <div class="card card-flush border-0 shadow-sm h-100">
                <div class="card-header pt-5">
                    <h3 class="card-title align-items-start flex-column">
                        <span class="card-label fw-bold fs-3 text-gray-900">
                            <i class="bi bi-award-fill text-warning me-2"></i>Exemplarité &amp; Assiduité
                        </span>
                        <span class="text-muted mt-1 fw-semibold fs-7">Collaborateurs les plus réguliers</span>
                    </h3>
                </div>
                <div class="card-body pt-4">
                    {% if top_employes is defined and top_employes|length > 0 %}
                        <div class="d-flex flex-column gap-4">
                            {% for item in top_employes %}
                                {% set emp = item.employe|default(item[0]|default(null)) %}
                                {% set score = item.total_presences|default(item['total']|default(item[1]|default(0))) %}
                                {% if emp %}
                                    <div class="d-flex align-items-center justify-content-between p-3 rounded bg-light-subtle border border-dashed border-gray-300">
                                        <div class="d-flex align-items-center">
                                            <div class="symbol symbol-40px symbol-circle me-3 bg-light-primary text-primary fw-bolder d-flex align-items-center justify-content-center">
                                                {{ emp.nom ? emp.nom|first|upper : 'E' }}{{ emp.prenom ? emp.prenom|first|upper : 'M' }}
                                            </div>
                                            <div class="d-flex flex-column">
                                                <a href="{{ path('app_pointage_employe', {'id': emp.id}) }}" class="text-gray-900 text-hover-primary fw-bold fs-6">
                                                    {{ emp.nom }} {{ emp.prenom }}
                                                </a>
                                                <span class="text-muted fs-8">
                                                    <i class="bi bi-building me-1"></i>{{ emp.service ? emp.service.nom : 'Service non assigné' }}
                                                </span>
                                            </div>
                                        </div>
                                        <span class="badge badge-light-success fw-bold fs-7 py-2 px-3">
                                            <i class="bi bi-check2-all text-success me-1"></i>{{ score }} pointages
                                        </span>
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-center py-8 text-muted">
                            <i class="bi bi-trophy fs-3x text-muted mb-2 d-block"></i>
                            <div class="fs-7">Aucune donnée de classement disponible.</div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Registre Émargement Récent du Jour -->
    <div class="card card-flush border-0 shadow-sm">
        <div class="card-header pt-5">
            <h3 class="card-title align-items-start flex-column">
                <span class="card-label fw-bold fs-3 text-gray-900">
                    <i class="bi bi-clock-history text-primary me-2"></i>Émargements du Jour
                </span>
                <span class="text-muted mt-1 fw-semibold fs-7">Pointages effectifs enregistrés aujourd'hui</span>
            </h3>
            <div class="card-toolbar">
                <a href="{{ path('app_pointage_index') }}" class="btn btn-sm btn-light-primary">
                    <i class="bi bi-list-check me-1"></i>
                    Voir la liste exhaustive
                    <i class="bi bi-arrow-right fs-6 ms-1"></i>
                </a>
            </div>
        </div>
        <div class="card-body pt-0">
            <div class="table-responsive">
                <table class="table align-middle table-row-dashed fs-6 gy-4">
                    <thead>
                        <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
                            <th><i class="bi bi-person me-2 text-primary"></i>Collaborateur</th>
                            <th><i class="bi bi-building me-2 text-primary"></i>Service</th>
                            <th class="text-center"><i class="bi bi-box-arrow-in-right me-2 text-success"></i>Heure d'arrivée</th>
                            <th class="text-center"><i class="bi bi-box-arrow-right me-2 text-primary"></i>Heure de départ</th>
                            <th class="text-center"><i class="bi bi-check2-circle me-2 text-info"></i>Statut</th>
                            <th class="text-end pe-4"><i class="bi bi-gear me-2 text-muted"></i>Actions</th>
                        </tr>
                    </thead>
                    <tbody class="text-gray-600 fw-semibold">
                        {% for pointage in pointages %}
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        {% if pointage.employe %}
                                            <div class="symbol symbol-35px symbol-circle me-3 bg-light-primary text-primary fw-bolder d-flex align-items-center justify-content-center">
                                                {{ pointage.employe.nom ? pointage.employe.nom|first|upper : 'E' }}
                                            </div>
                                            <div class="d-flex flex-column">
                                                <a href="{{ path('app_pointage_employe', {'id': pointage.employe.id}) }}" class="text-gray-900 text-hover-primary fw-bold">
                                                    {{ pointage.employe.nom }} {{ pointage.employe.prenom }}
                                                </a>
                                                <span class="text-muted fs-8">
                                                    <i class="bi bi-upc-scan me-1"></i>Matricule : {{ pointage.employe.matricule|default('N/D') }}
                                                </span>
                                            </div>
                                        {% else %}
                                            <span class="text-muted"><i class="bi bi-person-x me-1"></i>Agent non affecté</span>
                                        {% endif %}
                                    </div>
                                </td>
                                <td>
                                    {% if pointage.employe and pointage.employe.service %}
                                        <span class="d-flex align-items-center text-gray-700">
                                            <i class="bi bi-building me-1 text-muted fs-7"></i>
                                            {{ pointage.employe.service.nom }}
                                        </span>
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </td>
                                <td class="text-center">
                                    {% if pointage.heureArrivee %}
                                        <span class="badge badge-light-success fw-bold font-monospace fs-7">
                                            <i class="bi bi-clock text-success me-1"></i>{{ pointage.heureArrivee|date('H:i') }}
                                        </span>
                                    {% else %}
                                        <span class="text-muted fs-7">—</span>
                                    {% endif %}
                                </td>
                                <td class="text-center">
                                    {% if pointage.heureDepart %}
                                        <span class="badge badge-light-primary fw-bold font-monospace fs-7">
                                            <i class="bi bi-clock-history text-primary me-1"></i>{{ pointage.heureDepart|date('H:i') }}
                                        </span>
                                    {% else %}
                                        <span class="text-muted fs-7">—</span>
                                    {% endif %}
                                </td>
                                <td class="text-center">
                                    {% set st = pointage.status|default('Présent') %}
                                    {% if st in ['Présent', 'Present'] %}
                                        <span class="badge badge-light-success fw-bold py-2 px-3">
                                            <i class="bi bi-check-circle-fill text-success me-1"></i>Présent
                                        </span>
                                    {% elseif st in ['Absent'] %}
                                        <span class="badge badge-light-danger fw-bold py-2 px-3">
                                            <i class="bi bi-x-circle-fill text-danger me-1"></i>Absent
                                        </span>
                                    {% elseif st in ['En retard', 'Retard'] %}
                                        <span class="badge badge-light-warning fw-bold py-2 px-3">
                                            <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>Retard
                                        </span>
                                    {% else %}
                                        <span class="badge badge-light-secondary fw-bold py-2 px-3">
                                            <i class="bi bi-dash-circle text-secondary me-1"></i>{{ st }}
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="text-end pe-4">
                                    <a href="{{ path('app_pointage_show', {'id': pointage.id}) }}" class="btn btn-icon btn-light btn-sm btn-active-light-primary" title="Détails du pointage">
                                        <i class="bi bi-eye-fill fs-5 text-primary"></i>
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center py-6 text-muted">
                                    <i class="bi bi-inbox fs-2 text-muted d-block mb-2"></i>
                                    Aucun émargement enregistré aujourd'hui.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
