{% extends 'base.html.twig' %}

{% block title %}Détails de l'autorisation d'absence #{{ absence.id }}{% endblock %}

{% block page_title %}
    <h2 class="d-flex align-items-center text-dark fw-bolder fs-2 my-1">
        <i class="bi bi-calendar-check-fill text-mci-blue me-3"></i>
        Autorisation d'absence #{{ absence.id }}
        <span class="h-20px border-gray-300 border-start ms-3 mx-2 d-none d-md-inline"></span>
        <small class="text-muted fs-7 fw-semibold my-1 ms-1">{{ absence.employe.nomComplet }}</small>
    </h2>
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-muted">Temps & Absences</li>
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-muted">
        <a href="{{ path('app_absence_index') }}" class="text-muted text-hover-primary">Autorisations d'absence</a>
    </li>
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-dark fw-bold">#{{ absence.id }}</li>
{% endblock %}

{% block page_actions %}
    <div class="d-flex align-items-center gap-2">
        <a href="{{ path('app_absence_index') }}" class="btn btn-mci-secondary btn-sm">
            <i class="bi bi-arrow-left fs-5 me-1"></i>
            <span class="d-none d-sm-inline">Liste des absences</span>
        </a>
    </div>
{% endblock %}

{% block body %}
<div class="d-flex flex-column gap-6">

    <!-- Flash messages -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-mci alert-mci-{{ label == 'error' or label == 'danger' ? 'danger' : (label == 'warning' ? 'warning' : 'success') }} d-flex align-items-center p-5 mb-2" role="alert">
                <i class="bi bi-{{ label == 'error' or label == 'danger' ? 'exclamation-octagon-fill text-danger' : (label == 'warning' ? 'exclamation-triangle-fill text-warning' : 'check-circle-fill text-success') }} fs-2 me-4"></i>
                <div class="d-flex flex-column">
                    <span class="fw-bold">{{ message }}</span>
                </div>
                <button type="button" class="position-absolute position-sm-relative m-2 m-sm-0 top-0 end-0 btn btn-icon ms-sm-auto" data-bs-dismiss="alert">
                    <i class="bi bi-x fs-2"></i>
                </button>
            </div>
        {% endfor %}
    {% endfor %}

    <!-- Bannière de Statut & Actions -->
    <div class="card card-mci p-5">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-4">
            <div class="d-flex align-items-center gap-3">
                <div class="symbol symbol-45px symbol-circle" style="background-color: var(--mci-blue-subtle);">
                    <span class="symbol-label">
                        <i class="bi bi-calendar-check-fill fs-2 text-mci-blue"></i>
                    </span>
                </div>
                <div class="d-flex flex-column">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge" style="background-color: {{ absence.typeAbsence.couleur ?: '#0C2340' }}; color: white;">
                            {{ absence.typeAbsence.libelle }}
                        </span>
                        {% if absence.statut == 0 %}
                            <span class="badge badge-mci-warning fs-8"><i class="bi bi-hourglass-split me-1"></i>En attente de validation</span>
                        {% elseif absence.statut == 1 %}
                            <span class="badge badge-mci-success fs-8"><i class="bi bi-check-circle-fill me-1"></i>Accordée</span>
                        {% elseif absence.statut == 2 %}
                            <span class="badge badge-mci-danger fs-8"><i class="bi bi-x-circle-fill me-1"></i>Refusée</span>
                        {% elseif absence.statut == 3 %}
                            <span class="badge bg-secondary text-white fs-8"><i class="bi bi-slash-circle me-1"></i>Annulée</span>
                        {% endif %}
                    </div>
                    <span class="text-muted fs-8 mt-1">
                        Agent : <strong>{{ absence.employe.nomComplet }}</strong> • Durée : <strong>{{ absence.duree }} {{ absence.unite|lower }}</strong>
                    </span>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 align-items-center">
                {% if is_granted('ABSENCE_APPROVE', absence) %}
                    <button type="button" class="btn btn-mci-primary btn-sm" data-bs-toggle="modal" data-bs-target="#approveModal">
                        <i class="bi bi-check2-circle fs-5 me-1"></i> Accorder
                    </button>
                {% endif %}

                {% if is_granted('ABSENCE_REJECT', absence) %}
                    <button type="button" class="btn btn-mci-light btn-sm text-danger" data-bs-toggle="modal" data-bs-target="#rejectModal">
                        <i class="bi bi-x-circle fs-5 me-1"></i> Refuser
                    </button>
                {% endif %}

                {% if is_granted('ABSENCE_CANCEL', absence) %}
                    <button type="button" class="btn btn-mci-light btn-sm text-warning" data-bs-toggle="modal" data-bs-target="#cancelModal">
                        <i class="bi bi-slash-circle fs-5 me-1"></i> Annuler
                    </button>
                {% endif %}

                {% if is_granted('ABSENCE_EDIT', absence) %}
                    <a href="{{ path('app_absence_edit', {'id': absence.id}) }}" class="btn btn-mci-light btn-sm">
                        <i class="bi bi-pencil-square fs-5 me-1"></i> Modifier
                    </a>
                {% endif %}

                {% if is_granted('ABSENCE_DELETE', absence) %}
                    <button type="button" class="btn btn-mci-light btn-sm text-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                        <i class="bi bi-trash3 fs-5 me-1"></i> Supprimer
                    </button>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="row g-6">
        <!-- Informations principales -->
        <div class="col-lg-8">
            <div class="card card-mci mb-6">
                <div class="card-header border-0 pt-6">
                    <div class="card-title">
                        <i class="bi bi-info-circle-fill fs-2 text-mci-blue me-3"></i>
                        <h3 class="fw-bolder text-dark mb-0 fs-4">Caractéristiques de l'absence</h3>
                    </div>
                </div>
                <div class="card-body py-4">
                    <div class="d-flex flex-column gap-3">
                        <div class="d-flex justify-content-between py-2 border-bottom border-gray-200">
                            <span class="text-muted fs-7">Type d'absence :</span>
                            <div>
                                <span class="badge" style="background-color: {{ absence.typeAbsence.couleur ?: '#0C2340' }}; color: white;">
                                    {{ absence.typeAbsence.libelle }}
                                </span>
                                {% if not absence.typeAbsence.remuneree %}
                                    <span class="badge badge-mci-light text-muted ms-1 fs-9">Non rémunérée</span>
                                {% else %}
                                    <span class="badge badge-mci-success ms-1 fs-9">Rémunérée</span>
                                {% endif %}
                            </div>
                        </div>

                        <div class="d-flex justify-content-between py-2 border-bottom border-gray-200">
                            <span class="text-muted fs-7">Durée demandée :</span>
                            <span class="fs-6 fw-bolder text-mci-blue">{{ absence.duree }} {{ absence.unite|lower }}</span>
                        </div>

                        <div class="d-flex justify-content-between py-2 border-bottom border-gray-200">
                            <span class="text-muted fs-7">Date de début :</span>
                            <span class="fw-bold text-dark fs-7">
                                {{ absence.dateDebut|date('d/m/Y') }}
                                {% if absence.heureDebut %}
                                    <span class="badge badge-mci-light text-muted ms-1 fs-9"><i class="bi bi-clock me-1"></i>{{ absence.heureDebut|date('H:i') }}</span>
                                {% endif %}
                            </span>
                        </div>

                        <div class="d-flex justify-content-between py-2 border-bottom border-gray-200">
                            <span class="text-muted fs-7">Date de fin :</span>
                            <span class="fw-bold text-dark fs-7">
                                {{ absence.dateFin|date('d/m/Y') }}
                                {% if absence.heureFin %}
                                    <span class="badge badge-mci-light text-muted ms-1 fs-9"><i class="bi bi-clock me-1"></i>{{ absence.heureFin|date('H:i') }}</span>
                                {% endif %}
                            </span>
                        </div>

                        <div class="py-2 border-bottom border-gray-200">
                            <span class="text-muted fs-7 d-block mb-1">Motif invoqué :</span>
                            <div class="p-4 rounded-3 bg-light text-dark fs-7">
                                {{ absence.motif|nl2br }}
                            </div>
                        </div>

                        {% if absence.commentaireDecision %}
                            <div class="py-2 border-bottom border-gray-200">
                                <span class="text-muted fs-7 d-block mb-1">Décision & Commentaires hiérarchiques :</span>
                                <div class="p-4 rounded-3 bg-light-primary border border-primary border-opacity-20 text-dark fs-7">
                                    {{ absence.commentaireDecision|nl2br }}
                                    {% if absence.approuvePar and absence.dateDecision %}
                                        <div class="text-muted fs-8 mt-2">
                                            Décision enregistrée par <strong>{{ absence.approuvePar.nomComplet }}</strong> le {{ absence.dateDecision|date('d/m/Y à H:i') }}.
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Documents et Actes officiels liés -->
            <div class="row g-6">
                <div class="col-md-6">
                    <div class="card card-mci h-100">
                        <div class="card-header border-0 pt-6">
                            <div class="card-title">
                                <i class="bi bi-file-earmark-pdf-fill fs-2 text-danger me-3"></i>
                                <h3 class="fw-bolder text-dark mb-0 fs-5">Justificatif fourni</h3>
                            </div>
                        </div>
                        <div class="card-body py-4">
                            {% if absence.document %}
                                <div class="d-flex align-items-center justify-content-between p-4 rounded-3 bg-light border">
                                    <div>
                                        <div class="fw-bolder text-dark fs-7">{{ absence.document.titre }}</div>
                                        <div class="text-muted fs-8">{{ absence.document.categorie ?: 'Document RH' }}</div>
                                    </div>
                                    <a href="{{ path('app_document_show', {'id': absence.document.id}) }}" class="btn btn-mci-secondary btn-sm">
                                        <i class="bi bi-eye me-1"></i> Consulter
                                    </a>
                                </div>
                            {% else %}
                                <p class="text-muted fs-8 mb-0">
                                    {% if absence.typeAbsence.justificatifRequis %}
                                        <span class="text-danger fw-semibold"><i class="bi bi-exclamation-triangle me-1"></i>Justificatif requis mais non renseigné.</span>
                                    {% else %}
                                        Aucun document justificatif requis ou fourni pour cette demande.
                                    {% endif %}
                                </p>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card card-mci h-100">
                        <div class="card-header border-0 pt-6">
                            <div class="card-title">
                                <i class="bi bi-stamp fs-2 text-success me-3"></i>
                                <h3 class="fw-bolder text-dark mb-0 fs-5">Acte officiel généré</h3>
                            </div>
                        </div>
                        <div class="card-body py-4">
                            {% if absence.acte %}
                                <div class="d-flex align-items-center justify-content-between p-4 rounded-3 bg-light border">
                                    <div>
                                        <div class="fw-bolder text-success fs-7">{{ absence.acte.numero }}</div>
                                        <div class="text-muted fs-8">{{ absence.acte.typeActe ? absence.acte.typeActe.libelle : 'Autorisation d\'absence' }}</div>
                                    </div>
                                    <a href="{{ path('app_acte_show', {'id': absence.acte.id}) }}" class="btn btn-mci-secondary btn-sm">
                                        <i class="bi bi-stamp me-1"></i> Consulter l'acte
                                    </a>
                                </div>
                            {% else %}
                                <p class="text-muted fs-8 mb-0">
                                    {% if absence.statut == 1 %}
                                        L'acte administratif officiel n'a pas été généré lors de la validation.
                                    {% else %}
                                        L'acte administratif sera généré automatiquement lors de l'accord hiérarchique.
                                    {% endif %}
                                </p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar : Informations agent et timeline d'historique -->
        <div class="col-lg-4">
            <!-- Profil Agent -->
            <div class="card card-mci mb-6">
                <div class="card-header border-0 pt-6">
                    <div class="card-title">
                        <i class="bi bi-person-badge-fill fs-2 text-mci-blue me-3"></i>
                        <h3 class="fw-bolder text-dark mb-0 fs-5">Détails de l'agent</h3>
                    </div>
                </div>
                <div class="card-body py-4">
                    <div class="d-flex align-items-center mb-4">
                        <div class="symbol symbol-50px symbol-circle bg-light-primary text-primary fw-bolder fs-4 me-3 d-flex align-items-center justify-content-center">
                            {{ absence.employe.prenom|slice(0, 1)|upper }}{{ absence.employe.nom|slice(0, 1)|upper }}
                        </div>
                        <div>
                            <h5 class="fw-bolder mb-1 text-dark">{{ absence.employe.nomComplet }}</h5>
                            <span class="text-muted fs-8">{{ absence.employe.matricule ?: 'Sans matricule' }}</span>
                        </div>
                    </div>
                    <div class="d-flex flex-column gap-2 fs-7 mb-4">
                        <div class="d-flex justify-content-between py-2 border-bottom border-gray-200">
                            <span class="text-muted">Service :</span>
                            <span class="fw-semibold text-dark">{{ absence.employe.service ? absence.employe.service.nom : 'Non affecté' }}</span>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom border-gray-200">
                            <span class="text-muted">Poste :</span>
                            <span class="fw-semibold text-dark">{{ absence.employe.poste ? absence.employe.poste.intitule : 'Non spécifié' }}</span>
                        </div>
                        <div class="d-flex justify-content-between py-2">
                            <span class="text-muted">Statut :</span>
                            <span class="badge badge-mci-success fs-9">Actif</span>
                        </div>
                    </div>
                    <a href="{{ path('app_employe_show', {'id': absence.employe.id}) }}" class="btn btn-mci-secondary btn-sm w-100">
                        <i class="bi bi-folder2-open me-1"></i> Fiche complète de l'agent
                    </a>
                </div>
            </div>

            <!-- Historique / Audit Log -->
            <div class="card card-mci">
                <div class="card-header border-0 pt-6">
                    <div class="card-title">
                        <i class="bi bi-clock-history fs-2 text-mci-blue me-3"></i>
                        <h3 class="fw-bolder text-dark mb-0 fs-5">Historique du circuit</h3>
                    </div>
                </div>
                <div class="card-body py-4">
                    {% if absence.absenceLogs|length > 0 %}
                        <div class="timeline-label">
                            {% for log in absence.absenceLogs %}
                                <div class="timeline-item mb-3">
                                    <div class="timeline-label fw-bold text-gray-800 fs-8" style="width: 75px;">
                                        {{ log.createdAt|date('d/m/Y') }}
                                    </div>
                                    <div class="timeline-badge">
                                        <i class="bi bi-record-circle-fill text-mci-blue fs-4"></i>
                                    </div>
                                    <div class="timeline-content p-3 rounded-3 bg-light ms-2 flex-grow-1">
                                        <div class="fw-bolder text-dark fs-8">{{ log.actionLabel }}</div>
                                        {% if log.description %}
                                            <div class="text-muted fs-8">{{ log.description }}</div>
                                        {% endif %}
                                        <div class="text-muted fs-9 mt-1">
                                            Par {{ log.user ? log.user.nomComplet : 'Système' }} à {{ log.createdAt|date('H:i') }}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-muted fs-8 text-center py-4 mb-0">Aucun événement enregistré.</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

{# Modals d'actions #}

{# Modal Approbation #}
{% if is_granted('ABSENCE_APPROVE', absence) %}
    <div class="modal fade" id="approveModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" action="{{ path('app_absence_approuver', {'id': absence.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('absence_approuver_' ~ absence.id) }}">
                    <div class="modal-header bg-success text-white">
                        <h5 class="modal-title text-white"><i class="bi bi-check-circle-fill me-2"></i>Accorder l'autorisation d'absence</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-6">
                        <p class="fs-6 text-dark mb-4">Confirmez-vous l'accord de cette autorisation d'absence pour <strong>{{ absence.employe.nomComplet }}</strong> ?</p>
                        <div class="mb-4">
                            <div class="form-check form-check-custom form-check-solid">
                                <input class="form-check-input" type="checkbox" id="genererActeShow" name="generer_acte" value="1" checked>
                                <label class="form-check-label fw-bold text-dark fs-7 ms-2" for="genererActeShow">Générer automatiquement l'acte officiel d'autorisation d'absence</label>
                            </div>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold fs-7">Numéro d'acte (laisser vide pour numérotation automatique)</label>
                            <input type="text" name="numero_acte" class="form-control form-control-solid fs-7" placeholder="Ex: AA-{{ "now"|date("Y") }}-001">
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold fs-7">Observations / Commentaire</label>
                            <textarea name="commentaire" class="form-control form-control-solid fs-7" rows="2" placeholder="Observations éventuelles..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-mci-light" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-success"><i class="bi bi-check-lg me-1"></i>Accorder</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endif %}

{# Modal Refus #}
{% if is_granted('ABSENCE_REJECT', absence) %}
    <div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" action="{{ path('app_absence_rejeter', {'id': absence.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('absence_rejeter_' ~ absence.id) }}">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title text-white"><i class="bi bi-x-circle-fill me-2"></i>Refuser la demande</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-6">
                        <p class="fs-6 text-dark mb-4">Veuillez spécifier le motif du refus pour la demande de <strong>{{ absence.employe.nomComplet }}</strong> :</p>
                        <div class="mb-3">
                            <label class="form-label fw-bolder fs-7 text-dark">Motif du refus <span class="text-danger">*</span></label>
                            <textarea name="motif_refus" class="form-control form-control-solid fs-7" rows="3" required placeholder="Motif circonstancié du refus..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-mci-light" data-bs-dismiss="modal">Fermer</button>
                        <button type="submit" class="btn btn-danger"><i class="bi bi-x-lg me-1"></i>Confirmer le refus</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endif %}

{# Modal Annulation #}
{% if is_granted('ABSENCE_CANCEL', absence) %}
    <div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" action="{{ path('app_absence_annuler', {'id': absence.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('absence_annuler_' ~ absence.id) }}">
                    <div class="modal-header bg-secondary text-white">
                        <h5 class="modal-title text-white"><i class="bi bi-slash-circle me-2"></i>Annuler l'autorisation d'absence</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-6">
                        <p class="fs-6 text-dark mb-4">Êtes-vous certain de vouloir annuler cette absence ? Si un acte a été émis, il sera automatiquement abrogé.</p>
                        <div class="mb-3">
                            <label class="form-label fw-semibold fs-7">Motif de l'annulation (optionnel)</label>
                            <textarea name="motif_annulation" class="form-control form-control-solid fs-7" rows="2" placeholder="Motif de l'annulation..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-mci-light" data-bs-dismiss="modal">Fermer</button>
                        <button type="submit" class="btn btn-secondary">Confirmer l'annulation</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endif %}

{# Modal Suppression #}
{% if is_granted('ABSENCE_DELETE', absence) %}
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" action="{{ path('app_absence_delete', {'id': absence.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('absence_delete_' ~ absence.id) }}">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title text-white"><i class="bi bi-trash3 me-2"></i>Supprimer la demande d'absence</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-6">
                        <p class="fs-6 text-dark mb-0">Êtes-vous sûr de vouloir supprimer définitivement cette demande d'absence ? Cette action est irréversible.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-mci-light" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash3 me-1"></i>Confirmer la suppression</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endif %}

{% endblock %}
