{% extends 'auth.html.twig' %}

{% block title %}Vérifiez vos Emails{% endblock %}

{% block body %}
<div class="text-center d-flex flex-column align-items-center py-2">
    <div class="symbol symbol-65px symbol-circle bg-light-primary mb-4 d-inline-flex align-items-center justify-content-center">
        <i class="bi bi-envelope-check fs-2tx text-primary"></i>
    </div>

    <h2 class="text-gray-900 fw-bolder fs-2 mb-2">Vérifiez votre boîte de réception</h2>
    <p class="text-muted fs-7 mb-4">
        Si un compte correspond à l'adresse indiquée, un courrier contenant un lien sécurisé de réinitialisation vient de vous être envoyé.
    </p>

    <div class="alert alert-light-primary d-flex align-items-center p-3 mb-6 rounded-2 text-start w-100 border border-primary border-opacity-20">
        <i class="bi bi-info-circle fs-4 text-primary me-3 flex-shrink-0"></i>
        <span class="fs-8 text-gray-700">
            Ce lien expirera dans <strong>1 heure</strong>. Pensez à vérifier vos courriers indésirables (spams).
        </span>
    </div>

    <a class="btn btn-mci-primary h-50px w-100 fs-6 fw-bold shadow-sm d-inline-flex align-items-center justify-content-center" href="{{ path('app_login') }}">
        <i class="bi bi-arrow-left fs-5 me-2"></i> Retour à la page de connexion
    </a>
</div>
{% endblock %}
