{% extends 'auth.html.twig' %}

{% block title %}Vérification en deux étapes (MFA) — MCI e-Circuit{% endblock %}

{% block body %}
<div class="text-center mb-8">
    <div class="symbol symbol-60px symbol-circle mb-4 bg-light-primary text-primary d-inline-flex align-items-center justify-content-center">
        <i class="ki-duotone ki-shield-tick fs-1 text-primary">
            <span class="path1"></span>
            <span class="path2"></span>
        </i>
    </div>
    <h1 class="text-gray-900 fw-bolder mb-2 fs-2">Double Authentification</h1>
    <div class="text-gray-600 fs-7">
        Saisissez le code de sécurité à 6 chiffres généré par votre application ou un code de secours.
    </div>
</div>

{% if authenticationError %}
    <div class="alert alert-danger d-flex align-items-center p-4 mb-6">
        <i class="ki-duotone ki-cross-circle fs-3 text-danger me-3">
            <span class="path1"></span>
            <span class="path2"></span>
        </i>
        <div>{{ authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}</div>
    </div>
{% endif %}

<form class="form w-100" action="{{ checkPathUrl ? checkPathUrl : path(checkPathRoute) }}" method="post">
    {% if isCsrfProtectionEnabled %}
        <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
    {% endif %}

    <div class="fv-row mb-8">
        <label class="form-label fs-6 fw-bold text-gray-900 text-center d-block mb-3">
            Code de vérification TOTP
        </label>
        <input class="form-control form-control-solid text-center h-55px fs-2hx fw-boldest letter-spacing-2" 
               type="text" 
               name="{{ authCodeParameterName }}" 
               autocomplete="one-time-code" 
               autofocus 
               placeholder="000000" 
               maxlength="16" />
        <div class="text-muted fs-8 text-center mt-2">
            Ex: 123456 ou votre code de secours à usage unique.
        </div>
    </div>

    <div class="d-grid mb-6">
        <button class="btn btn-mci-primary h-50px fs-6 fw-bold" type="submit">
            <i class="ki-duotone ki-check fs-3 me-2"></i>
            Valider le code
        </button>
    </div>

    <div class="text-center">
        <a class="text-danger fw-semibold fs-7" href="{{ logoutPath|default(path('app_logout')) }}">
            <i class="ki-duotone ki-exit-right fs-5 text-danger me-1">
                <span class="path1"></span>
                <span class="path2"></span>
            </i>
            Annuler et se déconnecter
        </a>
    </div>
</form>
{% endblock %}
