{% extends 'auth.html.twig' %}

{% block title %}Nouveau Mot de Passe — PRIMATECH{% endblock %}

{% block body %}
    {{ form_start(resetForm, {'attr': {'class': 'form d-flex flex-column gap-4'}}) }}
        <div class="text-center mb-6">
            <h2 class="text-gray-900 fw-bolder fs-2 mb-2">Nouveau Mot de Passe</h2>
            <p class="text-gray-600 fs-7 mb-0">
                Définissez une nouvelle phrase secrète d'au moins 8 caractères pour sécuriser l'accès à votre espace.
            </p>
        </div>

        <div class="fv-row mb-2">
            <label class="form-label fs-7 fw-bold text-gray-700 required">Nouveau mot de passe</label>
            {{ form_widget(resetForm.plainPassword.first, {
                'attr': {
                    'class': 'form-control form-control-solid',
                    'placeholder': '••••••••••••',
                    'autocomplete': 'new-password',
                    'autofocus': 'autofocus'
                }
            }) }}
            {{ form_errors(resetForm.plainPassword.first) }}
        </div>

        <div class="fv-row mb-4">
            <label class="form-label fs-7 fw-bold text-gray-700 required">Confirmation du mot de passe</label>
            {{ form_widget(resetForm.plainPassword.second, {
                'attr': {
                    'class': 'form-control form-control-solid',
                    'placeholder': '••••••••••••',
                    'autocomplete': 'new-password'
                }
            }) }}
            {{ form_errors(resetForm.plainPassword.second) }}
        </div>

        <div class="d-flex flex-column gap-3 mt-2">
            <button class="btn btn-mci-primary w-100 py-3" type="submit">
                <i class="ki-outline ki-shield-tick fs-6 me-1"></i> Mettre à jour le mot de passe
            </button>
            <a class="btn btn-light w-100 py-3 text-gray-700" href="{{ path('app_login') }}">
                <i class="ki-outline ki-arrow-left fs-6 me-1"></i> Retour à la connexion
            </a>
        </div>
    {{ form_end(resetForm) }}
{% endblock %}
