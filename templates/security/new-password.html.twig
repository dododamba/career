{% extends 'auth.html.twig' %}

{% block title %}Nouveau Mot de Passe{% endblock %}

{% block body %}
    {{ form_start(resetForm, {'attr': {'class': 'form d-flex flex-column gap-4'}}) }}
        <div class="text-center mb-6">
            <h2 class="text-gray-900 fw-bolder fs-2 mb-2">Nouveau mot de passe</h2>
            <p class="text-muted fs-7 mb-0">
                Définissez une nouvelle phrase secrète d'au moins 8 caractères pour sécuriser l'accès à votre espace.
            </p>
        </div>

        <div class="fv-row mb-2">
            <label class="form-label fs-7 fw-bold text-gray-900 required">Nouveau mot de passe</label>
            {{ form_widget(resetForm.plainPassword.first, {
                'attr': {
                    'class': 'form-control form-control-mci h-48px fs-6',
                    'placeholder': '••••••••••••',
                    'autocomplete': 'new-password',
                    'autofocus': 'autofocus'
                }
            }) }}
            {{ form_errors(resetForm.plainPassword.first) }}
        </div>

        <div class="fv-row mb-3">
            <label class="form-label fs-7 fw-bold text-gray-900 required">Confirmation du mot de passe</label>
            {{ form_widget(resetForm.plainPassword.second, {
                'attr': {
                    'class': 'form-control form-control-mci h-48px fs-6',
                    'placeholder': '••••••••••••',
                    'autocomplete': 'new-password'
                }
            }) }}
            {{ form_errors(resetForm.plainPassword.second) }}
        </div>

        <div class="d-flex flex-column gap-3 mt-3">
            <button class="btn btn-mci-primary h-50px fs-6 fw-bold shadow-sm" type="submit">
                <i class="bi bi-shield-check fs-5 me-2"></i> Mettre à jour le mot de passe
            </button>
            <a class="btn btn-light h-48px fs-7 fw-semibold text-gray-700 d-inline-flex align-items-center justify-content-center" href="{{ path('app_login') }}">
                <i class="bi bi-arrow-left fs-6 me-2"></i> Retour à la connexion
            </a>
        </div>
    {{ form_end(resetForm) }}
{% endblock %}
