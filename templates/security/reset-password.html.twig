{% extends 'auth.html.twig' %}

{% block title %}Récupération de Mot de Passe — PRIMATECH{% endblock %}

{% block body %}
    {{ form_start(requestForm, {'attr': {'class': 'form d-flex flex-column gap-4'}}) }}
        <div class="text-center mb-6">
            <h2 class="text-gray-900 fw-bolder fs-2 mb-2">Mot de passe oublié ?</h2>
            <p class="text-gray-600 fs-7 mb-0">
                Saisissez votre adresse email ministérielle. Un lien sécurisé vous sera transmis pour réinitialiser vos identifiants.
            </p>
        </div>

        <div class="fv-row mb-2">
            <label class="form-label fs-7 fw-bold text-gray-700 required">Adresse email</label>
            {{ form_widget(requestForm.email, {
                'attr': {
                    'class': 'form-control form-control-solid',
                    'placeholder': 'nom.prenom@commerce.gouv.td',
                    'autocomplete': 'email',
                    'autofocus': 'autofocus'
                }
            }) }}
            {{ form_errors(requestForm.email) }}
        </div>

        <div class="d-flex flex-column gap-3 mt-2">
            <button class="btn btn-mci-primary w-100 py-3" type="submit">
                <i class="ki-outline ki-send fs-6 me-1"></i> Envoyer le lien de réinitialisation
            </button>
            <a class="btn btn-light w-100 py-3 text-gray-700" href="{{ path('app_login') }}">
                <i class="ki-outline ki-arrow-left fs-6 me-1"></i> Retour à la connexion
            </a>
        </div>
    {{ form_end(requestForm) }}
{% endblock %}
