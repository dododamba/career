{% extends 'auth.html.twig' %}

{% block title %}Récupération de Mot de Passe{% endblock %}

{% block body %}
    {{ form_start(requestForm, {'attr': {'class': 'form d-flex flex-column gap-4'}}) }}
        <div class="text-center mb-6">
            <h2 class="text-gray-900 fw-bolder fs-2 mb-2">Mot de passe oublié ?</h2>
            <p class="text-muted fs-7 mb-0">
                Saisissez votre adresse email ministérielle. Un lien sécurisé vous sera transmis pour réinitialiser vos identifiants.
            </p>
        </div>

        <div class="fv-row mb-2">
            <label class="form-label fs-7 fw-bold text-gray-900 required">Adresse email institutionnelle</label>
            {{ form_widget(requestForm.email, {
                'attr': {
                    'class': 'form-control form-control-mci h-48px fs-6',
                    'placeholder': 'nom.prenom@commerce.gouv.td',
                    'autocomplete': 'email',
                    'autofocus': 'autofocus'
                }
            }) }}
            {{ form_errors(requestForm.email) }}
        </div>

        <div class="d-flex flex-column gap-3 mt-3">
            <button class="btn btn-mci-primary h-50px fs-6 fw-bold shadow-sm" type="submit">
                <i class="bi bi-send fs-6 me-2"></i> Envoyer le lien de réinitialisation
            </button>
            <a class="btn btn-light h-48px fs-7 fw-semibold text-gray-700 d-inline-flex align-items-center justify-content-center" href="{{ path('app_login') }}">
                <i class="bi bi-arrow-left fs-6 me-2"></i> Retour à la connexion
            </a>
        </div>
    {{ form_end(requestForm) }}
{% endblock %}
