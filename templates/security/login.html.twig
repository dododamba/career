{% extends 'auth.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div class="text-center mb-5">
    <div class="auth-institution-pill">
        <span class="auth-dot-gold"></span>
        <span>{{ app_institution }} &bull; {{ app_country }}</span>
    </div>
    <h1 class="text-gray-900 fw-bold fs-2 mb-1">Connexion</h1>
    <p class="text-muted fs-7 mb-0">Renseignez vos identifiants pour accéder à votre espace</p>
</div>

<form class="form w-100" method="post" action="{{ path('app_login') }}" data-turbo="false" id="kt_sign_in_form">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

    <!-- Champ Email institutionnel -->
    <div class="fv-row mb-5">
        <label class="form-label fs-7 fw-bold text-gray-900 mb-2 required" for="email">
            Adresse email institutionnelle
        </label>
        <div class="position-relative">
            <span class="position-absolute top-50 translate-middle-y ms-4 text-gray-400 fs-5 pointer-events-none">
                <i class="bi bi-envelope"></i>
            </span>
            <input class="form-control auth-form-control ps-12 fs-6" 
                   type="email" 
                   value="{{ last_username|default('') }}" 
                   name="email" 
                   id="email" 
                   placeholder="nom.prenom@commerce.gouv.td" 
                   required 
                   autocomplete="email" 
                   autofocus />
        </div>
    </div>

    <!-- Champ Mot de passe -->
    <div class="fv-row mb-6">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <label class="form-label fw-bold text-gray-900 fs-7 mb-0 required" for="password">
                Mot de passe
            </label>
            <a href="{{ path('app_forgot_password_request') }}" class="link-primary fs-8 fw-semibold text-hover-primary text-decoration-none">
                Mot de passe oublié ?
            </a>
        </div>
        <div class="position-relative">
            <span class="position-absolute top-50 translate-middle-y ms-4 text-gray-400 fs-5 pointer-events-none">
                <i class="bi bi-lock"></i>
            </span>
            <input class="form-control auth-form-control ps-12 pe-12 fs-6" 
                   type="password" 
                   name="password" 
                   id="password" 
                   placeholder="Votre mot de passe" 
                   required 
                   autocomplete="current-password" />
            <button type="button" 
                    class="btn btn-sm btn-icon position-absolute end-0 top-50 translate-middle-y me-2 text-gray-500 text-hover-primary" 
                    id="toggle_password" 
                    aria-label="Afficher ou masquer le mot de passe"
                    tabindex="-1">
                <i class="bi bi-eye fs-4" id="toggle_password_icon"></i>
            </button>
        </div>
    </div>

    <!-- Bouton de connexion -->
    <div class="d-grid mb-6">
        <button type="submit" class="btn auth-submit-btn" id="kt_sign_in_submit">
            <i class="bi bi-box-arrow-in-right fs-4 me-2"></i>
            Se connecter
        </button>
    </div>

    <!-- Mention institutionnelle confidentielle -->
    <div class="auth-security-notice text-center">
        <i class="bi bi-shield-lock text-primary me-1"></i>
        Plateforme réservée aux agents habilités du Ministère du Commerce et de l'Industrie de la République du Tchad.
    </div>
</form>
{% endblock %}

{% block javascripts %}
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const toggleBtn = document.getElementById('toggle_password');
        const passwordInput = document.getElementById('password');
        const toggleIcon = document.getElementById('toggle_password_icon');

        if (toggleBtn && passwordInput && toggleIcon) {
            toggleBtn.addEventListener('click', function (e) {
                e.preventDefault();
                const isPassword = passwordInput.getAttribute('type') === 'password';
                passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
                toggleIcon.classList.toggle('bi-eye', !isPassword);
                toggleIcon.classList.toggle('bi-eye-slash', isPassword);
            });
        }
    });
</script>
{% endblock %}
