{% extends 'auth.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div class="text-center mb-6">
    <div class="auth-icon-badge">
        <i class="bi bi-shield-lock-fill"></i>
    </div>
    <div class="text-muted fw-medium fs-7">
        Accédez à votre espace institutionnel de gestion des carrières.
    </div>
</div>

<form class="form w-100 validate-form" method="post" action="{{ path('app_login') }}" id="kt_sign_in_form">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

    <!-- Champ Email institutionnel -->
    <div class="fv-row mb-6">
        <label class="form-label fs-7 fw-bold text-gray-900 mb-2 required" for="email">
            Adresse email institutionnelle
        </label>
        <div class="position-relative">
            <input class="form-control form-control-mci h-48px fs-6" 
                   type="email" 
                   value="{{ last_username|default('') }}" 
                   name="email" 
                   id="email" 
                   placeholder="nom.prenom@commerce.gouv.td" 
                   required 
                   autocomplete="email" 
                   autofocus />
        </div>
    </div>

    <!-- Champ Mot de passe -->
    <div class="fv-row mb-6">
        <div class="d-flex flex-stack justify-content-between align-items-center mb-2">
            <label class="form-label fw-bold text-gray-900 fs-7 mb-0 required" for="password">
                Mot de passe
            </label>
            <a href="{{ path('app_forgot_password_request') }}" class="link-primary fs-8 fw-semibold text-hover-primary">
                Mot de passe oublié ?
            </a>
        </div>
        <div class="position-relative">
            <input class="form-control form-control-mci h-48px fs-6 pe-12" 
                   type="password" 
                   name="password" 
                   id="password" 
                   placeholder="Votre mot de passe" 
                   required 
                   autocomplete="current-password" />
            <button type="button" 
                    class="btn btn-sm btn-icon position-absolute end-0 top-50 translate-middle-y me-2 text-gray-500 text-hover-primary" 
                    id="toggle_password" 
                    aria-label="Afficher ou masquer le mot de passe"
                    tabindex="-1">
                <i class="bi bi-eye fs-4" id="toggle_password_icon"></i>
            </button>
        </div>
    </div>

    <!-- Bouton de connexion avec présence forte et indicateur de chargement -->
    <div class="d-grid mb-6">
        <button type="submit" class="btn btn-mci-primary h-50px fs-6 fw-bold shadow-sm" id="kt_sign_in_submit">
            <span class="indicator-label d-inline-flex align-items-center justify-content-center">
                <i class="bi bi-box-arrow-in-right fs-4 me-2"></i>
                Se connecter
            </span>
            <span class="indicator-progress d-none align-items-center justify-content-center">
                <span class="spinner-border spinner-border-sm align-middle me-2"></span>
                Connexion en cours...
            </span>
        </button>
    </div>

    <!-- Mention institutionnelle confidentielle -->
    <div class="auth-institution-notice p-3 rounded-2 text-center text-gray-600 fs-8">
        <i class="bi bi-shield-lock me-1 text-primary"></i>
        Plateforme réservée aux agents habilités du Ministère du Commerce et de l'Industrie de la République du Tchad.
    </div>
</form>
{% endblock %}

{% block javascripts %}
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Toggle affichage / masquage mot de passe
        const toggleBtn = document.getElementById('toggle_password');
        const passwordInput = document.getElementById('password');
        const toggleIcon = document.getElementById('toggle_password_icon');

        if (toggleBtn && passwordInput && toggleIcon) {
            toggleBtn.addEventListener('click', function (e) {
                e.preventDefault();
                const isPassword = passwordInput.getAttribute('type') === 'password';
                passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
                toggleIcon.classList.toggle('bi-eye', !isPassword);
                toggleIcon.classList.toggle('bi-eye-slash', isPassword);
            });
        }

        // Gestion de l'état de chargement lors de la soumission
        const form = document.getElementById('kt_sign_in_form');
        const submitBtn = document.getElementById('kt_sign_in_submit');
        if (form && submitBtn) {
            form.addEventListener('submit', function () {
                if (form.checkValidity()) {
                    const label = submitBtn.querySelector('.indicator-label');
                    const progress = submitBtn.querySelector('.indicator-progress');
                    if (label && progress) {
                        label.classList.add('d-none');
                        progress.classList.remove('d-none');
                        progress.classList.add('d-inline-flex');
                    }
                    submitBtn.setAttribute('disabled', 'disabled');
                }
            });
        }
    });
</script>
{% endblock %}
