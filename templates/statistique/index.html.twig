{% extends 'base.html.twig' %}

{% block title %}Statistiques & Indicateurs RH — {{ app.user.institution.nom|default(app_institution) }}{% endblock %}

{% block page_title %}
    <h1 class="d-flex align-items-center text-dark fw-bolder fs-2 my-1">
        <i class="bi bi-bar-chart-line-fill text-primary fs-3 me-2"></i>
        Tableau de Bord Analytique & Statistiques
        <span class="h-20px border-gray-300 border-start ms-3 mx-2 d-none d-md-inline"></span>
        <small class="text-muted fs-7 fw-semibold my-1 ms-1">Suivi consolidé de l'assiduité, congés et effectifs</small>
    </h1>
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-muted">Pilotage RH</li>
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-dark fw-bold">Statistiques</li>
{% endblock %}

{% block page_actions %}
    <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-sm btn-light-secondary border btn-refresh-stats">
            <i class="bi bi-arrow-repeat fs-6 me-1"></i> Actualiser
        </button>
        <a href="{{ path('app_stats_export', {'institution': app.user.institution ? app.user.institution.id : ''}) }}" class="btn btn-sm btn-mci-primary">
            <i class="bi bi-download fs-6 me-1"></i> Exporter
        </a>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .chart-container {
            height: 320px;
            position: relative;
        }
        .timeline-mci {
            position: relative;
            padding-left: 2rem;
        }
        .timeline-mci::before {
            content: '';
            position: absolute;
            left: 0.75rem;
            top: 0.5rem;
            bottom: 0.5rem;
            width: 2px;
            background: #E4E6EF;
        }
        .timeline-mci-item {
            position: relative;
            margin-bottom: 1.5rem;
        }
        .timeline-mci-badge {
            position: absolute;
            left: -2rem;
            top: 0.2rem;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            border: 2px solid #FFFFFF;
            box-shadow: 0 0 0 2px #E4E6EF;
        }
        .rotate {
            animation: spin-anim 0.8s linear infinite;
        }
        @keyframes spin-anim {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
    </style>
{% endblock %}

{% block body %}
<div class="d-flex flex-column gap-6">

    <!-- Header & Action Toolbar -->
    <div class="card card-mci border-0 shadow-sm">
        <div class="card-body py-5 px-6">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4">
                <div>
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <span class="badge badge-light-primary fw-bold text-uppercase px-3 py-2">
                            <i class="bi bi-graph-up-arrow fs-7 me-1 text-primary"></i> Indicateurs de Performance RH
                        </span>
                        <span class="badge badge-light-dark fw-semibold">
                            <i class="bi bi-building fs-7 me-1"></i> {{ app.user.institution.nom|default('Administration Centrale') }}
                        </span>
                    </div>
                    <h1 class="text-gray-900 fw-bolder fs-2 mb-1">Tableau de Bord Analytique & Statistiques</h1>
                    <p class="text-gray-600 fs-7 mb-0">Suivi consolidé de l'assiduité, de la gestion des congés et des effectifs ministériels.</p>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-3">
                    <button type="button" class="btn btn-sm btn-light-secondary border btn-refresh-stats" id="refreshStats">
                        <i class="bi bi-arrow-repeat fs-6 me-1"></i> Actualiser
                    </button>
                    <a href="{{ path('app_stats_export', {'institution': app.user.institution ? app.user.institution.id : ''}) }}" class="btn btn-sm btn-mci-primary">
                        <i class="bi bi-download fs-6 me-1"></i> Exporter les données
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtres d'Analyse -->
    <div class="card card-mci border-0 shadow-sm">
        <div class="card-body py-4 px-6">
            <form class="row g-4 align-items-center">
                <div class="col-md-5">
                    <label for="dateRange" class="form-label fs-7 fw-bold text-gray-700 mb-1">
                        <i class="bi bi-calendar3 fs-6 text-primary me-1"></i> Période d'observation
                    </label>
                    <select class="form-select form-select-solid form-select-sm" id="dateRange">
                        <option value="today" selected>Aujourd'hui</option>
                        <option value="week">Cette semaine</option>
                        <option value="month">Ce mois-ci</option>
                        <option value="quarter">Ce trimestre</option>
                        <option value="year">Année en cours</option>
                        <option value="custom">Période personnalisée...</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <label for="serviceFilter" class="form-label fs-7 fw-bold text-gray-700 mb-1">
                        <i class="bi bi-diagram-3 fs-6 text-primary me-1"></i> Département / Service
                    </label>
                    <select class="form-select form-select-solid form-select-sm" id="serviceFilter">
                        <option value="all" selected>Tous les services administratifs</option>
                        {% if services is defined %}
                            {% for service in services %}
                                <option value="{{ service.id }}">{{ service.libelle|default(service.nom) }}</option>
                            {% endfor %}
                        {% endif %}
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end pt-md-5">
                    <div class="form-check form-switch form-check-custom form-check-solid">
                        <input class="form-check-input h-20px w-35px" type="checkbox" id="autoRefresh">
                        <label class="form-check-label fs-8 text-gray-700 ms-2" for="autoRefresh">
                            <i class="bi bi-clock-history fs-7 text-muted me-1"></i> Auto-refresh (5m)
                        </label>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Indicateurs Clés KPI Row 1 -->
    <div class="row g-5">
        <!-- Effectif Total -->
        <div class="col-sm-6 col-xl-3">
            <div class="card card-mci border-0 shadow-sm h-100">
                <div class="card-body p-6">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="symbol symbol-50px symbol-circle bg-light-primary">
                            <span class="symbol-label bg-light-primary text-primary">
                                <i class="bi bi-people-fill fs-2 text-primary"></i>
                            </span>
                        </div>
                        <span class="badge badge-light-primary fs-8 fw-bolder">
                            <i class="bi bi-person-badge me-1"></i>Effectif Global
                        </span>
                    </div>
                    <div class="d-flex flex-column">
                        <span class="fs-2hx fw-bolder text-gray-900 stat-value mb-1">{{ stats.totalEmployes|default(0) }}</span>
                        <div class="d-flex align-items-center justify-content-between text-gray-500 fs-7">
                            <span><i class="bi bi-check-circle me-1 text-success"></i>Agents actifs</span>
                            <span class="fw-bold text-gray-800">{{ stats.employesActifs|default(0) }} ({{ stats.totalEmployes > 0 ? ((stats.employesActifs / stats.totalEmployes * 100)|round) : 0 }}%)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Présents Aujourd'hui -->
        <div class="col-sm-6 col-xl-3">
            <div class="card card-mci border-0 shadow-sm h-100">
                <div class="card-body p-6">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="symbol symbol-50px symbol-circle bg-light-success">
                            <span class="symbol-label bg-light-success text-success">
                                <i class="bi bi-person-check-fill fs-2 text-success"></i>
                            </span>
                        </div>
                        <span class="badge badge-light-success fs-8 fw-bolder">
                            <i class="bi bi-calendar2-check me-1"></i>Assiduité Jour
                        </span>
                    </div>
                    <div class="d-flex flex-column">
                        <span class="fs-2hx fw-bolder text-gray-900 stat-value mb-1">{{ stats.presentsAujourdhui|default(0) }}</span>
                        <div class="d-flex align-items-center justify-content-between text-gray-500 fs-7">
                            <span><i class="bi bi-pie-chart me-1 text-muted"></i>Taux de présence</span>
                            <span class="fw-bolder text-success">{{ stats.tauxPresence|default(0)|round }}%</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- En Congé -->
        <div class="col-sm-6 col-xl-3">
            <div class="card card-mci border-0 shadow-sm h-100">
                <div class="card-body p-6">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="symbol symbol-50px symbol-circle bg-light-warning">
                            <span class="symbol-label bg-light-warning text-warning">
                                <i class="bi bi-calendar2-range-fill fs-2 text-warning"></i>
                            </span>
                        </div>
                        <span class="badge badge-light-warning fs-8 fw-bolder">
                            <i class="bi bi-sun me-1"></i>Congés Réguliers
                        </span>
                    </div>
                    <div class="d-flex flex-column">
                        <span class="fs-2hx fw-bolder text-gray-900 stat-value mb-1">{{ stats.employesEnConge|default(0) }}</span>
                        <div class="d-flex align-items-center justify-content-between text-gray-500 fs-7">
                            <span><i class="bi bi-hourglass-split me-1 text-warning"></i>Demandes en instance</span>
                            <span class="fw-bold text-gray-800">{{ stats.congesEnAttente|default(0) }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Absents Aujourd'hui -->
        <div class="col-sm-6 col-xl-3">
            <div class="card card-mci border-0 shadow-sm h-100">
                <div class="card-body p-6">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="symbol symbol-50px symbol-circle bg-light-danger">
                            <span class="symbol-label bg-light-danger text-danger">
                                <i class="bi bi-person-x-fill fs-2 text-danger"></i>
                            </span>
                        </div>
                        <span class="badge badge-light-danger fs-8 fw-bolder">
                            <i class="bi bi-exclamation-octagon me-1"></i>Absentéisme
                        </span>
                    </div>
                    <div class="d-flex flex-column">
                        <span class="fs-2hx fw-bolder text-gray-900 stat-value mb-1">{{ stats.absentsAujourdhui|default(0) }}</span>
                        <div class="d-flex align-items-center justify-content-between text-gray-500 fs-7">
                            <span><i class="bi bi-graph-down me-1 text-danger"></i>Taux d'absence</span>
                            <span class="fw-bolder text-danger">{{ stats.tauxAbsenteisme|default(0)|round }}%</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Indicateurs Clés KPI Row 2 -->
    <div class="row g-5">
        <!-- Visites -->
        <div class="col-sm-6 col-xl-3">
            <div class="card card-mci border-0 shadow-sm h-100">
                <div class="card-body p-6">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="symbol symbol-50px symbol-circle bg-light-info">
                            <span class="symbol-label bg-light-info text-info">
                                <i class="bi bi-person-vcard-fill fs-2 text-info"></i>
                            </span>
                        </div>
                        <span class="badge badge-light-info fs-8 fw-bolder">
                            <i class="bi bi-door-open me-1"></i>Accueil Public
                        </span>
                    </div>
                    <div class="d-flex flex-column">
                        <span class="fs-2hx fw-bolder text-gray-900 stat-value mb-1">{{ stats.visitesAujourdhui|default(0) }}</span>
                        <div class="d-flex align-items-center justify-content-between text-gray-500 fs-7">
                            <span><i class="bi bi-clock-history me-1 text-info"></i>Visites en cours</span>
                            <span class="fw-bold text-gray-800">{{ stats.visitesEnCours|default(0) }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Services -->
        <div class="col-sm-6 col-xl-3">
            <div class="card card-mci border-0 shadow-sm h-100">
                <div class="card-body p-6">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="symbol symbol-50px symbol-circle bg-light-primary">
                            <span class="symbol-label bg-light-primary text-primary">
                                <i class="bi bi-diagram-3-fill fs-2 text-primary"></i>
                            </span>
                        </div>
                        <span class="badge badge-light-primary fs-8 fw-bolder">
                            <i class="bi bi-building me-1"></i>Organisation
                        </span>
                    </div>
                    <div class="d-flex flex-column">
                        <span class="fs-2hx fw-bolder text-gray-900 stat-value mb-1">{{ stats.totalServices|default(0) }}</span>
                        <div class="d-flex align-items-center justify-content-between text-gray-500 fs-7">
                            <span><i class="bi bi-calculator me-1 text-muted"></i>Moyenne agents / service</span>
                            <span class="fw-bold text-gray-800">{{ stats.totalServices > 0 ? ((stats.totalEmployes / stats.totalServices)|round) : 0 }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Présence Semaine -->
        <div class="col-sm-6 col-xl-3">
            <div class="card card-mci border-0 shadow-sm h-100">
                <div class="card-body p-6">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="symbol symbol-50px symbol-circle bg-light-success">
                            <span class="symbol-label bg-light-success text-success">
                                <i class="bi bi-graph-up-arrow fs-2 text-success"></i>
                            </span>
                        </div>
                        <span class="badge badge-light-success fs-8 fw-bolder">
                            <i class="bi bi-speedometer2 me-1"></i>Tendance Semaine
                        </span>
                    </div>
                    <div class="d-flex flex-column">
                        <span class="fs-2hx fw-bolder text-gray-900 stat-value mb-1">{{ stats.tauxPresenceSemaine|default(0)|round }}%</span>
                        <div class="d-flex align-items-center justify-content-between text-gray-500 fs-7">
                            <span><i class="bi bi-calendar2-week me-1 text-muted"></i>Vs sem. dernière</span>
                            <span class="fw-bold {{ stats.evolutionSemaine|default(0) >= 0 ? 'text-success' : 'text-danger' }}">
                                {% if stats.evolutionSemaine|default(0) >= 0 %}
                                    <i class="bi bi-arrow-up-right fs-7 text-success me-1"></i> +{{ stats.evolutionSemaine|default(0)|round }}%
                                {% else %}
                                    <i class="bi bi-arrow-down-right fs-7 text-danger me-1"></i> {{ stats.evolutionSemaine|default(0)|round }}%
                                {% endif %}
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Présence Mensuelle -->
        <div class="col-sm-6 col-xl-3">
            <div class="card card-mci border-0 shadow-sm h-100">
                <div class="card-body p-6">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="symbol symbol-50px symbol-circle bg-light-primary">
                            <span class="symbol-label bg-light-primary text-primary">
                                <i class="bi bi-calendar-check-fill fs-2 text-primary"></i>
                            </span>
                        </div>
                        <span class="badge badge-light-primary fs-8 fw-bolder">
                            <i class="bi bi-calendar3-range me-1"></i>Bilan Mensuel
                        </span>
                    </div>
                    <div class="d-flex flex-column">
                        <span class="fs-2hx fw-bolder text-gray-900 stat-value mb-1">{{ stats.tauxPresenceMois|default(0)|round }}%</span>
                        <div class="d-flex align-items-center justify-content-between text-gray-500 fs-7">
                            <span><i class="bi bi-calendar-day me-1 text-muted"></i>Jours ouvrés ce mois</span>
                            <span class="fw-bold text-gray-800">{{ stats.joursOuvres|default(0) }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Graphiques Principaux -->
    <div class="row g-5">
        <!-- Évolution de la Présence -->
        <div class="col-lg-8">
            <div class="card card-mci border-0 shadow-sm h-100">
                <div class="card-header border-0 pt-6">
                    <div class="card-title d-flex align-items-center gap-2">
                        <i class="bi bi-graph-up fs-3 text-primary"></i>
                        <span class="fw-bolder fs-5 text-gray-900">Évolution de la Présence (6 derniers mois)</span>
                    </div>
                    <div class="card-toolbar">
                        <span class="badge badge-light-success fs-8">
                            <i class="bi bi-check2-circle me-1"></i>Taux moyen consolidé
                        </span>
                    </div>
                </div>
                <div class="card-body pt-2">
                    <div class="chart-container">
                        <canvas id="attendanceChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Répartition des Congés -->
        <div class="col-lg-4">
            <div class="card card-mci border-0 shadow-sm h-100">
                <div class="card-header border-0 pt-6">
                    <div class="card-title d-flex align-items-center gap-2">
                        <i class="bi bi-pie-chart-fill fs-3 text-warning"></i>
                        <span class="fw-bolder fs-5 text-gray-900">Répartition des Congés</span>
                    </div>
                    <div class="card-toolbar">
                        <span class="badge badge-light-warning fs-8">
                            <i class="bi bi-tag-fill me-1"></i>Par statut
                        </span>
                    </div>
                </div>
                <div class="card-body pt-2">
                    <div class="chart-container">
                        <canvas id="leaveTypeChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tables & Activités -->
    <div class="row g-5">
        <!-- Statistiques par Service -->
        <div class="col-lg-6">
            <div class="card card-mci border-0 shadow-sm h-100">
                <div class="card-header border-0 pt-6">
                    <div class="card-title d-flex align-items-center gap-2">
                        <i class="bi bi-building-gear fs-3 text-primary"></i>
                        <span class="fw-bolder fs-5 text-gray-900">Statistiques par Service</span>
                    </div>
                </div>
                <div class="card-body pt-2">
                    <div class="table-responsive">
                        <table class="table align-middle table-row-dashed fs-7 gy-3">
                            <thead>
                                <tr class="text-start text-gray-400 fw-bolder fs-8 text-uppercase gs-0">
                                    <th><i class="bi bi-building text-gray-400 me-1"></i> Service</th>
                                    <th class="text-center"><i class="bi bi-people text-gray-400 me-1"></i> Total</th>
                                    <th class="text-center"><i class="bi bi-check-circle text-success me-1"></i> Présents</th>
                                    <th class="text-center"><i class="bi bi-x-circle text-danger me-1"></i> Absents</th>
                                    <th class="text-end" style="min-width: 120px;"><i class="bi bi-percent text-gray-400 me-1"></i> Taux</th>
                                </tr>
                            </thead>
                            <tbody class="fw-semibold text-gray-600">
                                {% for stat in stats.statsParService|default([]) %}
                                <tr>
                                    <td class="text-gray-800 fw-bold">{{ stat.service }}</td>
                                    <td class="text-center">
                                        <span class="badge badge-light-primary">{{ stat.total }}</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge badge-light-success">{{ stat.presents }}</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge badge-light-danger">{{ stat.absents }}</span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex align-items-center justify-content-end gap-2">
                                            <span class="fs-8 fw-bold text-gray-700">{{ stat.tauxPresence|round }}%</span>
                                            <div class="progress w-60px h-6px bg-light">
                                                <div class="progress-bar bg-success" role="progressbar" 
                                                     style="width: {{ stat.tauxPresence }}%" 
                                                     aria-valuenow="{{ stat.tauxPresence }}" 
                                                     aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        <i class="bi bi-inbox fs-2 text-muted mb-2 d-block"></i>
                                        Aucune donnée de service disponible
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Activités Récentes -->
        <div class="col-lg-6">
            <div class="card card-mci border-0 shadow-sm h-100">
                <div class="card-header border-0 pt-6">
                    <div class="card-title d-flex align-items-center gap-2">
                        <i class="bi bi-clock-history fs-3 text-primary"></i>
                        <span class="fw-bolder fs-5 text-gray-900">Activités Récentes du Personnel</span>
                    </div>
                    <div class="card-toolbar">
                        <span class="badge badge-light-dark fs-8">
                            <i class="bi bi-building me-1"></i>{{ app.user.institution.nom|default('Établissement') }}
                        </span>
                    </div>
                </div>
                <div class="card-body pt-2">
                    <div class="timeline-mci">
                        {% for activity in stats.activitesRecentes|default([]) %}
                        <div class="timeline-mci-item">
                            <div class="timeline-mci-badge" style="background-color: {{ activity.color|default('#002664') }};"></div>
                            <div class="d-flex flex-column bg-light rounded p-3">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <span class="text-gray-900 fw-bold fs-7">{{ activity.title }}</span>
                                    <span class="text-muted fs-8">
                                        <i class="bi bi-clock fs-8 me-1"></i>{{ activity.time|date('H:i') }}
                                    </span>
                                </div>
                                <p class="text-gray-600 fs-8 mb-0">{{ activity.description }}</p>
                            </div>
                        </div>
                        {% else %}
                        <div class="text-center py-5 text-muted fs-7">
                            <i class="bi bi-info-circle fs-2 text-muted mb-2 d-block"></i>
                            Aucune activité récente enregistrée aujourd'hui.
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Graphiques Secondaires -->
    <div class="row g-5">
        <!-- Top 5 Services - Absences -->
        <div class="col-lg-6">
            <div class="card card-mci border-0 shadow-sm h-100">
                <div class="card-header border-0 pt-6">
                    <div class="card-title d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill fs-3 text-danger"></i>
                        <span class="fw-bolder fs-5 text-gray-900">Top 5 Services — Absences (30 jours)</span>
                    </div>
                </div>
                <div class="card-body pt-2">
                    <div class="chart-container" style="height: 260px;">
                        <canvas id="absenceByServiceChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Statistiques Mensuelles Annuelles -->
        <div class="col-lg-6">
            <div class="card card-mci border-0 shadow-sm h-100">
                <div class="card-header border-0 pt-6">
                    <div class="card-title d-flex align-items-center gap-2">
                        <i class="bi bi-calendar-month-fill fs-3 text-primary"></i>
                        <span class="fw-bolder fs-5 text-gray-900">Bilan Annuel Consolidé {{ "now"|date("Y") }}</span>
                    </div>
                </div>
                <div class="card-body pt-2">
                    <div class="chart-container" style="height: 260px;">
                        <canvas id="monthlyStatsChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Répertoire Détaillé des Employés -->
    <div class="card card-mci border-0 shadow-sm">
        <div class="card-header border-0 pt-6">
            <div class="card-title">
                <div class="d-flex align-items-center position-relative my-1">
                    <i class="bi bi-search fs-4 position-absolute ms-4 text-gray-500"></i>
                    <input type="text" id="searchEmployee" class="form-control form-control-solid w-250px w-md-350px ps-12" placeholder="Rechercher par nom, matricule ou service...">
                </div>
            </div>
            <div class="card-toolbar">
                <span class="badge badge-light-primary fw-bold fs-7">
                    <i class="bi bi-person-lines-fill fs-6 me-1"></i> Répertoire d'Assiduité
                </span>
            </div>
        </div>
        <div class="card-body pt-0">
            <div class="table-responsive">
                <table class="table align-middle table-row-dashed fs-6 gy-4">
                    <thead>
                        <tr class="text-start text-gray-400 fw-bolder fs-7 text-uppercase gs-0">
                            <th class="min-w-200px"><i class="bi bi-person text-gray-400 me-1"></i> Agent / Matricule</th>
                            <th class="min-w-150px"><i class="bi bi-building text-gray-400 me-1"></i> Service Rattaché</th>
                            <th class="min-w-120px text-center"><i class="bi bi-activity text-gray-400 me-1"></i> Statut Jour</th>
                            <th class="min-w-140px"><i class="bi bi-clock-history text-gray-400 me-1"></i> Dernière Présence</th>
                            <th class="text-end min-w-100px"><i class="bi bi-sliders text-gray-400 me-1"></i> Actions</th>
                        </tr>
                    </thead>
                    <tbody class="fw-semibold text-gray-600">
                        {% for employe in stats.employes|default([]) %}
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="symbol symbol-45px symbol-circle me-3">
                                        {% if employe.photo %}
                                            <img src="{{ asset('uploads/photos/' ~ employe.photo) }}" alt="Photo de l'agent">
                                        {% else %}
                                            <span class="symbol-label bg-light-primary text-primary fw-bold">
                                                {{ employe.prenom|slice(0, 1)|upper }}{{ employe.nom|slice(0, 1)|upper }}
                                            </span>
                                        {% endif %}
                                    </div>
                                    <div class="d-flex flex-column">
                                        <a href="{{ path('app_employe_show', {'id': employe.id}) }}" class="text-gray-900 fw-bolder text-hover-primary mb-1">
                                            {{ employe.prenom }} {{ employe.nom }}
                                        </a>
                                        <span class="text-muted fs-8 font-monospace">{{ employe.matricule }}</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge badge-light-dark fw-bold fs-8">
                                    <i class="bi bi-diagram-2 me-1"></i>{{ employe.service.libelle|default(employe.service.nom|default('Non assigné')) }}
                                </span>
                            </td>
                            <td class="text-center">
                                {% if employe.statutAujourdhui == 'present' %}
                                    <span class="badge badge-light-success fs-8 fw-bold">
                                        <i class="bi bi-check-circle-fill me-1 text-success"></i>Présent
                                    </span>
                                {% elseif employe.statutAujourdhui == 'absent' %}
                                    <span class="badge badge-light-danger fs-8 fw-bold">
                                        <i class="bi bi-x-circle-fill me-1 text-danger"></i>Absent
                                    </span>
                                {% elseif employe.statutAujourdhui == 'conge' %}
                                    <span class="badge badge-light-warning fs-8 fw-bold">
                                        <i class="bi bi-calendar2-range-fill me-1 text-warning"></i>En congé
                                    </span>
                                {% elseif employe.statutAujourdhui == 'retard' %}
                                    <span class="badge badge-light-info fs-8 fw-bold">
                                        <i class="bi bi-clock-history me-1 text-info"></i>En retard
                                    </span>
                                {% else %}
                                    <span class="badge badge-light-secondary fs-8 fw-bold">
                                        <i class="bi bi-dash-circle me-1 text-muted"></i>Non pointé
                                    </span>
                                {% endif %}
                            </td>
                            <td>
                                {% if employe.dernierePresence %}
                                    <span class="text-gray-800 fs-7 fw-semibold">
                                        <i class="bi bi-calendar-event me-1 text-gray-500"></i>{{ employe.dernierePresence|date('d/m/Y H:i') }}
                                    </span>
                                {% else %}
                                    <span class="text-muted fs-8 fst-italic">
                                        <i class="bi bi-dash text-muted me-1"></i>Aucun historique
                                    </span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-1">
                                    <a href="{{ path('app_employe_show', {'id': employe.id}) }}" 
                                       class="btn btn-icon btn-light-primary btn-sm" 
                                       data-bs-toggle="tooltip" 
                                       title="Dossier Agent 360°">
                                        <i class="bi bi-eye fs-6"></i>
                                    </a>
                                    <a href="{{ path('app_pointage_employe', {'id': employe.id}) }}" 
                                       class="btn btn-icon btn-light-info btn-sm"
                                       data-bs-toggle="tooltip"
                                       title="Historique des Pointages">
                                        <i class="bi bi-clock-history fs-6"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">
                                <i class="bi bi-people fs-2 text-muted mb-2 d-block"></i>
                                Aucun employé trouvé dans cette sélection.
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            {% if stats.pagination.totalPages > 1 %}
            <div class="d-flex flex-stack flex-wrap pt-6">
                <div class="fs-7 fw-bold text-gray-700">
                    Affichage page {{ stats.pagination.currentPage }} sur {{ stats.pagination.totalPages }}
                </div>
                <ul class="pagination">
                    <li class="page-item previous {% if stats.pagination.currentPage == 1 %}disabled{% endif %}">
                        <a class="page-link" href="?page={{ stats.pagination.currentPage - 1 }}" aria-label="Précédent">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    {% for i in 1..stats.pagination.totalPages %}
                        <li class="page-item {% if i == stats.pagination.currentPage %}active{% endif %}">
                            <a class="page-link" href="?page={{ i }}">{{ i }}</a>
                        </li>
                    {% endfor %}
                    <li class="page-item next {% if stats.pagination.currentPage == stats.pagination.totalPages %}disabled{% endif %}">
                        <a class="page-link" href="?page={{ stats.pagination.currentPage + 1 }}" aria-label="Suivant">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialisation des Tooltips Bootstrap
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // 1. Graphique Évolution de la Présence (Ligne - Bleu Institutionnel #002664 & Vert #50CD89)
            const attendanceCanvas = document.getElementById('attendanceChart');
            if (attendanceCanvas) {
                const attendanceCtx = attendanceCanvas.getContext('2d');
                new Chart(attendanceCtx, {
                    type: 'line',
                    data: {
                        labels: {{ stats.chartPresence.labels|default([])|json_encode|raw }},
                        datasets: [{
                            label: 'Taux de présence (%)',
                            data: {{ stats.chartPresence.data|default([])|json_encode|raw }},
                            backgroundColor: 'rgba(0, 38, 100, 0.08)',
                            borderColor: '#002664',
                            borderWidth: 3,
                            tension: 0.35,
                            fill: true,
                            pointRadius: 4,
                            pointHoverRadius: 7,
                            pointBackgroundColor: '#002664',
                            pointBorderColor: '#FFFFFF',
                            pointBorderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                max: 100,
                                ticks: {
                                    callback: function(value) { return value + '%'; }
                                },
                                grid: { color: '#F1F1F4' }
                            },
                            x: {
                                grid: { display: false }
                            }
                        },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return 'Taux : ' + context.parsed.y.toFixed(1) + '%';
                                    }
                                }
                            }
                        }
                    }
                });
            }

            // 2. Graphique Répartition des Congés (Doughnut - Palette Tchad / PRD)
            const leaveCanvas = document.getElementById('leaveTypeChart');
            if (leaveCanvas) {
                const leaveTypeCtx = leaveCanvas.getContext('2d');
                new Chart(leaveTypeCtx, {
                    type: 'doughnut',
                    data: {
                        labels: {{ stats.chartConges.labels|default([])|json_encode|raw }},
                        datasets: [{
                            data: {{ stats.chartConges.data|default([])|json_encode|raw }},
                            backgroundColor: [
                                '#FECB00',  // En attente - Or Chadian
                                '#50CD89',  // Approuvé - Vert succès
                                '#C60C30',  // Refusé - Rouge Tchad
                                '#A1A5B7'   // Annulé - Gris neutre
                            ],
                            borderWidth: 2,
                            borderColor: '#FFFFFF'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    padding: 12,
                                    usePointStyle: true,
                                    font: { size: 11, family: 'Inter, sans-serif' }
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        const label = context.label || '';
                                        const value = context.parsed;
                                        const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                        const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                                        return label + ' : ' + value + ' (' + percentage + '%)';
                                    }
                                }
                            }
                        }
                    }
                });
            }

            // 3. Graphique Top 5 Absences par Service (Bar horizontal - Rouge Chadian #C60C30)
            const absenceCanvas = document.getElementById('absenceByServiceChart');
            if (absenceCanvas) {
                const absenceCtx = absenceCanvas.getContext('2d');
                new Chart(absenceCtx, {
                    type: 'bar',
                    data: {
                        labels: {{ stats.topAbsencesServices.labels|default([])|json_encode|raw }},
                        datasets: [{
                            label: 'Nombre d\'absences',
                            data: {{ stats.topAbsencesServices.data|default([])|json_encode|raw }},
                            backgroundColor: 'rgba(198, 12, 48, 0.75)',
                            borderColor: '#C60C30',
                            borderWidth: 1.5,
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        indexAxis: 'y',
                        scales: {
                            x: {
                                beginAtZero: true,
                                grid: { color: '#F1F1F4' },
                                ticks: { precision: 0 }
                            },
                            y: {
                                grid: { display: false }
                            }
                        },
                        plugins: {
                            legend: { display: false }
                        }
                    }
                });
            }

            // 4. Graphique Statistiques Mensuelles (Barres groupées)
            const monthlyCanvas = document.getElementById('monthlyStatsChart');
            if (monthlyCanvas) {
                const monthlyCtx = monthlyCanvas.getContext('2d');
                new Chart(monthlyCtx, {
                    type: 'bar',
                    data: {
                        labels: ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Juin', 'Juil', 'Août', 'Sep', 'Oct', 'Nov', 'Déc'],
                        datasets: [
                            {
                                label: 'Présents',
                                data: {{ stats.statsMonthly.presents|default([])|json_encode|raw }},
                                backgroundColor: 'rgba(80, 205, 137, 0.85)',
                                borderColor: '#50CD89',
                                borderWidth: 1,
                                borderRadius: 3
                            },
                            {
                                label: 'Absents',
                                data: {{ stats.statsMonthly.absents|default([])|json_encode|raw }},
                                backgroundColor: 'rgba(198, 12, 48, 0.85)',
                                borderColor: '#C60C30',
                                borderWidth: 1,
                                borderRadius: 3
                            },
                            {
                                label: 'En congé',
                                data: {{ stats.statsMonthly.conges|default([])|json_encode|raw }},
                                backgroundColor: 'rgba(254, 203, 0, 0.85)',
                                borderColor: '#FECB00',
                                borderWidth: 1,
                                borderRadius: 3
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            x: { grid: { display: false } },
                            y: {
                                beginAtZero: true,
                                grid: { color: '#F1F1F4' },
                                ticks: { precision: 0 }
                            }
                        },
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: { usePointStyle: true, boxWidth: 8, font: { size: 11 } }
                            }
                        }
                    }
                });
            }

            // Actualisation manuelle
            document.querySelectorAll('.btn-refresh-stats').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const icon = this.querySelector('i');
                    if (icon) icon.classList.add('rotate');
                    setTimeout(() => { window.location.reload(); }, 350);
                });
            });

            // Recherche instantanée d'employés
            const searchInput = document.getElementById('searchEmployee');
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    const searchValue = this.value.toLowerCase();
                    const rows = document.querySelectorAll('tbody tr');
                    rows.forEach(row => {
                        const rowText = row.textContent.toLowerCase();
                        row.style.display = rowText.includes(searchValue) ? '' : 'none';
                    });
                });
            }

            // Filtre par période
            const dateRangeSelect = document.getElementById('dateRange');
            if (dateRangeSelect) {
                dateRangeSelect.addEventListener('change', function() {
                    if (this.value === 'custom') {
                        alert('La sélection par plage de dates personnalisée sera disponible prochainement.');
                    }
                });
            }

            // Rafraîchissement automatique
            setInterval(function() {
                const autoCheckbox = document.getElementById('autoRefresh');
                if (autoCheckbox && autoCheckbox.checked) {
                    window.location.reload();
                }
            }, 300000);
        });
    </script>
{% endblock %}
