{% extends 'base.html.twig' %}

{% block title %}Services — MCI e-Circuit{% endblock %}

{% block page_title %}
    <h1 class="d-flex align-items-center text-dark fw-bolder fs-2 my-1">
        Services
        <span class="h-20px border-gray-300 border-start ms-3 mx-2 d-none d-md-inline"></span>
        <small class="text-muted fs-7 fw-semibold my-1 ms-1">Gestion des services, directions et unités administratives</small>
    </h1>
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-muted">Administration</li>
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-dark fw-bold">Services</li>
{% endblock %}

{% block page_actions %}
    {% if is_granted('SERVICE_CREATE') %}
        <a href="{{ path('app_service_new') }}" class="btn btn-mci-primary">
            <i class="bi bi-plus-lg fs-5"></i>
            <span>Nouveau service</span>
        </a>
    {% endif %}
{% endblock %}

{% block body %}
<div class="row g-6" data-controller="table">
    <div class="col-12">
        <div class="card card-mci">
            <!--begin::Card header-->
            <div class="card-header border-0 pt-6 pb-6 d-flex flex-wrap align-items-center justify-content-between gap-4">
                <!--begin::Search-->
                <div class="d-flex align-items-center position-relative my-1">
                    <i class="bi bi-search fs-4 position-absolute ms-4 text-muted"></i>
                    <input type="text" 
                           data-table-target="input" 
                           data-action="input->table#filter" 
                           class="form-control form-control-mci ps-12 w-250px w-md-350px" 
                           placeholder="Rechercher un service, code..." 
                           aria-label="Rechercher un service" />
                </div>
                <!--end::Search-->

                <!--begin::Card toolbar-->
                <div class="d-flex align-items-center gap-3">
                    <span class="badge badge-mci badge-mci-blue fs-7 fw-bold px-3 py-2">
                        <i class="bi bi-diagram-3-fill me-1"></i>
                        {{ services|length }} service(s) au total
                    </span>
                    {% if is_granted('SERVICE_CREATE') %}
                        <a href="{{ path('app_service_new') }}" class="btn btn-mci-primary d-none d-sm-inline-flex">
                            <i class="bi bi-plus-lg fs-5"></i>
                            <span>Nouveau service</span>
                        </a>
                    {% endif %}
                </div>
                <!--end::Card toolbar-->
            </div>
            <!--end::Card header-->

            <!--begin::Card body-->
            <div class="card-body pt-0">
                <div class="table-responsive">
                    <table class="table table-mci align-middle table-row-dashed fs-6 gy-4">
                        <thead>
                            <tr class="text-start text-muted fw-bolder fs-7 text-uppercase gs-0">
                                <th class="w-80px ps-4">Code</th>
                                <th class="min-w-200px">Service</th>
                                <th class="min-w-180px">Direction / Structure</th>
                                <th class="min-w-180px">Responsable</th>
                                <th class="min-w-110px text-center">Effectif</th>
                                <th class="min-w-110px text-center">Statut</th>
                                <th class="min-w-120px text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="text-gray-700 fw-semibold">
                            {% for service in services %}
                                <tr data-table-target="row">
                                    <td class="ps-4">
                                        {% if service.code %}
                                            <span class="badge badge-mci badge-mci-blue fs-8 fw-bold">{{ service.code }}</span>
                                        {% else %}
                                            <span class="text-muted fs-8">#{{ service.id }}</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="symbol symbol-40px symbol-circle me-3" style="background-color: var(--mci-blue-subtle);">
                                                <span class="symbol-label text-mci-blue fw-bold fs-6">
                                                    <i class="bi bi-diagram-3 text-mci-blue fs-4"></i>
                                                </span>
                                            </div>
                                            <div class="d-flex flex-column">
                                                <a href="{{ path('app_service_show', {'id': service.id}) }}" class="text-dark text-hover-primary fw-bolder fs-6">
                                                    {{ service.nom }}
                                                </a>
                                                {% if service.description %}
                                                    <span class="text-muted fs-8 text-truncate max-w-250px">{{ service.description }}</span>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        {% if service.structure %}
                                            <span class="text-dark fw-semibold fs-7 d-flex align-items-center">
                                                <i class="bi bi-folder2-open text-primary me-2"></i>{{ service.structure.nom }}
                                            </span>
                                        {% else %}
                                            <span class="text-muted fs-8">Non rattaché</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if service.responsable %}
                                            <div class="d-flex align-items-center">
                                                <div class="symbol symbol-25px symbol-circle me-2" style="background-color: var(--mci-blue-subtle);">
                                                    <span class="symbol-label text-mci-blue fs-8 fw-bold">
                                                        {{ service.responsable.nom|first }}{{ service.responsable.prenom|first }}
                                                    </span>
                                                </div>
                                                <span class="text-gray-800 fs-7 fw-semibold">
                                                    {{ service.responsable.nom }} {{ service.responsable.prenom }}
                                                </span>
                                            </div>
                                        {% else %}
                                            <span class="badge badge-mci badge-mci-inactive fs-8">Poste vacant</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-center">
                                        {% set nbAgents = service.employes|length %}
                                        <span class="badge badge-mci {% if nbAgents > 0 %}badge-mci-active{% else %}badge-mci-inactive{% endif %} fs-8">
                                            <i class="bi bi-people-fill me-1"></i>
                                            {{ nbAgents }} agent{{ nbAgents > 1 ? 's' : '' }}
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        {% if service.statut == 'ACTIVE' %}
                                            <span class="badge badge-mci badge-mci-active fs-8">Actif</span>
                                        {% elseif service.statut == 'INACTIVE' %}
                                            <span class="badge badge-mci badge-mci-inactive fs-8">Inactif</span>
                                        {% else %}
                                            <span class="badge badge-mci badge-mci-gold fs-8">Archivé</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end align-items-center gap-2">
                                            <a href="{{ path('app_service_show', {'id': service.id}) }}" 
                                               class="btn btn-sm btn-icon btn-mci-light btn-action-icon" 
                                               data-bs-toggle="tooltip" 
                                               title="Consulter le service">
                                                <i class="bi bi-eye text-primary"></i>
                                            </a>
                                            {% if is_granted('SERVICE_EDIT', service) %}
                                                <a href="{{ path('app_service_edit', {'id': service.id}) }}" 
                                                   class="btn btn-sm btn-icon btn-mci-light btn-action-icon" 
                                                   data-bs-toggle="tooltip" 
                                                   title="Modifier le service">
                                                    <i class="bi bi-pencil-square text-warning"></i>
                                                </a>
                                            {% endif %}
                                            {% if is_granted('SERVICE_DELETE', service) %}
                                                <form method="post" 
                                                      action="{{ path('app_service_delete', {'id': service.id}) }}" 
                                                      class="d-inline-block" 
                                                      onsubmit="return confirm('Êtes-vous certain de vouloir supprimer ce service ?');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ service.id) }}">
                                                    <button type="submit" 
                                                            class="btn btn-sm btn-icon btn-mci-light btn-action-icon" 
                                                            data-bs-toggle="tooltip" 
                                                            title="Supprimer le service">
                                                        <i class="bi bi-trash text-mci-red"></i>
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="7" class="text-center py-12">
                                        <div class="d-flex flex-column align-items-center justify-content-center">
                                            <i class="bi bi-diagram-3 text-muted fs-3x mb-3"></i>
                                            <h4 class="text-dark fw-bold mb-1">Aucun service enregistré</h4>
                                            <p class="text-muted fs-7 mb-4">Créez votre premier service administratif ou direction pour votre institution.</p>
                                            {% if is_granted('SERVICE_CREATE') %}
                                                <a href="{{ path('app_service_new') }}" class="btn btn-mci-primary">
                                                    <i class="bi bi-plus-lg fs-5"></i>
                                                    <span>Ajouter un premier service</span>
                                                </a>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}

                            <!-- Ligne vide affichée par Stimulus en cas de filtre sans résultat -->
                            <tr data-table-target="empty" style="display: none;">
                                <td colspan="7" class="text-center py-10">
                                    <div class="d-flex flex-column align-items-center">
                                        <i class="bi bi-search text-muted fs-2x mb-2"></i>
                                        <span class="text-muted fs-6">Aucun service ne correspond à votre recherche.</span>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <!--end::Card body-->

            <!--begin::Card footer-->
            <div class="card-footer d-flex flex-wrap justify-content-between align-items-center py-4">
                <span class="text-muted fs-7">
                    Affichage de <span class="fw-bold text-dark">{{ services|length }}</span> service(s) • MCI e-Circuit
                </span>
                <span class="text-muted fs-8">
                    Ministère du Commerce et de l'Industrie • République du Tchad
                </span>
            </div>
            <!--end::Card footer-->
        </div>
    </div>
</div>
{% endblock %}
