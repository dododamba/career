{% extends 'base.html.twig' %}

{% block title %}Modifier le service {{ service.nom }}{% endblock %}

{% block page_title %}
    <h1 class="d-flex align-items-center text-dark fw-bolder fs-2 my-1">
        Modifier le service
        <span class="h-20px border-gray-300 border-start ms-3 mx-2 d-none d-md-inline"></span>
        <small class="text-muted fs-7 fw-semibold my-1 ms-1">{{ service.nom }}</small>
    </h1>
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-muted">Administration</li>
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-muted">
        <a href="{{ path('app_service_index') }}" class="text-muted text-hover-primary">Services</a>
    </li>
    <li class="breadcrumb-item">
        <span class="bullet bg-gray-300 w-5px h-2px"></span>
    </li>
    <li class="breadcrumb-item text-dark fw-bold">Modifier</li>
{% endblock %}

{% block page_actions %}
    <a href="{{ path('app_service_show', {'id': service.id}) }}" class="btn btn-mci-light me-2">
        <i class="bi bi-eye me-1"></i>Voir le service
    </a>
    <a href="{{ path('app_service_index') }}" class="btn btn-mci-light">
        <i class="bi bi-arrow-left me-1"></i>Retour à la liste
    </a>
{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
        <div class="card card-mci mb-6">
            <!--begin::Card header-->
            <div class="card-header border-0 pt-6">
                <div class="card-title d-flex align-items-center">
                    <div class="symbol symbol-45px symbol-circle me-3" style="background-color: var(--mci-blue-subtle);">
                        <i class="bi bi-pencil-square text-mci-blue fs-2"></i>
                    </div>
                    <div>
                        <h2 class="fs-3 fw-bolder text-dark mb-0">Modifier les paramètres du service</h2>
                        <span class="text-muted fs-7">Identifiant : #{{ service.id }}{% if service.code %} • Code: {{ service.code }}{% endif %}</span>
                    </div>
                </div>
            </div>
            <!--end::Card header-->

            <!--begin::Card body-->
            <div class="card-body pt-4">
                {{ include('service/_form.html.twig', {'button_label': 'Mettre à jour le service'}) }}
            </div>
            <!--end::Card body-->
        </div>

        {% if is_granted('SERVICE_DELETE', service) %}
            <div class="card card-mci border-danger-subtle">
                <div class="card-body d-flex flex-wrap align-items-center justify-content-between p-6">
                    <div>
                        <h4 class="text-mci-red fw-bolder mb-1">Zone de suppression</h4>
                        <p class="text-muted fs-7 mb-0">La suppression d'un service nécessite qu'aucun agent actif n'y soit actuellement affecté.</p>
                    </div>
                    <form method="post" action="{{ path('app_service_delete', {'id': service.id}) }}" onsubmit="return confirm('Êtes-vous certain de vouloir supprimer ce service ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ service.id) }}">
                        <button type="submit" class="btn btn-mci-danger">
                            <i class="bi bi-trash fs-5 me-1"></i>Supprimer ce service
                        </button>
                    </form>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
